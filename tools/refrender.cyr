# refrender.cyr — the HOST REFERENCE RENDERER. Produces the image the GPU is supposed to draw.
#
# ⛔⛔ WHY THIS DID NOT EXIST BEFORE THE FIRST BURN, AND WHY THAT WAS THE MISTAKE. mine-cart's host
# gate proves every record is ABI-LEGAL and that the frame is not EMPTY. It never once asked what
# the frame LOOKS LIKE. So a picture that is wrong in any way that is still legal and still covers
# the screen passes every gate green — and the only instrument left is a photograph of a glossy
# panel with the room reflected in it, which lies about brightness, hue and fine detail all at once.
#
# The kernel's own rungs never had this problem because every one of them shipped with a CPU
# reference (`perspcore`, `depthcore`, `texcore`) and byte-compared against it. The consumer shipped
# without one. This closes that.
#
# ⭐ The arithmetic here is the KERNEL's, deliberately: the doubled-integer pixel centre 2*p+1, the
# edge functions in that domain, W = 2^16/w, D = sum(e_i * W_i), N = sum(e_i * W_i * attr_i), and
# u = N/D — the same expressions gpo_validate_triperspec bounds and tri_persp.s evaluates. If this
# and the GPU disagree, one of them is wrong and the difference is the evidence.
#
# Usage:  cyrius build tools/refrender.cyr build/refrender && ./build/refrender [frame]
#         writes /tmp/mc_ref.raw (640x400 BGRA) — turn it into a PNG to look at it.

include "lib/io.cyr"
include "src/say.cyr"
include "src/fx.cyr"
include "src/config.cyr"
include "src/track.cyr"
include "src/input.cyr"
include "src/cart.cyr"
include "src/geom.cyr"
include "src/tex.cyr"
include "src/refcore.cyr"

fn main(): i64 {
    args_init();
    var frame = 120;
    if (argc() > 1) {
        var s = argv(1);
        var v = 0;
        var k = 0;
        while (load8(s + k) != 0) { v = v * 10 + (load8(s + k) - 48); k = k + 1; }
        frame = v;
    }

    # optional dx dy — ⭐ THE INVARIANCE TEST. Vertices are framebuffer-absolute and refcore
    # rebases to rect-local, so the rendered IMAGE must be byte-identical for every dstxy. If it is
    # not, the game and the kernel disagree about the coordinate frame — which is exactly the defect
    # that nearly went to iron.
    if (argc() > 3) {
        var sx = argv(2); var sy = argv(3);
        var vx = 0; var kx = 0;
        while (load8(sx + kx) != 0) { vx = vx * 10 + (load8(sx + kx) - 48); kx = kx + 1; }
        var vy = 0; var ky = 0;
        while (load8(sy + ky) != 0) { vy = vy * 10 + (load8(sy + ky) - 48); ky = ky + 1; }
        MC_DX = vx; MC_DY = vy;
    }

    mc_sin_init();
    mc_tex_init();
    rr_clear();

    # drive the SAME cart physics the ride uses — mc_cart_to lives in cart.cyr so there is exactly
    # one definition of "frame N" shared by the reference, the ride and the on-iron verifier.
    mc_cart_to(frame);
    mc_build(cart_cam_x());

    ps("refrender: frame "); pn(frame); ps("  dstxy ("); pn(MC_DX); ps(","); pn(MC_DY);
    ps(")  lean "); pn(cart_cam_x());
    ps(" ru  depth "); pn(trk_depth_m()); ps(" m  "); pn(cart_kmh()); ps(" km/h"); nl();
    ps("  ONE record, "); pn(mc_n_a); ps(" triangles (far cap, floor, walls, chamfers, ceiling)"); nl();

    # RECORD ORDER, exactly as mc_gpu_frame dispatches it: A with the floor texture, then B with rock
    # ⛔ rr_record, NOT rr_list — an op 0x0F record REPLACES its whole rect with bg first.
    # ONE record now: layering two was the 0.1.0 defect.
    rr_record(&mc_vtx_a, mc_n_a, &mc_tex_a);
    var after_a = rr_drawn;
    var tris_a  = rr_tris;

    ps("  the single record wrote "); pn(after_a); ps(" px from "); pn(tris_a);
    ps(" covering triangles"); nl();
    ps("  total "); pn(rr_drawn); ps(" of "); pn(MC_W * MC_H); ps(" pixels touched"); nl();

    file_write_all("/tmp/mc_ref.raw", &rr_fb, MC_W * MC_H * 4);
    ps("  wrote /tmp/mc_ref.raw ("); pn(MC_W); ps("x"); pn(MC_H); ps(" BGRA)"); nl();
    return 0;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
