# say.cyr — the three printing primitives, in their own file so EVERY later file can use them.
#
# ⚠ Cyrius is single-pass and silently shadows a duplicate `fn` (last definition wins, warning
# only), so these must have exactly one home. They lived in main.cyr first, which meant geom.cyr —
# included earlier — could not report anything about a triangle it dropped.

fn mc_slen(s): i64 {
    var n = 0;
    while (load8(s + n) != 0) { n = n + 1; }
    return n;
}

fn ps(s): i64 { print(s, mc_slen(s)); return 0; }
fn nl(): i64 { print("\n", 1); return 0; }

fn pn(v): i64 {
    if (v == 0) { print("0", 1); return 0; }
    var b[24];
    var neg = 0;
    var x = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    var i = 0;
    while (x > 0) { store8(&b + i, 48 + (x % 10)); x = x / 10; i = i + 1; }
    if (neg == 1) { print("-", 1); }
    while (i > 0) { i = i - 1; print(&b + i, 1); }
    return 0;
}
