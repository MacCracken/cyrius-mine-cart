# tex.cyr — the two procedural textures, 128x128 XRGB8888 each.
#
# Power-of-two on both axes is MANDATORY for #92 op 0x0F, unconditionally: tri_persp.s masks the
# interpolated coordinate with w-1 and h-1 on every fetch, so a non-power-of-two texture does not
# wrap — it reads the wrong texel and paints a plausible wrong picture. The kernel rejects it
# (GPO_E_TEXDIM) rather than clamping, so 128 is not a preference, it is the contract.

# ⚠ 8192 u64 slots = 65536 B = 128*128*4. Checked at runtime by mc_tex_ok().
# ⛔⛔ ONE TEXTURE, NOT TWO — AND THIS IS FORCED BY THE OP, NOT A PREFERENCE.
# op 0x0F REPLACES ITS ENTIRE RECT: tri_persp.s selects bg for any lane no triangle covered and
# then stores UNCONDITIONALLY. So two records over the same rect do NOT layer — the second one
# paints opaque black over everything the first drew. mine-cart 0.1.0 shipped as two records
# (floor+ceiling, then walls) and its first iron frame showed exactly that: the walls survived and
# the floor and ceiling were erased.
# ⇒ The whole frame must be ONE record, so it can carry only ONE texture. Two materials still fit,
# banded along u: LEFT half (texels 0-63) is the floor, RIGHT half (64-127) is rock. Geometry keeps
# each surface inside its own band, and v (along the track) wraps normally for both.
var MC_TEX_HALF = 4194304;   # 64 << 16 — the u boundary between the two materials

var mc_tex_a[8192];        # THE texture: left half floor (sleepers + rails), right half rock
var mc_tex_b[8192];        # kept allocated so mc_tex_ok() can still MEASURE the span at runtime

fn mc_tex_ok(): i64 {
    var span = &mc_tex_b - &mc_tex_a;
    if (span < MC_TEX * MC_TEX * 4) { return 0; }
    return 1;
}

# a cheap integer hash, for rock mottle — deterministic, so a frame is reproducible
fn mc_hash(x, y): i64 {
    var h = x * 374761393 + y * 668265263;
    h = (h ^ (h >>> 13)) * 1274126177;
    h = h ^ (h >>> 16);
    if (h < 0) { h = 0 - h; }
    return h;
}

fn mc_rgb(r, g, b): i64 {
    if (r < 0) { r = 0; }
    if (g < 0) { g = 0; }
    if (b < 0) { b = 0; }
    if (r > 255) { r = 255; }
    if (g > 255) { g = 255; }
    if (b > 255) { b = 255; }
    return 0xFF000000 + (r * 65536) + (g * 256) + b;
}

# ---- the floor: dark gravel, wooden sleepers across, two steel rails along --------------------
# ⛔ Texel (0,0) MUST stay dark and solid: geom.cyr's background quad samples it with a CONSTANT
# attribute at all three vertices, which is what paints the tunnel's far darkness and, not
# incidentally, guarantees every pixel of the draw rect is written before anything else lands.
fn mc_tex_floor(): i64 {
    var y = 0;
    while (y < MC_TEX) {
        var x = 0;
        while (x < MC_TEX) {
            var n = mc_hash(x, y) % 24;
            var r = 44 + n; var g = 38 + n; var b = 32 + n;

            # sleepers: a band of timber every 32 texels down the run
            if ((y & 31) < 11) {
                var m = mc_hash(x * 3, y) % 20;
                r = 96 + m; g = 68 + m; b = 40 + m;
            }
            # rails: two bright steel strips running along the track
            # ⚠ both rails inside u 0..63 — the right half is rock now
            if (x > 13) { if (x < 20) { r = 150; g = 152; b = 158; } }
            if (x > 44) { if (x < 51) { r = 150; g = 152; b = 158; } }

            # the far-darkness texel the background quad samples
            if (x == 0) { if (y == 0) { r = 12; g = 10; b = 14; } }

            store32(&mc_tex_a + (y * MC_TEX + x) * 4, mc_rgb(r, g, b));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# ---- the walls: rough hewn rock with a few darker seams --------------------------------------
fn mc_tex_rock(): i64 {
    var y = 0;
    while (y < MC_TEX) {
        var x = 0;
        while (x < MC_TEX) {
            var n = mc_hash(x + 7, y + 11) % 38;
            var r = 72 + n; var g = 66 + n; var b = 60 + n;

            # blocky courses, so the perspective has something rectilinear to shear
            if ((y & 15) == 0) { r = r - 26; g = g - 24; b = b - 22; }
            var off = 0;
            if ((y & 31) < 16) { off = 8; }
            if (((x + off) & 31) == 0) { r = r - 26; g = g - 24; b = b - 22; }

            # a scatter of ore glints, so a still frame is not uniform noise
            if ((mc_hash(x, y * 5) % 211) == 0) { r = 168; g = 148; b = 84; }

            store32(&mc_tex_b + (y * MC_TEX + x) * 4, mc_rgb(r, g, b));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# build the combined texture: floor material in u 0..63, rock in u 64..127
fn mc_tex_init(): i64 {
    mc_tex_floor();                       # fills the whole 128x128 with the floor material
    mc_tex_rock();                        # ... then overwrites the right half with rock
    var y = 0;
    while (y < MC_TEX) {
        var x = 64;
        while (x < MC_TEX) {
            store32(&mc_tex_a + (y * MC_TEX + x) * 4,
                    load32(&mc_tex_b + (y * MC_TEX + x) * 4) & 0xFFFFFFFF);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
