# tex.cyr — the procedural texture, 128x128 XRGB8888. DEEPVEIN palette.
#
# ⛔ POWER-OF-TWO ON BOTH AXES IS MANDATORY AND UNCONDITIONAL. tri_persp.s masks the interpolated
# coordinate with w-1 and h-1 on every fetch, so a non-power-of-two texture does not wrap — it reads
# the wrong texel and paints a plausible WRONG picture. The kernel rejects it (GPO_E_TEXDIM) rather
# than clamping, so 128 is the contract, not a preference.
#
# ⛔⛔ ONE TEXTURE, NOT TWO — AND THE OP FORCES THIS.
# op 0x0F REPLACES ITS ENTIRE RECT: tri_persp.s selects bg for any lane no triangle covered and then
# stores UNCONDITIONALLY. Two records over the same rect do NOT layer — the second paints opaque
# black over everything the first drew. mine-cart 0.1.0 shipped as two records (floor+ceiling, then
# walls) and its first iron frame showed exactly that: the walls survived, the floor and ceiling were
# erased. So the whole frame is ONE record and can carry ONE texture.
# ⇒ Two materials, banded along u: LEFT half (texels 0-63) is the floor, RIGHT half (64-127) is rock.
#   Geometry keeps each surface inside its own band; v (along the track) wraps normally for both.
# ⚠ MC_TEX / MC_TEXFULL / MC_TEX_HALF live in config.cyr — geom.cyr bands its u coordinates against
#   them and is compiled BEFORE this file.
#
# ⛔ THERE IS NO LIGHTING. op 0x0F fetches a texel and stores it; the record carries no vertex colour
# and no modulation field, so distance fog and lamp falloff are not available at all. Depth cueing
# has to be baked into the texture or faked with geometry. What this file does instead is keep the
# whole palette DARK and COLD and let the emissive rails carry the contrast — which is why the rails
# are the brightest thing in the frame by a wide margin.

var mc_tex_a[8192];        # THE texture: left half floor, right half rock
var mc_tex_b[8192];        # scratch for the rock pass; also lets mc_tex_ok() MEASURE the span
var mc_tex_guard = 0;

fn mc_tex_ok(): i64 {
    if ((&mc_tex_b     - &mc_tex_a) < MC_TEX * MC_TEX * 4) { return 0; }
    if ((&mc_tex_guard - &mc_tex_b) < MC_TEX * MC_TEX * 4) { return 0; }
    return 1;
}

# a cheap integer hash, for mottle — deterministic, so a frame is reproducible
fn mc_hash(x, y): i64 {
    var h = x * 374761393 + y * 668265263;
    h = (h ^ (h >>> 13)) * 1274126177;
    h = h ^ (h >>> 16);
    if (h < 0) { h = 0 - h; }
    return h;
}

fn mc_rgb(r, g, b): i64 {
    if (r < 0) { r = 0; }
    if (g < 0) { g = 0; }
    if (b < 0) { b = 0; }
    if (r > 255) { r = 255; }
    if (g > 255) { g = 255; }
    if (b > 255) { b = 255; }
    return 0xFF000000 + (r * 65536) + (g * 256) + b;
}

# ---- the floor: wet ballast, dark sleepers, and two EMISSIVE rails ------------------------------
# ⭐ THE RAILS ARE THE ONLY BRIGHT THING IN THE MINE, AND THAT IS THE WHOLE ART DIRECTION. With no
# lighting available, the frame needs one high-contrast element that tells the player where the
# track goes and how it bends — everything else can be texture. Cyan #4fe3ff against a near-black
# blue ballast does that, and it is what makes a curve legible at 100 km/h.
# ⛔ TEXEL (0,0) MUST STAY NEAR-BLACK AND SOLID: the far cap quad samples it with a CONSTANT
# attribute at all three vertices to paint the darkness the tunnel recedes into. If it ever becomes
# a rail texel, the far end of the shaft turns into a glowing block.
fn mc_tex_floor(): i64 {
    var y = 0;
    while (y < MC_TEX) {
        var x = 0;
        while (x < MC_TEX) {
            # ballast — #0a1720 with grit
            var n = mc_hash(x, y) % 18;
            var r = 10 + n; var g = 23 + n; var b = 32 + n;

            # sleepers: a band of dark timber every 32 texels down the run
            if ((y & 31) < 11) {
                var m = mc_hash(x * 3, y) % 12;
                r = 26 + m; g = 30 + m; b = 34 + m;
            }

            # ⭐⭐ THE FLOOR BAND IS NOW u 0..47, NOT u 0..63, AND THE REST IS RESERVED.
            # The right edge of the old floor band is carved into two fixed-purpose regions, because
            # a quad that samples "the floor" was picking up rail stripes and rendering treasure as
            # fragments of rail — see MC_TEX_FLOOR / MC_TEX_ORE / MC_TEX_RAILPAIR in config.cyr.
            #   u 0..47   the main track floor: ballast, sleepers, ONE pair of rails
            #   u 48..49  solid swatches, sampled with a CONSTANT attribute (ore, cap darkness)
            #   u 50..63  a RAIL-PAIR STRIP for side tracks in multi-rail sections
            # ⛔⛔ NO RAILS IN THE FLOOR BAND ANY MORE, AND THIS IS THE FIX FOR THE WHOLE PROBLEM.
            # The rails used to be painted into the floor texture, which stretches across the ENTIRE
            # bore — so the "track" was as wide as the tunnel (a 4.6 m gauge), and side tracks drawn
            # at +-22 ru landed inside it. On screen that read as a bundle of rails bunched to one
            # side rather than as three tracks.
            # ⇒ The floor is now BALLAST ONLY, and every track — including the main one — is drawn as
            #   its own narrow strip quad from the rail-pair region below. A track becomes an OBJECT
            #   with a position and a width, which is the only way three of them can coexist.

            # ---- u 48..49: SOLID SWATCHES, sampled with a constant attribute -----------------------
            # ⚠ These must be uniform down the whole column: a constant-attribute quad samples ONE
            # texel, and if v ever drifts it must land on the same colour rather than on a sleeper.
            if (x == 48) { r = 214; g = 158; b = 74; }      # ore — treasure, warm against all that cyan
            if (x == 49) { r = 10;  g = 23;  b = 32; }      # the darkness the far cap recedes into
            # ⭐ the cart's own plate. Dark steel, cold, so it sits as a silhouette against the rails
            # rather than competing with them — it is the frame of reference, not the subject.
            # ⛔ IT WAS INVISIBLE AT (26,38,46) — near-identical to the ballast it sits on, so the
            # cart only showed up in frames where it happened to overlap a black gap. With no
            # lighting in op 0x0F, CONTRAST IS THE ONLY WAY ANYTHING READS. Mid steel is bright
            # enough to separate from the floor and cold enough not to compete with the rails, which
            # have to stay the brightest thing in the frame.
            if (x == 47) {
                r = 74; g = 92; b = 104;
                if ((y & 15) < 3) { r = 148; g = 168; b = 180; }   # a lit capping rail along the top
            }

            # ---- u 50..63: THE RAIL-PAIR STRIP for side tracks ------------------------------------
            # ⭐ ONE QUAD PER SIDE TRACK INSTEAD OF TWO. A side track needs two rails, and drawing
            # them as separate quads costs 4 triangles a slab per track — 128 across the frustum,
            # against ~48 spare. A single strip carrying both rails costs 2, which fits.
            if (x >= 50) {
                var sn = mc_hash(x, y) % 14;
                r = 8 + sn; g = 20 + sn; b = 28 + sn;             # darker ballast, so it reads as separate
                if ((y & 31) < 9) { r = 22; g = 26; b = 30; }     # its own sleepers
                if (x >= 53) { if (x <= 54) { r = 79; g = 227; b = 255; } }
                if (x >= 59) { if (x <= 60) { r = 79; g = 227; b = 255; } }
                if (x == 53) { r = 168; g = 236; b = 255; }
                if (x == 59) { r = 168; g = 236; b = 255; }
            }

            store32(&mc_tex_a + (y * MC_TEX + x) * 4, mc_rgb(r, g, b));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# ---- the walls: cold wet rock, blocky courses, a scatter of ore -----------------------------------
fn mc_tex_rock(): i64 {
    var y = 0;
    while (y < MC_TEX) {
        var x = 0;
        while (x < MC_TEX) {
            # #123642 drifting toward #0a1720
            var n = mc_hash(x + 7, y + 11) % 26;
            var r = 14 + n / 2; var g = 40 + n; var b = 50 + n;

            # blocky courses, so the perspective has something rectilinear to shear
            if ((y & 15) == 0) { r = r - 8; g = r - 6; b = b - 18; }
            var off = 0;
            if ((y & 31) < 16) { off = 8; }
            if (((x + off) & 31) == 0) { r = r - 8; g = g - 14; b = b - 18; }

            # ⭐ ore glints in amber — the ONLY warm colour in the mine, and rare enough that a still
            # frame is not uniform noise while a moving one sparkles.
            if ((mc_hash(x, y * 5) % 701) == 0) { r = 176; g = 128; b = 58; }
            # rarer magenta seams: the thing the Trust actually wants
            if ((mc_hash(x * 11, y) % 2237) == 0) { r = 150; g = 52; b = 128; }

            store32(&mc_tex_b + (y * MC_TEX + x) * 4, mc_rgb(r, g, b));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# build the combined texture: floor material in u 0..63, rock in u 64..127
fn mc_tex_init(): i64 {
    mc_tex_floor();                       # fills the whole 128x128 with the floor material
    mc_tex_rock();                        # ... then the right half is overwritten with rock
    var y = 0;
    while (y < MC_TEX) {
        var x = 64;
        while (x < MC_TEX) {
            store32(&mc_tex_a + (y * MC_TEX + x) * 4,
                    load32(&mc_tex_b + (y * MC_TEX + x) * 4) & 0xFFFFFFFF);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
