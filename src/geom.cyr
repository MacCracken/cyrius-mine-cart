# geom.cyr — the segment-ring walk, the projection, and the #92 op 0x0F record emitter.
#
# ⭐ THIS FILE IS THE GAME'S HALF OF THE op 0x0F ABI. Everything the kernel's gpo_validate_triperspec
# refuses is refused HERE first, because a single bad record does not draw a bad triangle — it makes
# `syscall(92, ...)` reject THE WHOLE BATCH, and the frame comes back as whatever was in the slot
# before. On iron that is a black screen, and a black screen is indistinguishable from "no GPU",
# "shader wrote nothing" and "readback failed".
#
# The rules, all of them (agnos kernel/core/syscall.cyr):
#   · coordinates are 16.16 with the fraction EXACTLY zero        GPO_E_SUBPIXEL
#   · |coordinate| <= 2^28 (i.e. +-4096 px)                       GPO_E_COORD
#   · per-vertex w in [256, 4096]                                 GPO_E_WRANGE
#   · frame area in [2^16, 2^42] — no degenerate triangles        GPO_E_AREA
#   · texture dims are POWERS OF TWO, unconditionally             GPO_E_TEXDIM
#   · <= 256 triangles per record                                 GPO_E_TRILIST
#   · the per-triangle reserved dword is zero                     GPO_E_TRILIST
#   · |D| <= 2^31-1 at the four DRAW RECT corners                 GPO_E_DRANGE
#
# ⛔⛔ WHAT CHANGED, AND WHY THE OLD MODEL COULD NOT BE KEPT. This file used to project a fixed
# 8-segment grid against a global sine wave — the track was a closed-form function of z, so there was
# nothing to stream and nothing to author. The world is now a ring of 256 cm segments each carrying
# its own curvature, and the centre line is the RUNNING INTEGRAL of that curvature along the ring.
# The old MC_SEG of 60 render units could not survive the change for an arithmetic reason: 60 ru is
# 480 cm, 480 mod 256 = 224, so a slab boundary could never land on a segment boundary and every
# slab would straddle two segments' curvature by a different fraction. MC_SEG is 32 now (256 cm
# exactly) and slabs land cleanly.

# ---- the two vertex lists ---------------------------------------------------------------------
# 64 B per triangle, exactly GPU_TPER_VTX_BYTES.
# ⛔ SIZED IN 8-BYTE SLOTS, AND VERIFIED AT RUNTIME. A global `var X[N]` is N*8 bytes while a LOCAL
# `var X[N]` is N bytes — an 8x asymmetry with no diagnostic either way. An under-sized vertex buffer
# is exactly the overflow that cost the kernel's own instrument a burn: it corrupted the triangle
# COUNT, and the symptom read as "the GPU did nothing".
# ⚠ [2048] = 16384 B = 256 triangles, and MC_TRI_MAX is 256. THESE TWO MUST MOVE TOGETHER — raising
# the cap without growing the array writes past the end of mc_vtx_a and into mc_vtx_b.
var mc_vtx_a[2048];
var mc_vtx_b[2048];        # kept so mc_bufs_ok() can still MEASURE the span at runtime
var mc_vtx_guard = 0;
var mc_n_a = 0;
var mc_n_b = 0;            # ⛔ ALWAYS 0 — the frame is ONE record. See mc_build.

# ---- rejection counters -------------------------------------------------------------------------
var mc_drop_flat  = 0;     # exactly-degenerate: cross == 0, so it covers no pixel at all
var mc_drop_huge  = 0;     # past the area ceiling — a REAL hole
var mc_drop_coord = 0;
var mc_drop_band  = 0;
var mc_drop_full  = 0;     # ⭐ NEW: over the per-record triangle budget. See mc_emit.
var mc_peak_d     = 0;
var mc_peak_n     = 0;
var mc_trace      = 0;     # 1 = report every dropped triangle, for diagnosis

# ---- the slab endpoints, filled by mc_walk() ------------------------------------------------------
# Struct-of-arrays again: rz (render units of depth), and the centre line's x/y offset there.
var mc_s_rz[24];
var mc_s_cx[24];
var mc_s_cy[24];
var mc_s_v[24];            # texture v at this endpoint, 16.16 texels
var mc_s_seg[24];          # the ring segment this endpoint sits on — what is ON the track there
var mc_s_guard = 0;
var mc_nslab = 0;          # number of ENDPOINTS written (slabs = mc_nslab - 1)

fn mc_bufs_ok(): i64 {
    # ⚠ Compared as a >= BYTE assertion and never divided to derive a capacity: a global with N >= 2
    # can carry up to 8 bytes of alignment padding BEFORE it, so a span overstates and never
    # understates.
    if ((&mc_vtx_b     - &mc_vtx_a) < MC_TRI_MAX * 64) { return 0; }
    if ((&mc_vtx_guard - &mc_vtx_b) < MC_TRI_MAX * 64) { return 0; }
    if ((&mc_s_guard   - &mc_s_rz)  < 24 * 8 * 5)      { return 0; }
    return 1;
}

# ⭐ Kept as a name because main.cyr and tools/refrender.cyr call it, and because "initialise the
# trig tables" is a real step that now lives in fx.cyr. One definition, one home.
fn mc_sin_init(): i64 { return fx_sin_init(); }

# ---- projection -----------------------------------------------------------------------------------
# rz is ALWAYS >= MC_ZN: the slab ladder is anchored to the near plane so nothing is ever behind the
# camera and no near-plane clipping is needed. That is a geometry choice made specifically to avoid a
# clipper, because a clipper is where sub-pixel coordinates and degenerate triangles come from, and
# both of those are whole-batch rejections.
#
# ⛔⛔ VERTICES ARE FRAMEBUFFER-ABSOLUTE, NOT RECT-LOCAL. gpu_tper_prep_build folds dstxy into every
# plane CONSTANT, so the shader evaluates each edge at the SCREEN sample point 2*(dx+lx)+1. Emitting
# rect-local coordinates with a non-zero dstxy renders the window [dx,dx+w) x [dy,dy+h) OF THE SCENE
# into the rect, panning the picture up-left by (dx,dy).
# ⚠ #92 carries TWO conventions and that is why this is easy to get wrong: op 0x0A is rect-LOCAL,
# while 0x0E and 0x0F are ABSOLUTE. main.cyr's gate asserts it rather than trusting it.
fn mc_px(rx, rz): i64 { return MC_DX + MC_CX + (rx * MC_FOCAL) / rz; }
fn mc_py(ry, rz): i64 { return MC_DY + MC_CY + (ry * MC_FOCAL) / rz; }
fn mc_wof(rz): i64    { return MC_WSC * rz; }

# ---- the band check: the kernel's own D and N arithmetic, reproduced exactly ------------------------
# ⭐ Not a paraphrase of the rule — the same expression, on the same doubled-integer domain, at the
# same four draw-rect corners, so "the game accepts it" and "the kernel accepts it" cannot drift.
fn mc_band_check(x0, y0, w0, u0, v0, x1, y1, w1, u1, v1, x2, y2, w2, u2, v2): i64 {
    var qx0 = 2 * MC_DX + 1;
    var qx1 = 2 * (MC_DX + MC_W - 1) + 1;
    var qy0 = 2 * MC_DY + 1;
    var qy1 = 2 * (MC_DY + MC_H - 1) + 1;

    var dax = 2 * x0; var day = 2 * y0;
    var dbx = 2 * x1; var dby = 2 * y1;
    var dcx = 2 * x2; var dcy = 2 * y2;

    var W0 = 65536 / w0;
    var W1 = 65536 / w1;
    var W2 = 65536 / w2;

    var k = 0;
    while (k < 4) {
        var qx = qx0; var qy = qy0;
        if (k == 1) { qx = qx1; qy = qy0; }
        if (k == 2) { qx = qx0; qy = qy1; }
        if (k == 3) { qx = qx1; qy = qy1; }
        var e0 = (dcx - dbx) * (qy - dby) - (dcy - dby) * (qx - dbx);
        var e1 = (dax - dcx) * (qy - dcy) - (day - dcy) * (qx - dcx);
        var e2 = (dbx - dax) * (qy - day) - (dby - day) * (qx - dax);

        var D = e0 * W0 + e1 * W1 + e2 * W2;
        if (D < 0) { D = 0 - D; }
        if (D > mc_peak_d) { mc_peak_d = D; }
        if (D > MC_D_MAX) { return 0; }

        var Nu = e0 * (W0 * u0) + e1 * (W1 * u1) + e2 * (W2 * u2);
        var Nv = e0 * (W0 * v0) + e1 * (W1 * v1) + e2 * (W2 * v2);
        if (Nu < 0) { Nu = 0 - Nu; }
        if (Nv < 0) { Nv = 0 - Nv; }
        if (Nu > mc_peak_n) { mc_peak_n = Nu; }
        if (Nv > mc_peak_n) { mc_peak_n = Nv; }
        k = k + 1;
    }
    return 1;
}

# ---- emit one triangle ------------------------------------------------------------------------------
# Returns 1 when written, 0 when DROPPED. A drop is a visible hole, so every drop is counted.
fn mc_emit(list, np, x0, y0, w0, u0, v0, x1, y1, w1, u1, v1, x2, y2, w2, u2, v2): i64 {
    var n = load64(np);
    # ⭐ THIS DROP USED TO BE SILENT AND UNCOUNTED, AND THAT WAS THE ONE REJECTION PATH THE GATE
    # COULD NOT SEE. A frame that quietly lost its last N triangles reported a perfectly clean drop
    # tally — "0 dropped" over a tunnel with the far end missing. Budget the geometry analytically;
    # never discover the cap at runtime.
    if (n >= MC_TRI_MAX) { mc_drop_full = mc_drop_full + 1; return 0; }

    # coordinate window, +-4096 px
    if (x0 > 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (x1 > 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (x2 > 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (y0 > 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (y1 > 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (y2 > 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (x0 < 0 - 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (x1 < 0 - 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (x2 < 0 - 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (y0 < 0 - 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (y1 < 0 - 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }
    if (y2 < 0 - 4096) { mc_drop_coord = mc_drop_coord + 1; return 0; }

    # w band — the kernel refuses, never rescales
    if (w0 < MC_W_MIN) { mc_drop_band = mc_drop_band + 1; return 0; }
    if (w1 < MC_W_MIN) { mc_drop_band = mc_drop_band + 1; return 0; }
    if (w2 < MC_W_MIN) { mc_drop_band = mc_drop_band + 1; return 0; }
    if (w0 > MC_W_MAX) { mc_drop_band = mc_drop_band + 1; return 0; }
    if (w1 > MC_W_MAX) { mc_drop_band = mc_drop_band + 1; return 0; }
    if (w2 > MC_W_MAX) { mc_drop_band = mc_drop_band + 1; return 0; }

    # frame area, in the kernel's doubled-integer domain
    var dax = 2 * x0; var day = 2 * y0;
    var dbx = 2 * x1; var dby = 2 * y1;
    var dcx = 2 * x2; var dcy = 2 * y2;
    var cross = ((dbx - dax) * (dcy - day) - (dby - day) * (dcx - dax)) / 4;
    if (cross < 0) { cross = 0 - cross; }
    # ⭐ THE AREA-MIN RULE CAN ONLY FIRE AT cross == 0, and that decides whether a drop is a hole.
    # a2 is |cross| << 16 and MC_AREA_MIN is 1 << 16, so a2 < MC_AREA_MIN requires |cross| == 0 — the
    # triangle is EXACTLY collinear and covers no pixel in any rasteriser. Far slabs produce these
    # routinely once the track curves: two edges a fraction of a pixel apart round to the same
    # integer column, and the ABI forbids sub-pixel coordinates.
    # ⚠ SO THE GATE MUST NOT ASSERT "all drops are zero" — it must hold coord/band/huge/full at zero
    # and report flat separately. A curving track legitimately produces ~1 flat drop per frame.
    var a2 = cross << 16;
    if (a2 < MC_AREA_MIN) {
        mc_drop_flat = mc_drop_flat + 1;
        if (mc_trace == 1) {
            ps("    degenerate: ("); pn(x0); ps(","); pn(y0); ps(") (");
            pn(x1); ps(","); pn(y1); ps(") ("); pn(x2); ps(","); pn(y2);
            ps(")  w "); pn(w0); ps("/"); pn(w1); ps("/"); pn(w2); nl();
        }
        return 0;
    }
    if (a2 > MC_AREA_MAX) { mc_drop_huge = mc_drop_huge + 1; return 0; }

    if (mc_band_check(x0, y0, w0, u0, v0, x1, y1, w1, u1, v1, x2, y2, w2, u2, v2) == 0) {
        mc_drop_band = mc_drop_band + 1;
        return 0;
    }

    var b = list + n * 64;
    store32(b +  0, x0 << 16); store32(b +  4, y0 << 16); store32(b +  8, w0);
    store32(b + 12, u0);       store32(b + 16, v0);
    store32(b + 20, x1 << 16); store32(b + 24, y1 << 16); store32(b + 28, w1);
    store32(b + 32, u1);       store32(b + 36, v1);
    store32(b + 40, x2 << 16); store32(b + 44, y2 << 16); store32(b + 48, w2);
    store32(b + 52, u2);       store32(b + 56, v2);
    store32(b + 60, 0);                       # the reserved dword — non-zero is GPO_E_TRILIST
    store64(np, n + 1);
    return 1;
}

# emit a quad as two triangles, corners in order a-b-c-d
fn mc_quad(list, np, xa, ya, wa, ua, va, xb, yb, wb, ub, vb, xc, yc, wc, uc, vc, xd, yd, wd, ud, vd): i64 {
    var got = 0;
    got = got + mc_emit(list, np, xa, ya, wa, ua, va, xb, yb, wb, ub, vb, xc, yc, wc, uc, vc);
    got = got + mc_emit(list, np, xa, ya, wa, ua, va, xc, yc, wc, uc, vc, xd, yd, wd, ud, vd);
    return got;
}

# ---- the budget reserve --------------------------------------------------------------------------
# ⛔ OPTIONAL DETAIL ASKS PERMISSION. The per-record cap is 256 and mc_emit's over-budget path drops
# silently — so whatever is emitted LAST is whatever gets lost, and the cart is drawn last because
# painter's order demands it. Gating optional geometry on remaining room inverts that: the things
# that can be spared are the things that go.
fn mc_room(n): i64 {
    if (mc_n_a + n <= MC_TRI_MAX - CFG_TRI_RESERVE) { return 1; }
    return 0;
}

# ---- the slab ladder ---------------------------------------------------------------------------------
# ⚠ Near slabs are SHORT and far slabs are LONG. A uniform walk makes the nearest slab 280 px tall on
# a 400 px screen while the farthest is 2 px — the near geometry is then so coarse that a curve reads
# as a polygon rather than a bend. This ladder costs the same triangles and drops the worst slab to
# 112 px.
fn mc_step_at(rz): i64 {
    if (rz < 64)  { return MC_LOD0; }
    if (rz < 128) { return MC_LOD1; }
    if (rz < 256) { return MC_LOD2; }
    return MC_LOD3;
}

# ---- the curve integral --------------------------------------------------------------------------------
# Integrate a per-segment field over the render-unit interval [ru_a, ru_b), measured from the START of
# the segment the camera is standing in. Returns BRADS.
#
# ⭐ AN EXACT INTEGRAL, NOT A POINT SAMPLE, AND THE DIFFERENCE IS VISIBLE. The far slabs are 64 ru
# long and a segment is 32 ru, so each far slab spans TWO segments. Sampling the ring once per slab
# reads only one of them and silently discards the other's curvature — a measured 4 of 15 segments'
# curve values never read at all, which makes a bend appear and vanish as the cart advances. Walking
# the fragments costs ~62 ring reads a frame and loses nothing.
#
# ⚠ `>>> 5` rather than `/ 32`: the field can be NEGATIVE, and those are different operations for
# negative values (one floors, the other truncates toward zero). The engine uses the flooring
# convention everywhere so that no call site has to know the sign of its input.
fn mc_integ(ru_a, ru_b, want_grade): i64 {
    var acc = 0;
    var p = ru_a;
    while (p < ru_b) {
        var seg_i   = p >>> 5;                  # 32 render units per segment
        var seg_end = (seg_i + 1) << 5;
        var e = ru_b;
        if (seg_end < e) { e = seg_end; }
        var abs = trk_abs_seg + seg_i;
        var c = 0;
        # ⛔ A read outside the live window does not fail — it returns a RECYCLED slot, i.e. a
        # different part of the track. Treat it as straight rather than as whatever is in the slot.
        if (trk_live(abs) == 1) {
            if (want_grade == 0) { c = trk_curve_at(abs); }
            if (want_grade != 0) { c = trk_grade_at(abs); }
        }
        acc = acc + ((c * (e - p)) >>> 5);
        p = e;
    }
    return acc;
}

# ---- the walk: turn per-segment curvature into a centre line ----------------------------------------------
# ⭐ THE ACCUMULATOR IS ANCHORED AT ZERO AT THE NEAR PLANE, NOT AT THE CAMERA, and that is a
# correctness choice rather than a convenience. The near slab carries the largest W (w = 256 is the
# ABI floor) and is therefore where |D| is most sensitive; integrating from the camera and
# subtracting would land rounding noise exactly there. Anchored at the near plane, the near slab's
# coordinates and |D| are FIXED no matter how hard the track bends further out.
#
# psi/phi accumulate in BRADS; xq/yq accumulate in 16.16 RENDER UNITS.
# `* MC_TAU_Q16 >>> 17` folds three things at once: brads -> radians (2*pi/65536), the 16.16 scale,
# and the /2 of the midpoint rule. The midpoint rule is EXACT for a constant curve, so the choice of
# ladder never changes WHERE the track goes — only how finely it is drawn.
fn mc_walk(): i64 {
    var cam_ru = trk_pos_sub >>> 11;            # 0..31 render units into the current segment
    var psi = 0; var xq = 0;
    var phi = 0; var yq = 0;

    # texture v advances with depth so the tunnel scrolls past continuously. Anchored modulo one
    # segment at the near plane so v never grows without bound (|N| is a shader register pair and
    # the ABI bounds it at 2^62).
    var v = ((cam_ru + MC_ZN) & 31) * (MC_TEXFULL / 32);

    var rz = MC_ZN;
    var n = 0;
    store64(&mc_s_rz + 0, rz);
    store64(&mc_s_cx + 0, 0);
    store64(&mc_s_cy + 0, 0);
    store64(&mc_s_v  + 0, v);
    store64(&mc_s_seg + 0, trk_abs_seg + ((cam_ru + MC_ZN) >>> 5));
    n = 1;

    while (rz < MC_ZF) {
        var step = mc_step_at(rz);
        var dpsi = mc_integ(cam_ru + rz, cam_ru + rz + step, 0);
        var dphi = mc_integ(cam_ru + rz, cam_ru + rz + step, 1);
        xq = xq + ((step * (2 * psi + dpsi) * MC_TAU_Q16) >>> 17);
        yq = yq + ((step * (2 * phi + dphi) * MC_TAU_Q16) >>> 17);
        psi = psi + dpsi;
        phi = phi + dphi;
        rz = rz + step;
        v  = v + step * (MC_TEXFULL / 32);
        if (n < MC_SLAB_MAX) {
            store64(&mc_s_rz + n * 8, rz);
            store64(&mc_s_cx + n * 8, xq >>> 16);
            store64(&mc_s_cy + n * 8, yq >>> 16);
            store64(&mc_s_v  + n * 8, v);
            # ⭐ WRITTEN WITH THE OTHER ENDPOINT FIELDS, AFTER rz ADVANCED. Slabs are camera-relative
            # and segments are world-relative, so the mapping changes every tick and a far slab spans
            # two segments — the lookup cannot be assumed, it has to be recorded. Writing it BEFORE
            # the advance put mc_s_seg one slab out of step with mc_s_rz, so every hazard and every
            # side track was attributed to the slab in front of the one it belonged to.
            store64(&mc_s_seg + n * 8, trk_abs_seg + ((cam_ru + rz) >>> 5));
            n = n + 1;
        }
    }
    mc_nslab = n;
    return n;
}

# ---- build one frame -------------------------------------------------------------------------------------
# ⛔⛔ ONE RECORD, ONE LIST. The frame used to be two op 0x0F records (floor+ceiling, then walls) and
# that is UNSOUND for this op: it replaces its ENTIRE rect, writing bg wherever no triangle covered
# the lane, so the second record painted opaque black over everything the first had drawn. The first
# iron frame showed the walls and nothing else. RECORDS DO NOT LAYER, and nothing in the ABI says so.
#
# Slabs are walked FAR TO NEAR: op 0x0F REPLACES the destination pixel rather than compositing, so
# painter's order IS the depth test. A tunnel is convex from the inside and nothing interpenetrates,
# which is what makes that sound without op 0x0E's z buffer.
#
# cam_x is the cart's lateral offset from the centre line, in RENDER UNITS.
fn mc_build(cam_x): i64 {
    mc_n_a = 0;
    mc_n_b = 0;
    mc_drop_flat = 0;
    mc_drop_huge = 0;
    mc_drop_coord = 0;
    mc_drop_band = 0;
    mc_drop_full = 0;

    mc_walk();

    # ⚠ THE FLOOR BAND ENDS AT MC_TEX_FLOOR (u 48), not at MC_TEX_HALF (u 64). Texels 48..63 are
    # reserved swatches and the side-track rail strip; a floor quad spanning to 64 would drag them
    # into the main track, which is precisely how treasure came to be drawn as bits of rail.
    var F = MC_TEX_FLOOR;     # floor material:  u in [0, F)
    var H = MC_TEX_HALF;      # rock starts here
    var T = MC_TEXFULL;       # rock material:   u in [H, T)

    # ---- ⭐ THE FAR CAP, AND WHY THE FRAME IS WRONG WITHOUT IT ---------------------------------
    # ⛔ op 0x0F writes GPU_TRID_BG — opaque BLACK — into every lane no triangle covered, and the
    # game cannot change that: the record has no background-colour field. So the mouth of the tunnel
    # beyond the far plane came out as a hard-edged black octagon sitting in the middle of the
    # screen. It does not read as "the shaft continues into the dark"; it reads as a HOLE IN THE
    # WORLD, which is worse than a visual flaw because the player's eye goes straight to it.
    # ⇒ One quad at the far plane, sampling the near-black texel (0,0) with a CONSTANT attribute at
    #   every corner. Drawn FIRST so every slab overwrites it — painter's order does the rest.
    # ⚠ It spans the full bore rather than the arch, so no sliver of bg survives at the corners.
    var capz = load64(&mc_s_rz + (mc_nslab - 1) * 8);
    var capx = load64(&mc_s_cx + (mc_nslab - 1) * 8) - cam_x;
    var capy = load64(&mc_s_cy + (mc_nslab - 1) * 8);
    var capw = mc_wof(capz);
    var cl = mc_px(capx - MC_TW, capz);
    var cr = mc_px(capx + MC_TW, capz);
    var ct = mc_py(capy - MC_CEIL_Y, capz);
    var cb = mc_py(capy + MC_FLOOR_Y, capz);
    mc_quad(&mc_vtx_a, &mc_n_a,
      cl, ct, capw, MC_TEX_CAPDARK, 0,   cr, ct, capw, MC_TEX_CAPDARK, 0,
      cr, cb, capw, MC_TEX_CAPDARK, 0,   cl, cb, capw, MC_TEX_CAPDARK, 0);

    var k = mc_nslab - 2;
    while (k >= 0) {
        var rzn = load64(&mc_s_rz + k * 8);
        var rzf = load64(&mc_s_rz + (k + 1) * 8);
        var cn  = load64(&mc_s_cx + k * 8) - cam_x;
        var cf  = load64(&mc_s_cx + (k + 1) * 8) - cam_x;
        var gn  = load64(&mc_s_cy + k * 8);
        var gf  = load64(&mc_s_cy + (k + 1) * 8);
        var vn  = load64(&mc_s_v + k * 8);
        var vf  = load64(&mc_s_v + (k + 1) * 8);

        var wn = mc_wof(rzn);
        var wf = mc_wof(rzf);

        # the bore's six horizontal stations, near and far
        var ln  = mc_px(cn - MC_TW,      rzn);  var lf  = mc_px(cf - MC_TW,      rzf);
        var rn  = mc_px(cn + MC_TW,      rzn);  var rf  = mc_px(cf + MC_TW,      rzf);
        var cln = mc_px(cn - MC_CEIL_HW, rzn);  var clf = mc_px(cf - MC_CEIL_HW, rzf);
        var crn = mc_px(cn + MC_CEIL_HW, rzn);  var crf = mc_px(cf + MC_CEIL_HW, rzf);

        # ...and its four vertical ones. Grade shifts the whole section up or down.
        var fln = mc_py(gn + MC_FLOOR_Y,      rzn); var flf = mc_py(gf + MC_FLOOR_Y,      rzf);
        var arn = mc_py(gn - MC_ARCH_Y,       rzn); var arf = mc_py(gf - MC_ARCH_Y,       rzf);
        var cen = mc_py(gn - MC_CEIL_Y,       rzn); var cef = mc_py(gf - MC_CEIL_Y,       rzf);

        # ---- ⭐ WHAT IS ON THE TRACK -------------------------------------------------------------
        # ⛔ A HAZARD YOU CANNOT SEE IS NOT A HAZARD, IT IS A COIN FLIP. The simulation had gaps and
        # beams working — and tested — for a while before any of this existed, which made the game
        # unplayable by a person while passing every assertion. Drawing them is not polish.
        var kseg = load64(&mc_s_seg + k * 8);
        var kind = KIND_PLAIN;
        if (trk_live(kseg) == 1) { kind = trk_kind_at(kseg); }

        # ⭐ A GAP IS DRAWN BY NOT DRAWING. Omitting the floor quad leaves op 0x0F's background
        # showing through — an actual hole in the world, at zero triangle cost, and unmistakable.
        if (kind != KIND_GAP) {
            # floor — far-left, far-right, near-right, near-left. u spans the floor band.
            mc_quad(&mc_vtx_a, &mc_n_a,
              lf, flf, wf, 0, vf,   rf, flf, wf, F, vf,
              rn, fln, wn, F, vn,   ln, fln, wn, 0, vn);

            # ---- ⭐⭐ EVERY TRACK IS A STRIP, INCLUDING THE MAIN ONE ----------------------------
            # ⛔ The rails used to be painted into the floor texture, which spans the whole bore — so
            # the track was as wide as the tunnel and nothing could sit beside it. Drawing each track
            # as its own quad makes a track an OBJECT with a position and a gauge, which is what lets
            # three of them exist at once and what makes a hop between them meaningful.
            var GW = CFG_TRACK_HW;
            var m0lf = mc_px(cf - GW, rzf);  var m0rf = mc_px(cf + GW, rzf);
            var m0ln = mc_px(cn - GW, rzn);  var m0rn = mc_px(cn + GW, rzn);
            mc_quad(&mc_vtx_a, &mc_n_a,
              m0lf, flf, wf, MC_TEX_RAILPAIR, vf,   m0rf, flf, wf, H, vf,
              m0rn, fln, wn, H, vn,                 m0ln, fln, wn, MC_TEX_RAILPAIR, vn);

            # ---- ⭐⭐ SIDE TRACKS: what makes a multi-rail section READ as one -------------------
            # ⛔ WIDENING THE BORE FOR THREE RAILS AND DRAWING ONE TRACK LOOKS EXACTLY LIKE THE OLD
            # GAME. Everything scales together — walls, floor, and the texture's rails all move
            # outward in proportion — so a wider tunnel with nothing new in it is visually identical.
            # The widening only becomes visible when something FILLS it.
            # ⚠ ONE QUAD PER SIDE TRACK, carrying BOTH its rails from the strip at u 50..63. Two
            # quads per track would cost 4 triangles a slab (128 across the frustum) against ~48
            # spare; this costs 2, and only on the near half where a rail is more than a pixel.
            if (trk_multi_at(kseg) == 1) {
                if (rzn < CFG_SIDE_RZ) { if (mc_room(4) == 1) {
                        var R = CFG_RAIL_SEP;
                        var sw = CFG_TRACK_HW;
                        # left side track
                        var slf = mc_px(cf - R - sw, rzf);  var srf = mc_px(cf - R + sw, rzf);
                        var sln = mc_px(cn - R - sw, rzn);  var srn = mc_px(cn - R + sw, rzn);
                        mc_quad(&mc_vtx_a, &mc_n_a,
                          slf, flf, wf, MC_TEX_RAILPAIR, vf,   srf, flf, wf, H, vf,
                          srn, fln, wn, H, vn,                 sln, fln, wn, MC_TEX_RAILPAIR, vn);
                        # right side track
                        var tlf = mc_px(cf + R - sw, rzf);  var trf = mc_px(cf + R + sw, rzf);
                        var tln = mc_px(cn + R - sw, rzn);  var trn = mc_px(cn + R + sw, rzn);
                        mc_quad(&mc_vtx_a, &mc_n_a,
                          tlf, flf, wf, MC_TEX_RAILPAIR, vf,   trf, flf, wf, H, vf,
                          trn, fln, wn, H, vn,                 tln, fln, wn, MC_TEX_RAILPAIR, vn);
                    } }
            }
        }

        # ⚠ A BEAM hangs across the bore at head height. Drawn from the ROCK band so it reads as
        # structure rather than as a floor decal, and only on the near half of the frustum — a beam
        # 40 m away is two pixels and just adds noise to the horizon.
        if (kind == KIND_BEAM) {
            if (rzn < CFG_BEAM_RZ) { if (mc_room(2) == 1) {
                    var bt_n = mc_py(gn - MC_ARCH_Y, rzn);
                    var bb_n = mc_py(gn - MC_ARCH_Y + 14, rzn);
                    var bt_f = mc_py(gf - MC_ARCH_Y, rzf);
                    var bb_f = mc_py(gf - MC_ARCH_Y + 14, rzf);
                    mc_quad(&mc_vtx_a, &mc_n_a,
                      lf, bt_f, wf, H, vf,   rf, bt_f, wf, T, vf,
                      rn, bb_n, wn, T, vn,   ln, bb_n, wn, H, vn);
                } }
        }

        # ⚠ TREASURE sits in its lane, just above the sleepers. Small, bright, and only drawn near —
        # the lateral test that collects it does not care whether it was drawn, so a distant one
        # costing triangles buys nothing.
        if (kind == KIND_PICKUP) {
            if (rzn < CFG_PICKUP_RZ) { if (mc_room(2) == 1) {
                    var px = trk_lane_x(trk_lane_at(kseg)) - cam_x + cn;
                    var p_l = mc_px(px - 5, rzn);
                    var p_r = mc_px(px + 5, rzn);
                    var p_b = mc_py(gn + MC_FLOOR_Y - 2, rzn);
                    var p_t = mc_py(gn + MC_FLOOR_Y - 16, rzn);
                    # ⛔ A CONSTANT ATTRIBUTE AT ALL FOUR CORNERS. Spanning the floor band made every
                    # treasure a fragment of whatever floor texels it happened to cross — on screen they
                    # read as random slivers of rail. One texel, one solid colour, one readable object.
                    mc_quad(&mc_vtx_a, &mc_n_a,
                      p_l, p_t, wn, MC_TEX_ORE, 0,   p_r, p_t, wn, MC_TEX_ORE, 0,
                      p_r, p_b, wn, MC_TEX_ORE, 0,   p_l, p_b, wn, MC_TEX_ORE, 0);
                } }
        }

        # left wall — u runs floor-to-springing so the rock does not smear
        mc_quad(&mc_vtx_a, &mc_n_a,
          lf, arf, wf, H, vf,   lf, flf, wf, T, vf,
          ln, fln, wn, T, vn,   ln, arn, wn, H, vn);

        # right wall
        mc_quad(&mc_vtx_a, &mc_n_a,
          rf, flf, wf, H, vf,   rf, arf, wf, T, vf,
          rn, arn, wn, T, vn,   rn, fln, wn, H, vn);

        # ⭐ THE CHAMFERS ARE WHAT MAKE IT AN ARCH. Without them this is a rectangular box, which
        # reads as a corridor rather than a bored shaft. Two quads a slab is the cheapest section
        # that still has a shoulder.
        # left chamfer — springing line up to the ceiling edge
        mc_quad(&mc_vtx_a, &mc_n_a,
          clf, cef, wf, H, vf,   lf,  arf, wf, T, vf,
          ln,  arn, wn, T, vn,   cln, cen, wn, H, vn);

        # right chamfer
        mc_quad(&mc_vtx_a, &mc_n_a,
          rf,  arf, wf, H, vf,   crf, cef, wf, T, vf,
          crn, cen, wn, T, vn,   rn,  arn, wn, H, vn);

        # ceiling — only where the chamfers drew a separate shoulder for it to sit between
        if (rzn < CFG_CHAMFER_RZ) {
            mc_quad(&mc_vtx_a, &mc_n_a,
              clf, cef, wf, H, vf,   crf, cef, wf, T, vf,
              crn, cen, wn, T, vn,   cln, cen, wn, H, vn);
        }

        k = k - 1;
    }

    # ---- ⭐⭐ THE CART, DRAWN LAST AND NEAREST ---------------------------------------------------
    # ⛔ THE CART IS WHY THE SCALE WAS UNREADABLE. Every dimension in this game — gauge, track
    # separation, bore, lean threshold — is measured in render units against nothing the player can
    # see, so "wider" and "narrower" were judgements with no reference. Drawing the vehicle gives the
    # eye the one measuring stick it needs, and it is the thing all those numbers are now derived
    # FROM (CFG_CART_HW in config.cyr).
    # ⚠ The camera IS the cart, so it sits at screen centre regardless of lean — the world moves past
    # it. ⛔ DRAWN AFTER THE SLAB WALK, NOT BEFORE. op 0x0F REPLACES rather than composites and the
    # walk runs FAR TO NEAR, so the last thing written wins. Drawing the cart first — which is what
    # "it is nearest" wrongly suggests — means every slab paints over it and it never appears at all.
    var cz  = CFG_CART_RZ;
    var cw  = mc_wof(cz);
    # ⚠ the centre line at the cart's depth, not at the near plane — on a bend the cart sits where
    # the TRACK is, and reading endpoint 0 would leave it hanging off the rail through every curve.
    # ⚠ Written as a bounded scan with an explicit found-flag. The first attempt used a sentinel
    # (`ci = mc_nslab` to break, then subtract it back) which always resolved to endpoint 0 — the
    # cart then sat on the near-plane centre line and slid off the rail through every bend.
    var ci = 0;
    var cfound = 0;
    var cj = 0;
    while (cj < mc_nslab) {
        if (cfound == 0) {
            if (load64(&mc_s_rz + cj * 8) >= cz) { ci = cj; cfound = 1; }
        }
        cj = cj + 1;
    }
    if (cfound == 0) { ci = mc_nslab - 1; }
    var ccy = load64(&mc_s_cy + ci * 8);
    var ccx = load64(&mc_s_cx + ci * 8) - cam_x;
    var kl  = mc_px(ccx - CFG_CART_HW, cz);
    var kr  = mc_px(ccx + CFG_CART_HW, cz);
    var kb  = mc_py(ccy + MC_FLOOR_Y, cz);
    var kt  = mc_py(ccy + MC_FLOOR_Y - CFG_CART_H, cz);
    mc_quad(&mc_vtx_a, &mc_n_a,
      kl, kt, cw, MC_TEX_CART, 0,   kr, kt, cw, MC_TEX_CART, 0,
      kr, kb, cw, MC_TEX_CART, 0,   kl, kb, cw, MC_TEX_CART, 0);

    return mc_n_a;
}

# ⭐ THE CART LIVES IN cart.cyr AND IS INCLUDED BEFORE THIS FILE. It is not in main.cyr because the
# host reference renderer must drive the SAME physics to reproduce the frame the GPU was asked to
# draw — two copies of the stepping logic is two things to keep in sync, and a reference that has
# silently drifted is worse than no reference at all.
