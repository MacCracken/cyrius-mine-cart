# geom.cyr — the world: the segment-ring walk, the camera, and one frame's worth of geometry.
#
# ⭐ WHAT IS HERE AND WHAT IS NOT. emit.cyr owns the op 0x0F ABI — the vertex lists, the projection and
# every rule the kernel would refuse a batch for. This file decides WHAT is drawn: it walks the track
# ring into slabs, places the camera behind the cart, and emits the bore, the floor, the tracks, the
# things standing on them, the cart and the HUD, far to near, into ONE record.
#
# ⛔⛔ WHAT CHANGED, AND WHY THE OLD MODEL COULD NOT BE KEPT. This file used to project a fixed
# 8-segment grid against a global sine wave — the track was a closed-form function of z, so there was
# nothing to stream and nothing to author. The world is now a ring of 256 cm segments each carrying
# its own curvature, and the centre line is the RUNNING INTEGRAL of that curvature along the ring.
# The old MC_SEG of 60 render units could not survive the change for an arithmetic reason: 60 ru is
# 480 cm, 480 mod 256 = 224, so a slab boundary could never land on a segment boundary and every
# slab would straddle two segments' curvature by a different fraction. MC_SEG is 32 now (256 cm
# exactly) and slabs land cleanly.

# ---- the slab endpoints, filled by mc_walk() ------------------------------------------------------
# Struct-of-arrays again: rz (render units of depth), and the centre line's x/y offset there.
var mc_s_rz[24];
var mc_s_cx[24];
var mc_s_cy[24];
var mc_s_v[24];            # texture v at this endpoint, 16.16 texels
var mc_s_guard = 0;
var mc_nslab = 0;          # number of ENDPOINTS written (slabs = mc_nslab - 1)

# the vertex lists and slab arrays measured: 1 if every span is at least its declared size
fn mc_bufs_ok(): i64 {
    # ⚠ Compared as a >= BYTE assertion and never divided to derive a capacity: a global with N >= 2
    # can carry up to 8 bytes of alignment padding BEFORE it, so a span overstates and never
    # understates.
    if ((&mc_vtx_b     - &mc_vtx_a) < MC_TRI_MAX * 64) { return 0; }
    if ((&mc_vtx_guard - &mc_vtx_b) < MC_TRI_MAX * 64) { return 0; }
    if ((&mc_s_guard   - &mc_s_rz)  < 24 * 8 * 4)      { return 0; }
    return 1;
}

# ⭐ Kept as a name because main.cyr and tools/refrender.cyr call it, and because "initialise the
# trig tables" is a real step that now lives in fx.cyr. One definition, one home.
fn mc_sin_init(): i64 { return fx_sin_init(); }

# ---- the slab ladder ---------------------------------------------------------------------------------
# ⚠ Near slabs are SHORT and far slabs are LONG. A uniform walk makes the nearest slab 280 px tall on
# a 400 px screen while the farthest is 2 px — the near geometry is then so coarse that a curve reads
# as a polygon rather than a bend. This ladder costs the same triangles and drops the worst slab to
# 112 px.
fn mc_step_at(rz): i64 {
    if (rz < 64)  { return MC_LOD0; }
    if (rz < 128) { return MC_LOD1; }
    if (rz < 256) { return MC_LOD2; }
    return MC_LOD3;
}

# ---- ⭐⭐ WHERE THE CAMERA IS: CFG_CART_RZ BEHIND THE CART, NOT AT IT ------------------------------
# ⛔⛔ THE SIMULATION'S POSITION IS THE CART'S, AND THE CAMERA USED TO SIT ON IT. The cart is drawn
# CFG_CART_RZ (124 ru, 9.9 m) in front of the camera — the chase-drone view — but the camera was
# placed AT (trk_abs_seg, trk_pos_sub), which is where cart_tick resolves every beam, gap and
# treasure. So the cart on screen ran 9.9 m AHEAD of the cart the rules were applied to: it reached a
# beam 0.37 s before the hit landed, and it had cleared the whole far lip of a 3-segment gap (96 ru)
# before the simulation decided it was falling in. A player who jumped when the cart they could see
# reached the edge came down inside the gap. Every assertion passed; the screenshot caption for frame
# 200 ("beam@1", with the beam drawn BEHIND the cart) is what showed it.
# ⇒ The camera now trails the simulation position by exactly CFG_CART_RZ, so the drawn cart IS the
#   simulated cart: it meets every hazard on the frame the rules meet it. Nothing in the simulation
#   moved — this is a renderer fix, and --sim, the replay and the audio are bit-identical across it.
# ⚠ 124 ru is 3.9 segments, and the ring keeps ~47 live segments behind the cart, so the camera's
#   own segment is always live after the first four; before that (the chapter gate) it reads as
#   straight, plain track — which is what the gate's forced-straight opening segments are anyway.
var mc_cam_seg = 0;        # absolute segment the CAMERA is in
var mc_cam_ru  = 0;        # render units into that segment, 0..31

# put the camera CFG_CART_RZ behind the cart: sets mc_cam_seg and mc_cam_ru
fn mc_cam_place(): i64 {
    var p = trk_pos_sub - CFG_CART_RZ * MC_SUB_PER_RU;
    var s = trk_abs_seg;
    while (p < 0) { p = p + CFG_SUB_PER_SEG; s = s - 1; }
    mc_cam_seg = s;
    mc_cam_ru  = p >>> 11;                      # 0..31 — the same quantisation the cart position has
    return 0;
}

# ---- the curve integral --------------------------------------------------------------------------------
# Integrate a per-segment field over the render-unit interval [ru_a, ru_b), measured from the START of
# the segment the camera is standing in. Returns BRADS.
#
# ⭐ AN EXACT INTEGRAL, NOT A POINT SAMPLE, AND THE DIFFERENCE IS VISIBLE. The far slabs are 64 ru
# long and a segment is 32 ru, so each far slab spans TWO segments. Sampling the ring once per slab
# reads only one of them and silently discards the other's curvature — a measured 4 of 15 segments'
# curve values never read at all, which makes a bend appear and vanish as the cart advances. Walking
# the fragments costs ~62 ring reads a frame and loses nothing.
#
# ⚠ `>>> 5` rather than `/ 32`: the field can be NEGATIVE, and those are different operations for
# negative values (one floors, the other truncates toward zero). The engine uses the flooring
# convention everywhere so that no call site has to know the sign of its input.
fn mc_integ(ru_a, ru_b, want_grade): i64 {
    var acc = 0;
    var p = ru_a;
    while (p < ru_b) {
        var seg_i   = p >>> 5;                  # 32 render units per segment
        var seg_end = (seg_i + 1) << 5;
        var e = ru_b;
        if (seg_end < e) { e = seg_end; }
        var abs = mc_cam_seg + seg_i;
        var c = 0;
        # ⛔ A read outside the live window does not fail — it returns a RECYCLED slot, i.e. a
        # different part of the track. Treat it as straight rather than as whatever is in the slot.
        if (trk_live(abs) == 1) {
            if (want_grade == 0) { c = trk_curve_at(abs); }
            if (want_grade != 0) { c = trk_grade_at(abs); }
        }
        acc = acc + ((c * (e - p)) >>> 5);
        p = e;
    }
    return acc;
}

# ---- the walk: turn per-segment curvature into a centre line ----------------------------------------------
# ⭐ THE ACCUMULATOR IS ANCHORED AT ZERO AT THE NEAR PLANE, NOT AT THE CAMERA, and that is a
# correctness choice rather than a convenience. The near slab carries the largest W (w = 256 is the
# ABI floor) and is therefore where |D| is most sensitive; integrating from the camera and
# subtracting would land rounding noise exactly there. Anchored at the near plane, the near slab's
# coordinates and |D| are FIXED no matter how hard the track bends further out.
#
# psi/phi accumulate in BRADS; xq/yq accumulate in 16.16 RENDER UNITS.
# `* MC_TAU_Q16 >>> 17` folds three things at once: brads -> radians (2*pi/65536), the 16.16 scale,
# and the /2 of the midpoint rule. The midpoint rule is EXACT for a constant curve, so the choice of
# ladder never changes WHERE the track goes — only how finely it is drawn.
fn mc_walk(): i64 {
    mc_cam_place();
    var cam_ru = mc_cam_ru;                     # 0..31 render units into the camera's segment
    var psi = 0; var xq = 0;
    var phi = 0; var yq = 0;

    # texture v advances with depth so the tunnel scrolls past continuously. Anchored modulo one
    # segment at the near plane so v never grows without bound (|N| is a shader register pair and
    # the ABI bounds it at 2^62).
    var v = ((cam_ru + MC_ZN) & 31) * (MC_TEXFULL / 32);

    var rz = MC_ZN;
    var n = 0;
    store64(&mc_s_rz + 0, rz);
    store64(&mc_s_cx + 0, 0);
    store64(&mc_s_cy + 0, 0);
    store64(&mc_s_v  + 0, v);
    n = 1;

    while (rz < MC_ZF) {
        var step = mc_step_at(rz);
        var dpsi = mc_integ(cam_ru + rz, cam_ru + rz + step, 0);
        var dphi = mc_integ(cam_ru + rz, cam_ru + rz + step, 1);
        xq = xq + ((step * (2 * psi + dpsi) * MC_TAU_Q16) >>> 17);
        yq = yq + ((step * (2 * phi + dphi) * MC_TAU_Q16) >>> 17);
        psi = psi + dpsi;
        phi = phi + dphi;
        rz = rz + step;
        v  = v + step * (MC_TEXFULL / 32);
        if (n < MC_SLAB_MAX) {
            store64(&mc_s_rz + n * 8, rz);
            store64(&mc_s_cx + n * 8, xq >>> 16);
            store64(&mc_s_cy + n * 8, yq >>> 16);
            store64(&mc_s_v  + n * 8, v);
            n = n + 1;
        }
    }
    mc_nslab = n;
    return n;
}

# ---- the centre line at an arbitrary depth ----------------------------------------------------------------
# ⭐ LINEAR BETWEEN THE SLAB'S ENDPOINTS, ON PURPOSE. A slab is drawn as flat quads between its two
# endpoints, so the floor the player SEES is exactly this interpolation — an object placed by the true
# curve integral instead would float a pixel off the rail it is sitting on. Consistent beats exact.
var mc_clx = 0;
var mc_cly = 0;

# the centre line at depth rz inside slab k, interpolated: sets mc_clx and mc_cly
fn mc_cl_at(k, rz): i64 {
    var rzn = load64(&mc_s_rz + k * 8);
    var rzf = load64(&mc_s_rz + (k + 1) * 8);
    var xn  = load64(&mc_s_cx + k * 8);
    var xf  = load64(&mc_s_cx + (k + 1) * 8);
    var yn  = load64(&mc_s_cy + k * 8);
    var yf  = load64(&mc_s_cy + (k + 1) * 8);
    var den = rzf - rzn;
    mc_clx = xn + ((xf - xn) * (rz - rzn)) / den;
    mc_cly = yn + ((yf - yn) * (rz - rzn)) / den;
    return 0;
}

# ---- ⭐ A BEAM: a low bar across the bore, at the exact depth the simulation resolves it -----------------
# ⛔⛔ IT USED TO HANG AT THE SPRINGING LINE — 36 ru ABOVE THE EYE, 86 ru (6.9 m) above the top of the
# cart it was supposed to take the rider's head off — and it was cut from the same rock texture as the
# walls it spanned, and it was only drawn within 128 ru (0.37 s at speed). Camouflaged, out of reach,
# and too late: the one hazard the brief's DUCK verb exists for could not be seen doing anything.
# ⇒ It hangs at rider height now (CFG_BEAM_TOP..CFG_BEAM_BOT, just above the cart's rim, so a crouch
#   clears it and a standing rider does not), it is hazard-striped from the atlas, and it is drawn
#   at every depth the frustum reaches — 1.5 s of warning at the redline.
# ⚠ Front face plus top face: the camera rides above the beam, so the top is what gives it depth.
fn mc_beam(k, rz, cam_x): i64 {
    if (mc_room(4) == 0) { return 0; }
    mc_cl_at(k, rz);
    var cx = mc_clx - cam_x;
    var cy = mc_cly;
    var w  = mc_wof(rz);
    var l  = mc_px(cx - MC_TW, rz);
    var r  = mc_px(cx + MC_TW, rz);
    var t  = mc_py(cy + CFG_BEAM_TOP, rz);
    var b  = mc_py(cy + CFG_BEAM_BOT, rz);
    # the top face runs back from the front edge; drawn first, it is the farther surface
    # ⛔ CLAMPED TO THE FAR PLANE. A beam within CFG_BEAM_DEPTH of it would put the top face's back
    #   edge at w > 4096 — GPO_E_WRANGE, which on iron refuses the WHOLE BATCH. The gate caught this
    #   the first time it ran: four w-band drops, each one a frame that would have gone black.
    var rzb = rz + CFG_BEAM_DEPTH;
    if (rzb > MC_ZF) { rzb = MC_ZF; }
    var wb  = mc_wof(rzb);
    var lb  = mc_px(cx - MC_TW, rzb);
    var rb  = mc_px(cx + MC_TW, rzb);
    var tb  = mc_py(cy + CFG_BEAM_TOP, rzb);
    mc_quad(&mc_vtx_a, &mc_n_a,
      lb, tb, wb, ATL_BEAMTOP_U, ATL_BEAMTOP_V,   rb, tb, wb, ATL_BEAMTOP_U, ATL_BEAMTOP_V,
      r,  t,  w,  ATL_BEAMTOP_U, ATL_BEAMTOP_V,   l,  t,  w,  ATL_BEAMTOP_U, ATL_BEAMTOP_V);
    mc_quad(&mc_vtx_a, &mc_n_a,
      l, t, w, ATL_BEAM_U0, ATL_BEAM_V0,   r, t, w, ATL_BEAM_U1, ATL_BEAM_V0,
      r, b, w, ATL_BEAM_U1, ATL_BEAM_V1,   l, b, w, ATL_BEAM_U0, ATL_BEAM_V1);
    return 0;
}

# ---- ⭐ TREASURE: a faceted gem standing in its lane, at the depth it is collected ----------------------
# ⛔ IT USED TO BE DRAWN ONLY NEARER THAN 112 ru — where the floor it stands on is still BELOW THE
# BOTTOM EDGE OF THE SCREEN (the floor does not enter the frame until ~115). Measured over a 30 s ride:
# treasure reached the picture in 15% of frames and never rose above row 383 of 400. The lateral test
# that collects it ran fine; the player simply could not see what they were steering for.
# ⇒ Drawn at every depth, as a diamond (two triangles) sampled from the atlas's facet tile, and NOT
#   drawn once taken — the simulation marks the segment FLAG_TAKEN on collection.
fn mc_gem(k, rz, a, cam_x): i64 {
    if (mc_room(2) == 0) { return 0; }
    mc_cl_at(k, rz);
    var gx = mc_clx - cam_x + trk_lane_x(trk_lane_at(a));
    var gy = mc_cly + MC_FLOOR_Y - CFG_GEM_LIFT;       # the gem's lowest point
    var w  = mc_wof(rz);
    var xl = mc_px(gx - CFG_GEM_HW, rz);
    var xc = mc_px(gx, rz);
    var xr = mc_px(gx + CFG_GEM_HW, rz);
    var yb = mc_py(gy, rz);
    var ym = mc_py(gy - CFG_GEM_HH, rz);
    var yt = mc_py(gy - 2 * CFG_GEM_HH, rz);
    # ⚠ the tile is mapped ROTATED 45 degrees onto the diamond — its four corners land on the four
    # points — so the tile's quadrants become the diamond's four facets.
    mc_emit(&mc_vtx_a, &mc_n_a,
      xc, yt, w, ATL_GEM_U0, ATL_GEM_V0,   xr, ym, w, ATL_GEM_U1, ATL_GEM_V0,
      xc, yb, w, ATL_GEM_U1, ATL_GEM_V1);
    mc_emit(&mc_vtx_a, &mc_n_a,
      xc, yt, w, ATL_GEM_U0, ATL_GEM_V0,   xc, yb, w, ATL_GEM_U1, ATL_GEM_V1,
      xl, ym, w, ATL_GEM_U0, ATL_GEM_V1);
    return 0;
}

# ---- what stands on the track inside slab k, drawn FAR TO NEAR ------------------------------------------
# ⭐ OBJECTS ARE PLACED BY SEGMENT, NOT BY SLAB. A far slab spans two segments, and the old code read
# only the segment at a slab's NEAR endpoint — so an object on the far half of a 64 ru slab was never
# drawn at all, and a near one snapped to the slab boundary instead of standing where it is. Each
# segment's START is the exact point cart_tick resolves it (the crossing), so that is where it stands.
# ⚠ After the slab's own surfaces, never before: the bore is convex from the inside, so a surface of
#   the same slab is always BEHIND an object in it, and drawing it second would paint over the object.
# ⚠ Takes a depth range [lo, hi) inside the slab, not just the slab: drawing the cart's own slab in
#   two halves around the cart was tried (see mc_build's note on why the cart is drawn last instead).
fn mc_objects(k, lo, hi, cam_x): i64 {
    var rzn = load64(&mc_s_rz + k * 8);
    var rzf = load64(&mc_s_rz + (k + 1) * 8);
    if (lo < rzn) { lo = rzn; }
    if (hi > rzf) { hi = rzf; }
    if (hi <= lo) { return 0; }
    # the last segment that STARTS inside [lo, hi), then walk toward the camera
    var last = (mc_cam_ru + hi - 1) >>> 5;
    var rza  = last * 32 - mc_cam_ru;
    var a    = mc_cam_seg + last;
    while (rza >= lo) {
        if (trk_live(a) == 1) {
            var kind = trk_kind_at(a);
            if (kind == KIND_BEAM) { mc_beam(k, rza, cam_x); }
            if (kind == KIND_PICKUP) {
                if ((trk_flags_at(a) & FLAG_TAKEN) == 0) { mc_gem(k, rza, a, cam_x); }
            }
        }
        rza = rza - 32;
        a = a - 1;
    }
    return 0;
}

# ---- one run of floor, [a, b) inside slab k, and the tracks on it ------------------------------------
# ⭐ Interpolated from the slab's own endpoints (mc_cl_at), so a run that covers the whole slab is the
# old quad to the pixel, and a cut lands exactly on the plane the uncut quad would have drawn.
# v is linear in depth by construction (4 texels per ru), so it is interpolated exactly too.
fn mc_floor_run(k, a, b, multi, cam_x): i64 {
    var rzs = load64(&mc_s_rz + k * 8);
    var vs  = load64(&mc_s_v + k * 8);
    var vn  = vs + (a - rzs) * (MC_TEXFULL / 32);
    var vf  = vs + (b - rzs) * (MC_TEXFULL / 32);
    mc_cl_at(k, a);
    var cn = mc_clx - cam_x;
    var gn = mc_cly;
    mc_cl_at(k, b);
    var cf = mc_clx - cam_x;
    var gf = mc_cly;
    var wn = mc_wof(a);
    var wf = mc_wof(b);
    var fln = mc_py(gn + MC_FLOOR_Y, a);
    var flf = mc_py(gf + MC_FLOOR_Y, b);

    # floor — far-left, far-right, near-right, near-left. u spans the floor band.
    var ln = mc_px(cn - MC_TW, a);  var lf = mc_px(cf - MC_TW, b);
    var rn = mc_px(cn + MC_TW, a);  var rf = mc_px(cf + MC_TW, b);
    mc_quad(&mc_vtx_a, &mc_n_a,
      lf, flf, wf, 0, vf,              rf, flf, wf, MC_TEX_FLOOR, vf,
      rn, fln, wn, MC_TEX_FLOOR, vn,   ln, fln, wn, 0, vn);

    # ---- ⭐⭐ EVERY TRACK IS A STRIP, INCLUDING THE MAIN ONE ---------------------------------------
    # ⛔ The rails used to be painted into the floor texture, which spans the whole bore — so the track
    # was as wide as the tunnel and nothing could sit beside it. Drawing each track as its own quad
    # makes a track an OBJECT with a position and a gauge, which is what lets three of them exist at
    # once and what makes a hop between them meaningful.
    var GW = CFG_TRACK_HW;
    var m0lf = mc_px(cf - GW, b);  var m0rf = mc_px(cf + GW, b);
    var m0ln = mc_px(cn - GW, a);  var m0rn = mc_px(cn + GW, a);
    mc_quad(&mc_vtx_a, &mc_n_a,
      m0lf, flf, wf, MC_TEX_RAILPAIR, vf,   m0rf, flf, wf, MC_TEX_RAILEND, vf,
      m0rn, fln, wn, MC_TEX_RAILEND, vn,    m0ln, fln, wn, MC_TEX_RAILPAIR, vn);

    # ---- ⭐⭐ SIDE TRACKS: what makes a multi-rail section READ as one ------------------------------
    # ⛔ THEY WERE ONLY EVER DRAWN WHERE THE FLOOR IS BELOW THE SCREEN. The gate was rzn < 112 and the
    # floor does not enter the frame until ~115, so a 3-track section — 10% of every run — was never
    # once visible. Every quad it emitted was legal, counted, and off-screen.
    # ⇒ Drawn at every depth now, room permitting; culling pays for it by no longer spending the
    #   budget on the off-screen slabs that were crowding it out.
    # ⚠ ONE QUAD PER SIDE TRACK, carrying BOTH its rails from the strip at u 50..62.
    if (multi == 1) {
        if (mc_room(4) == 1) {
            var R = CFG_RAIL_SEP;
            var slf = mc_px(cf - R - GW, b);  var srf = mc_px(cf - R + GW, b);
            var sln = mc_px(cn - R - GW, a);  var srn = mc_px(cn - R + GW, a);
            mc_quad(&mc_vtx_a, &mc_n_a,
              slf, flf, wf, MC_TEX_RAILPAIR, vf,   srf, flf, wf, MC_TEX_RAILEND, vf,
              srn, fln, wn, MC_TEX_RAILEND, vn,    sln, fln, wn, MC_TEX_RAILPAIR, vn);
            var tlf = mc_px(cf + R - GW, b);  var trf = mc_px(cf + R + GW, b);
            var tln = mc_px(cn + R - GW, a);  var trn = mc_px(cn + R + GW, a);
            mc_quad(&mc_vtx_a, &mc_n_a,
              tlf, flf, wf, MC_TEX_RAILPAIR, vf,   trf, flf, wf, MC_TEX_RAILEND, vf,
              trn, fln, wn, MC_TEX_RAILEND, vn,    tln, fln, wn, MC_TEX_RAILPAIR, vn);
        }
    }
    return 0;
}

# ---- ⭐⭐ THE CART, DRAWN LAST AND NEAREST -----------------------------------------------------------
# ⛔ THE CART IS WHY THE SCALE WAS UNREADABLE. Every dimension in this game — gauge, track separation,
# bore, lean threshold — is measured in render units against nothing the player can see, so "wider"
# and "narrower" were judgements with no reference. Drawing the vehicle gives the eye the one
# measuring stick it needs, and it is the thing all those numbers are derived FROM (CFG_CART_HW).
# ⚠ The camera trails the cart and shares its lateral offset, so the cart sits at screen centre
# regardless of lean — the world moves past it. ⛔ DRAWN AFTER THE SLAB WALK, NOT BEFORE: op 0x0F
# REPLACES rather than composites and the walk runs FAR TO NEAR, so the last thing written wins.
#
# ⭐⭐ AND IT SHOWS WHAT THE SIMULATION IS DOING, because nothing else on screen can. It used to be one
# flat grey plate — the same plate crouched, airborne, gripping or losing the rail. Now:
#     airborne   the whole cart rises through the jump's arc (CFG_JUMP_LIFT at the top)
#     crouched   the rider drops below the rim, which is what clears a beam
#     warn >= 2  the inside wheel lifts and sparks spray off the outside one — the brief's "wheel
#                lifting, sparks", hung off cart_warn() exactly where config.cyr said it would be
# ⚠ Every one of these reads sim state and none of them writes it. The picture can lag or skip a
#   frame; the simulation cannot tell.
# the slab whose [rzn, rzf) holds the cart's depth — the last endpoint at or before CFG_CART_RZ
fn mc_cart_slab(): i64 {
    var ci = 0;
    var cj = 0;
    while (cj < mc_nslab - 1) {
        if (load64(&mc_s_rz + cj * 8) <= CFG_CART_RZ) { ci = cj; }
        cj = cj + 1;
    }
    return ci;
}

# the cart: rear plate, crate, rider, jump lift, wheel tip and sparks
fn mc_cart_draw(cam_x): i64 {
    var cz = CFG_CART_RZ;
    var cw = mc_wof(cz);
    # ⚠ the centre line at the cart's depth, not at the near plane — on a bend the cart sits where the
    # TRACK is, and reading endpoint 0 would leave it hanging off the rail through every curve.
    mc_cl_at(mc_cart_slab(), cz);
    var ccx = mc_clx - cam_x;
    var base = mc_cly + MC_FLOOR_Y;                    # the rail head under the wheels

    # -- the jump: a parabola over the fixed hang time, peaking at CFG_JUMP_LIFT --------------------
    if (cart_air > 0) {
        var e = CFG_JUMP_TICKS - cart_air;
        base = base - (4 * CFG_JUMP_LIFT * e * (CFG_JUMP_TICKS - e)) / (CFG_JUMP_TICKS * CFG_JUMP_TICKS);
    }

    # -- which way the rail is throwing it: outward is AGAINST the bend -----------------------------
    var outward = 0;
    if (trk_live(trk_abs_seg) == 1) {
        var cv = trk_curve_at(trk_abs_seg);
        if (cv > 0) { outward = 0 - 1; }
        if (cv < 0) { outward = 1; }
    }
    var warn = cart_warn();
    var tip = 0;
    if (warn >= 2) { tip = CFG_TIP_RU; }
    if (warn >= 3) { tip = 2 * CFG_TIP_RU; }
    if (outward == 0) { tip = 0; }
    # the INSIDE wheel is the one that lifts
    var lift_l = 0;
    var lift_r = 0;
    if (outward > 0) { lift_l = tip; }
    if (outward < 0) { lift_r = tip; }

    var kl  = mc_px(ccx - CFG_CART_HW, cz);
    var kr  = mc_px(ccx + CFG_CART_HW, cz);
    var kbl = mc_py(base - lift_l, cz);
    var kbr = mc_py(base - lift_r, cz);
    var ktl = mc_py(base - lift_l - CFG_CART_H, cz);
    var ktr = mc_py(base - lift_r - CFG_CART_H, cz);
    var rim = base - CFG_CART_H - (lift_l + lift_r) / 2;

    # -- sparks off the OUTSIDE wheel, behind the body so the cart stays in front of them ----------
    # ⚠ The flicker is a hash of the tick, never fx_rand: the simulation's generator advances with
    #   the simulation ONLY, or a dropped frame would desynchronise the replay.
    if (tip > 0) {
        if (mc_room(4) == 1) {
            var sx = ccx + outward * CFG_CART_HW;
            var fl = (cart_ticks * 2654435761) >>> 7;
            var reach = 8 + (fl & 7);
            var rise  = 4 + ((fl >>> 3) & 3);
            var sp0x = mc_px(sx, cz);
            var sp0y = mc_py(base, cz);
            var sp1x = mc_px(sx + outward * reach, cz);
            var sp1y = mc_py(base - rise, cz);
            var sp2x = mc_px(sx + outward * (reach - 3), cz);
            var sp2y = mc_py(base - 1, cz);
            var sp3x = mc_px(sx + outward * (reach + 2), cz);
            var sp3y = mc_py(base - rise - 3, cz);
            mc_emit(&mc_vtx_a, &mc_n_a,
              sp0x, sp0y, cw, ATL_SPARK_U, ATL_SPARK_V,   sp1x, sp1y, cw, ATL_SPARK_U, ATL_SPARK_V,
              sp2x, sp2y, cw, ATL_SPARK_U, ATL_SPARK_V);
            mc_emit(&mc_vtx_a, &mc_n_a,
              sp0x, sp0y - 1, cw, ATL_SPARK_U, ATL_SPARK_V,   sp3x, sp3y, cw, ATL_SPARK_U, ATL_SPARK_V,
              sp1x, sp1y, cw, ATL_SPARK_U, ATL_SPARK_V);
        }
    }

    # -- the body: the rear plate from the atlas ----------------------------------------------------
    mc_quad(&mc_vtx_a, &mc_n_a,
      kl, ktl, cw, ATL_CART_U0, ATL_CART_V0,   kr, ktr, cw, ATL_CART_U1, ATL_CART_V0,
      kr, kbr, cw, ATL_CART_U1, ATL_CART_V1,   kl, kbl, cw, ATL_CART_U0, ATL_CART_V1);

    # -- the core crate, strapped on the right of the load bed ---------------------------------------
    var xl = mc_px(ccx + CFG_CRATE_X0, cz);
    var xr = mc_px(ccx + CFG_CRATE_X1, cz);
    var yb = mc_py(rim, cz);
    var yt = mc_py(rim - CFG_CRATE_H, cz);
    mc_quad(&mc_vtx_a, &mc_n_a,
      xl, yt, cw, ATL_CRATE_U0, ATL_CRATE_V0,   xr, yt, cw, ATL_CRATE_U1, ATL_CRATE_V0,
      xr, yb, cw, ATL_CRATE_U1, ATL_CRATE_V1,   xl, yb, cw, ATL_CRATE_U0, ATL_CRATE_V1);

    # -- the rider, braced on the left: a trapezoid silhouette with a helmet lamp -------------------
    # ⭐ DUCKING IS VISIBLE: crouched, only the helmet clears the rim. That is the whole read of the
    #   verb — the beam passes over what is left.
    var rh = CFG_RIDER_H;
    if (cart_crouch > 0) { rh = CFG_RIDER_DUCK_H; }
    var bl = mc_px(ccx + CFG_RIDER_X - CFG_RIDER_HW, cz);
    var br = mc_px(ccx + CFG_RIDER_X + CFG_RIDER_HW, cz);
    var hl = mc_px(ccx + CFG_RIDER_X - CFG_RIDER_HEAD_HW, cz);
    var hr = mc_px(ccx + CFG_RIDER_X + CFG_RIDER_HEAD_HW, cz);
    var ry0 = mc_py(rim, cz);
    var ry1 = mc_py(rim - rh, cz);
    mc_quad(&mc_vtx_a, &mc_n_a,
      hl, ry1, cw, ATL_RIDER_U0, ATL_RIDER_V0,   hr, ry1, cw, ATL_RIDER_U1, ATL_RIDER_V0,
      br, ry0, cw, ATL_RIDER_U1, ATL_RIDER_V1,   bl, ry0, cw, ATL_RIDER_U0, ATL_RIDER_V1);
    return 0;
}

# ---- build one frame -------------------------------------------------------------------------------------
# ⛔⛔ ONE RECORD, ONE LIST. The frame used to be two op 0x0F records (floor+ceiling, then walls) and
# that is UNSOUND for this op: it replaces its ENTIRE rect, writing bg wherever no triangle covered
# the lane, so the second record painted opaque black over everything the first had drawn. The first
# iron frame showed the walls and nothing else. RECORDS DO NOT LAYER, and nothing in the ABI says so.
#
# Slabs are walked FAR TO NEAR: op 0x0F REPLACES the destination pixel rather than compositing, so
# painter's order IS the depth test. A tunnel is convex from the inside and nothing interpenetrates,
# which is what makes that sound without op 0x0E's z buffer.
#
# cam_x is the cart's lateral offset from the centre line, in RENDER UNITS.
fn mc_build(cam_x): i64 {
    mc_n_a = 0;
    mc_n_b = 0;
    mc_drop_flat = 0;
    mc_drop_huge = 0;
    mc_drop_coord = 0;
    mc_drop_band = 0;
    mc_drop_full = 0;
    mc_cull = 0;
    mc_refused = 0;

    # ---- ⭐ THE DERAIL CLOCK IS FELT AS A SHAKE --------------------------------------------------
    # cart_derail counts consecutive ticks past the lean threshold; at CFG_DERAIL_TICKS the cart is
    # lost. The frame shakes in proportion — the brief's "escalating shake", and the one warning that
    # says HOW LONG is left rather than merely that something is wrong. Hashed from the tick, never
    # drawn from fx_rand, so it cannot perturb the simulation's generator.
    mc_shx = 0;
    mc_shy = 0;
    if (cart_derail > 0) {
        var amp = 1 + (cart_derail * CFG_SHAKE_PX) / CFG_DERAIL_TICKS;
        var hs = (cart_ticks * 2246822519) >>> 9;
        mc_shx = (hs % (2 * amp + 1)) - amp;
        mc_shy = ((hs >>> 8) % (2 * amp + 1)) - amp;
    }

    mc_walk();

    # ⚠ THE FLOOR BAND ENDS AT MC_TEX_FLOOR (see mc_floor_run), not at MC_TEX_HALF (u 64). Everything
    # between the two is reserved — the sprite atlas, two swatches and the rail strip — and a floor
    # quad spanning to 64 would drag them into the ballast, which is how treasure once came to be drawn
    # as bits of rail. The rock is the other half:
    var H = MC_TEX_HALF;      # rock starts here
    var T = MC_TEXFULL;       # rock material:   u in [H, T)

    # ---- ⭐ THE FAR CAP, AND WHY THE FRAME IS WRONG WITHOUT IT ---------------------------------
    # ⛔ op 0x0F writes GPU_TRID_BG — opaque BLACK — into every lane no triangle covered, and the
    # game cannot change that: the record has no background-colour field. So the mouth of the tunnel
    # beyond the far plane came out as a hard-edged black octagon sitting in the middle of the
    # screen. It does not read as "the shaft continues into the dark"; it reads as a HOLE IN THE
    # WORLD, which is worse than a visual flaw because the player's eye goes straight to it.
    # ⇒ One quad at the far plane, sampling the near-black cap swatch with a CONSTANT attribute at
    #   every corner. Drawn FIRST so every slab overwrites it — painter's order does the rest.
    # ⚠ It spans the full bore rather than the arch, so no sliver of bg survives at the corners.
    var capz = load64(&mc_s_rz + (mc_nslab - 1) * 8);
    var capx = load64(&mc_s_cx + (mc_nslab - 1) * 8) - cam_x;
    var capy = load64(&mc_s_cy + (mc_nslab - 1) * 8);
    var capw = mc_wof(capz);
    var cl = mc_px(capx - MC_TW, capz);
    var cr = mc_px(capx + MC_TW, capz);
    var ct = mc_py(capy - MC_CEIL_Y, capz);
    var cb = mc_py(capy + MC_FLOOR_Y, capz);
    mc_quad(&mc_vtx_a, &mc_n_a,
      cl, ct, capw, MC_TEX_CAPDARK, 0,   cr, ct, capw, MC_TEX_CAPDARK, 0,
      cr, cb, capw, MC_TEX_CAPDARK, 0,   cl, cb, capw, MC_TEX_CAPDARK, 0);

    var k = mc_nslab - 2;
    while (k >= 0) {
        var rzn = load64(&mc_s_rz + k * 8);
        var rzf = load64(&mc_s_rz + (k + 1) * 8);
        var cn  = load64(&mc_s_cx + k * 8) - cam_x;
        var cf  = load64(&mc_s_cx + (k + 1) * 8) - cam_x;
        var gn  = load64(&mc_s_cy + k * 8);
        var gf  = load64(&mc_s_cy + (k + 1) * 8);
        var vn  = load64(&mc_s_v + k * 8);
        var vf  = load64(&mc_s_v + (k + 1) * 8);

        var wn = mc_wof(rzn);
        var wf = mc_wof(rzf);

        # the bore's six horizontal stations, near and far
        var ln  = mc_px(cn - MC_TW,      rzn);  var lf  = mc_px(cf - MC_TW,      rzf);
        var rn  = mc_px(cn + MC_TW,      rzn);  var rf  = mc_px(cf + MC_TW,      rzf);
        var cln = mc_px(cn - MC_CEIL_HW, rzn);  var clf = mc_px(cf - MC_CEIL_HW, rzf);
        var crn = mc_px(cn + MC_CEIL_HW, rzn);  var crf = mc_px(cf + MC_CEIL_HW, rzf);

        # ...and its four vertical ones. Grade shifts the whole section up or down.
        var fln = mc_py(gn + MC_FLOOR_Y,      rzn); var flf = mc_py(gf + MC_FLOOR_Y,      rzf);
        var arn = mc_py(gn - MC_ARCH_Y,       rzn); var arf = mc_py(gf - MC_ARCH_Y,       rzf);
        var cen = mc_py(gn - MC_CEIL_Y,       rzn); var cef = mc_py(gf - MC_CEIL_Y,       rzf);

        # ---- ⭐⭐ THE FLOOR, SEGMENT BY SEGMENT -----------------------------------------------------
        # ⛔ A GAP USED TO BE WHOLE SLABS. The floor was dropped for a slab when the segment at its NEAR
        # endpoint was a gap — so a 3-segment gap (96 ru) out at the 64 ru slabs showed as one missing
        # slab or two depending on alignment, popping between 64 and 128 ru as it approached; its lip
        # snapped from boundary to boundary; and near the cart it could sit up to half a segment away
        # from where cart_tick puts it. With the cart now drawn exactly where the rules apply, the
        # hole it falls into has to be exactly where the rules say it is.
        # ⇒ Each slab's floor is cut at the segment boundaries inside it and drawn as RUNS of equal
        #   state — gap (nothing), one track, or three. A slab with one state is still one quad; the
        #   extra quads appear only where a gap or a 3-track section begins or ends.
        # ⭐ A GAP IS DRAWN BY NOT DRAWING. Omitting the floor leaves op 0x0F's background showing
        # through — an actual hole in the world, at zero triangle cost, and unmistakable.
        var sfirst = (mc_cam_ru + rzn) >>> 5;
        var slast  = (mc_cam_ru + rzf - 1) >>> 5;
        var run_a  = rzn;
        var run_st = 0 - 1;                  # 0 gap, 1 one track, 2 three tracks
        var sj = sfirst;
        while (sj <= slast) {
            var pa = sj * 32 - mc_cam_ru;
            if (pa < rzn) { pa = rzn; }
            var fseg = mc_cam_seg + sj;
            var st = 1;
            if (trk_live(fseg) == 1) {
                if (trk_kind_at(fseg) == KIND_GAP) { st = 0; }
                if (st == 1) { if (trk_multi_at(fseg) == 1) { st = 2; } }
            }
            if (st != run_st) {
                if (run_st > 0) { mc_floor_run(k, run_a, pa, run_st - 1, cam_x); }
                run_a = pa;
                run_st = st;
            }
            sj = sj + 1;
        }
        if (run_st > 0) { mc_floor_run(k, run_a, rzf, run_st - 1, cam_x); }

        # left wall — u runs floor-to-springing so the rock does not smear
        mc_quad(&mc_vtx_a, &mc_n_a,
          lf, arf, wf, H, vf,   lf, flf, wf, T, vf,
          ln, fln, wn, T, vn,   ln, arn, wn, H, vn);

        # right wall
        mc_quad(&mc_vtx_a, &mc_n_a,
          rf, flf, wf, H, vf,   rf, arf, wf, T, vf,
          rn, arn, wn, T, vn,   rn, fln, wn, H, vn);

        # ⭐ THE CHAMFERS ARE WHAT MAKE IT AN ARCH. Without them this is a rectangular box, which
        # reads as a corridor rather than a bored shaft. Two quads a slab is the cheapest section
        # that still has a shoulder.
        # left chamfer — springing line up to the ceiling edge
        mc_quad(&mc_vtx_a, &mc_n_a,
          clf, cef, wf, H, vf,   lf,  arf, wf, T, vf,
          ln,  arn, wn, T, vn,   cln, cen, wn, H, vn);

        # right chamfer
        mc_quad(&mc_vtx_a, &mc_n_a,
          rf,  arf, wf, H, vf,   crf, cef, wf, T, vf,
          crn, cen, wn, T, vn,   rn,  arn, wn, H, vn);

        # ceiling — ⛔ AT EVERY DEPTH. It was gated to rzn < 128 to save budget, which left the far
        # half of the roof undrawn: op 0x0F's opaque background showed through as a black wedge
        # across the top of EVERY frame, 15% of the upper half of the screen. The gate's coverage
        # check passed it at 82.6%. The near ceiling it kept is above the top edge and culled anyway.
        mc_quad(&mc_vtx_a, &mc_n_a,
          clf, cef, wf, H, vf,   crf, cef, wf, T, vf,
          crn, cen, wn, T, vn,   cln, cen, wn, H, vn);

        mc_objects(k, rzn, rzf, cam_x);
        k = k - 1;
    }

    # ---- ⭐⭐ THE CART IS DRAWN LAST — A DELIBERATE CHEAT ON PAINTER'S ORDER ----------------------
    # ⛔ Strictly, anything the cart has already PASSED hangs between the camera and the cart and should
    # be painted over it. That was tried, and measured on screen: a beam at rider height, once ducked,
    # sits right across the camera's line of sight to the cart and hid the cart completely for ~11
    # frames (0.2 s) — straight after the duck, which is exactly when a stacked gap needs the player
    # to see their cart. Correct occlusion, unplayable result.
    # ⇒ The player's own cart is never hidden by something it has left behind. Passed objects slide
    #   behind it and off the bottom of the frame instead. Every object AHEAD of the cart is still
    #   drawn before it, where painter's order and physics agree.
    mc_cart_draw(cam_x);
    # the HUD goes on top of everything, and is never shaken
    mc_hud();
    return mc_n_a;
}

# ⭐ THE CART LIVES IN cart.cyr AND IS INCLUDED BEFORE THIS FILE. It is not in main.cyr because the
# host reference renderer must drive the SAME physics to reproduce the frame the GPU was asked to
# draw — two copies of the stepping logic is two things to keep in sync, and a reference that has
# silently drifted is worse than no reference at all.
