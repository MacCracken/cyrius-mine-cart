# fxtest.cyr — the self-test for the fixed-point core.
#
# ⭐ WHY THIS RUNS ON THE HOST AND WHY IT RUNS FIRST. On the target there is no debugger, no
# printf-into-a-log, and a wrong shift does not crash — it draws a plausible picture with the track
# bending the wrong way. The only affordable proof is arithmetic checked against values derived
# OUTSIDE this program, before any of it reaches iron. Every expected number below was computed
# independently and is written as a literal, so this file cannot agree with a broken fx.cyr by
# sharing its mistake.
#
# ⛔ THE MOST IMPORTANT TEST HERE IS fxt_shifts(), AND IT LOOKS LIKE A TAUTOLOGY. It asserts that
# `>>` is logical and `>>>` is arithmetic. That is not testing the game — it is PINNING A LANGUAGE
# PROPERTY the whole engine is built on, so that a toolchain that ever changes it fails here loudly
# instead of failing on iron as a track that curves correctly to the right and catastrophically to
# the left.

var fxt_fail = 0;
var fxt_ran  = 0;

# ⚠ Reports only failures. A self-test that prints a line per assertion buries its own signal; this
# one is silent until something is wrong, then names the case, the value it got and the value it
# wanted. Silence plus a count is the pass condition.
fn fxt_eq(name, got, want): i64 {
    fxt_ran = fxt_ran + 1;
    if (got == want) { return 0; }
    fxt_fail = fxt_fail + 1;
    ps("    FAIL "); ps(name); ps(": got "); pn(got); ps(", want "); pn(want); nl();
    return 1;
}

# assert a condition, report it by name on failure
fn fxt_true(name, cond): i64 {
    fxt_ran = fxt_ran + 1;
    if (cond != 0) { return 0; }
    fxt_fail = fxt_fail + 1;
    ps("    FAIL "); ps(name); ps(": condition false"); nl();
    return 1;
}

# |got - want| <= tol
fn fxt_near(name, got, want, tol): i64 {
    fxt_ran = fxt_ran + 1;
    var d = got - want;
    if (d < 0) { d = 0 - d; }
    if (d <= tol) { return 0; }
    fxt_fail = fxt_fail + 1;
    ps("    FAIL "); ps(name); ps(": got "); pn(got); ps(", want "); pn(want);
    ps(" +-"); pn(tol); ps(" (off by "); pn(d); ps(")"); nl();
    return 1;
}

# ---- the language property the engine stands on ----------------------------------------------
# ⛔⛔ IF THIS SECTION EVER FAILS, STOP. Do not adjust the engine to compensate — every `>>>` in the
# tree is written on the assumption asserted here, and "fixing" one call site while the rest of the
# codebase still believes the old rule produces a build that is wrong in a different, subtler place.
fn fxt_shifts(): i64 {
    fxt_eq("(-16) >>> 2 is ARITHMETIC", (0 - 16) >>> 2, 0 - 4);
    fxt_eq("(-16) >>  2 is LOGICAL",    (0 - 16) >>  2, 4611686018427387900);
    fxt_eq("(-1)  >>> 1 is ARITHMETIC", (0 - 1) >>> 1, 0 - 1);
    fxt_eq("(-1)  >>  1 is LOGICAL",    (0 - 1) >>  1, 9223372036854775807);
    # the exact expression fx_mul uses, on the exact operands that expose the bug:
    # -2.5 * 3.0 = -7.5  ->  -491520 in Q16.16
    fxt_eq("fx_mul shift on negatives", (((0 - 163840) * 196608) >>> 16), 0 - 491520);
    # ⚠ and the positive case, which is IDENTICAL under both shifts — this is why the bug hides
    fxt_eq("fx_mul shift on positives", ((163840 * 196608) >>> 16), 491520);
    return 0;
}

# ---- Q16.16 arithmetic -------------------------------------------------------------------------
fn fxt_mul(): i64 {
    fxt_eq("1.0 * 1.0",       fx_mul(FX_ONE, FX_ONE), FX_ONE);
    fxt_eq("2.0 * 3.0",       fx_mul(2 * FX_ONE, 3 * FX_ONE), 6 * FX_ONE);
    fxt_eq("0.5 * 0.5",       fx_mul(FX_HALF, FX_HALF), 16384);
    fxt_eq("-2.5 * 3.0",      fx_mul(0 - 163840, 196608), 0 - 491520);
    fxt_eq("-1.0 * -1.0",     fx_mul(0 - FX_ONE, 0 - FX_ONE), FX_ONE);
    fxt_eq("2.5 * -3.0",      fx_mul(163840, 0 - 196608), 0 - 491520);
    fxt_eq("x * 0",           fx_mul(12345678, 0), 0);
    # ⭐ the sign-symmetry property that a logical shift breaks and a naive test misses
    fxt_eq("sign symmetry",   fx_mul(0 - 163840, 196608), 0 - fx_mul(163840, 196608));
    return 0;
}

# fx_div: exact quotients, sign handling, the divide-by-zero saturation
fn fxt_div(): i64 {
    fxt_eq("6.0 / 3.0",   fx_div(6 * FX_ONE, 3 * FX_ONE), 2 * FX_ONE);
    fxt_eq("-6.0 / 3.0",  fx_div(0 - 6 * FX_ONE, 3 * FX_ONE), 0 - 2 * FX_ONE);
    fxt_eq("6.0 / -3.0",  fx_div(6 * FX_ONE, 0 - 3 * FX_ONE), 0 - 2 * FX_ONE);
    fxt_eq("1.0 / 2.0",   fx_div(FX_ONE, 2 * FX_ONE), FX_HALF);
    # ⛔ the guard that stops a SIGFPE killing the process mid-frame with no diagnostic
    fxt_eq("1.0 / 0 saturates +",  fx_div(FX_ONE, 0), 2147483647);
    fxt_eq("-1.0 / 0 saturates -", fx_div(0 - FX_ONE, 0), 0 - 2147483647);
    fxt_eq("0 / 0 saturates +",    fx_div(0, 0), 2147483647);
    # ⚠ the <<16 overflow clamp: without it this returns a large NEGATIVE number for a positive input
    fxt_true("huge/1.0 stays positive", fx_div(1 << 50, FX_ONE) > 0);
    # round-trip: (a*b)/b == a for values well inside range
    fxt_eq("roundtrip mul/div", fx_div(fx_mul(3 * FX_ONE, 7 * FX_ONE), 7 * FX_ONE), 3 * FX_ONE);
    return 0;
}

# fx_lerp: exact at both endpoints, monotone between
fn fxt_lerp(): i64 {
    # ⭐ BOTH ENDPOINTS MUST BE EXACT. A lerp that lands one ulp short of b at t=1.0 makes every
    # easing in the game asymptotic instead of finished.
    fxt_eq("lerp t=0",      fx_lerp(100, 200, 0), 100);
    fxt_eq("lerp t=1",      fx_lerp(100, 200, FX_ONE), 200);
    fxt_eq("lerp t=0.5",    fx_lerp(0, FX_ONE, FX_HALF), FX_HALF);
    fxt_eq("lerp negative", fx_lerp(0 - FX_ONE, FX_ONE, FX_HALF), 0);
    fxt_eq("lerp downward", fx_lerp(200, 100, FX_ONE), 100);
    return 0;
}

# clamp, abs and the xorshift generator's fixed points
fn fxt_misc(): i64 {
    fxt_eq("clamp below", fx_clamp(0 - 5, 0, 10), 0);
    fxt_eq("clamp above", fx_clamp(50, 0, 10), 10);
    fxt_eq("clamp inside", fx_clamp(7, 0, 10), 7);
    fxt_eq("abs neg", fx_abs(0 - 7), 7);
    fxt_eq("abs pos", fx_abs(7), 7);
    fxt_eq("abs zero", fx_abs(0), 0);
    return 0;
}

# ---- the sine table ----------------------------------------------------------------------------
fn fxt_sin_cardinals(): i64 {
    # 65536 brads = one full turn, so the quarter marks are 0 / 16384 / 32768 / 49152
    fxt_eq("sin(0)",      fx_sin(0), 0);
    fxt_eq("sin(90)",     fx_sin(16384), 32767);
    fxt_eq("sin(180)",    fx_sin(32768), 0);
    fxt_eq("sin(270)",    fx_sin(49152), 0 - 32767);
    fxt_eq("sin(360)==sin(0)", fx_sin(65536 & 65535), 0);
    # ⭐ COS IS THE SAME TABLE AT +64 ENTRIES. Verified as a value, not as a restatement of the code.
    fxt_eq("cos(0)",      fx_cos(0), 32767);
    fxt_eq("cos(90)",     fx_cos(16384), 0);
    fxt_eq("cos(180)",    fx_cos(32768), 0 - 32767);
    fxt_eq("cos(270)",    fx_cos(49152), 0);
    # the raw (uninterpolated) lookup the design specifies: index = angle >>> 8
    fxt_eq("raw sin(90)", fx_sin_raw(16384), 32767);
    fxt_eq("raw sin(270)", fx_sin_raw(49152), 0 - 32767);
    # Q16.16 flavours are exactly double the Q1.15 ones
    fxt_eq("sin16(90)",   fx_sin16(16384), 65534);
    fxt_eq("cos16(0)",    fx_cos16(0), 65534);
    return 0;
}

# ⭐ THE IDENTITY TEST IS THE ONE THAT WOULD CATCH A CORRUPTED TABLE. Cardinal values only check four
# entries out of 256; sin^2 + cos^2 == 1 exercises every entry and every interpolation step, and a
# single mistyped table value fails it. Worst measured deviation over the circle is 254649 against a
# target of 1073676289 (0.024%); the tolerance below is 0.1%, a 4x margin over the real error.
fn fxt_sin_identity(): i64 {
    var worst = 0;
    var b = 0;
    while (b < 65536) {
        var s = fx_sin(b);
        var c = fx_cos(b);
        var v = s * s + c * c;
        var d = v - 1073676289;
        if (d < 0) { d = 0 - d; }
        if (d > worst) { worst = d; }
        b = b + 13;                       # 13 is coprime with 65536, so this walks the whole circle
    }
    fxt_true("sin^2+cos^2 == 1 within 0.1%", worst <= 1073676);
    if (worst > 1073676) { ps("      worst deviation "); pn(worst); nl(); }
    return 0;
}

# sin(-x) == -sin(x). NOT exact: the interpolation blends forward from the table entry below, which
# is asymmetric about zero. Measured worst case over all 65536 brads is exactly 1 ulp.
fn fxt_sin_odd(): i64 {
    var worst = 0;
    var b = 0;
    while (b < 65536) {
        var d = fx_sin((0 - b) & 65535) + fx_sin(b);
        if (d < 0) { d = 0 - d; }
        if (d > worst) { worst = d; }
        b = b + 7;
    }
    fxt_true("sin(-x) == -sin(x) within 1 ulp", worst <= 1);
    return 0;
}

# ⚠ Bounds matter because these values feed fx_mul chains. A table entry above 32767 would overflow
# the Q1.15 contract and, doubled into Q16.16, silently exceed 1.0.
fn fxt_sin_bounds(): i64 {
    var lo = 999999;
    var hi = 0 - 999999;
    var mono = 1;
    var prev = 0 - 999999;
    var b = 0;
    while (b < 65536) {
        var s = fx_sin(b);
        if (s < lo) { lo = s; }
        if (s > hi) { hi = s; }
        # the first quarter turn must be monotonically non-decreasing
        if (b <= 16384) {
            if (s < prev) { mono = 0; }
            prev = s;
        }
        b = b + 1;
    }
    fxt_eq("sin max", hi, 32767);
    fxt_eq("sin min", lo, 0 - 32767);
    fxt_true("sin monotone over first quarter", mono);
    return 0;
}

# ---- xorshift32 --------------------------------------------------------------------------------
# ⭐ EXPECTED VALUES COMPUTED OUTSIDE THIS PROGRAM. If fx_rand() is ever "optimised", these literals
# are what proves the stream did not change — and an rng whose stream changes invalidates every
# recorded replay and every seeded chapter at once.
fn fxt_rand(): i64 {
    fx_srand(1);
    fxt_eq("xorshift32(1) #1", fx_rand(), 270369);
    fxt_eq("xorshift32(1) #2", fx_rand(), 67634689);
    fxt_eq("xorshift32(1) #3", fx_rand(), 2647435461);
    fxt_eq("xorshift32(1) #4", fx_rand(), 307599695);
    fxt_eq("xorshift32(1) #5", fx_rand(), 2398689233);

    # ⛔ ZERO IS ABSORBING. Seeding with 0 must fall back, or the "random" track is a straight line
    # forever and reads as a level-design decision rather than a bug.
    fx_srand(0);
    fxt_eq("seed 0 falls back", fx_rand(), 723471715);

    # re-seeding is deterministic: the same seed must replay the same stream
    fx_srand(1);
    var a1 = fx_rand();
    fx_srand(1);
    var a2 = fx_rand();
    fxt_eq("same seed replays", a1, a2);

    # the stream stays in 32-bit range and never reaches the absorbing state
    fx_srand(12345);
    var zero_hits = 0;
    var out_of_range = 0;
    var i = 0;
    while (i < 20000) {
        var v = fx_rand();
        if (v == 0) { zero_hits = zero_hits + 1; }
        if (v < 0) { out_of_range = out_of_range + 1; }
        if (v > 4294967295) { out_of_range = out_of_range + 1; }
        i = i + 1;
    }
    fxt_eq("never returns 0", zero_hits, 0);
    fxt_eq("stays in u32 range", out_of_range, 0);

    # bounded helpers
    fx_srand(999);
    var bad = 0;
    i = 0;
    while (i < 5000) {
        var r = fx_rand_n(7);
        if (r < 0) { bad = bad + 1; }
        if (r > 6) { bad = bad + 1; }
        var q = fx_rand_range(0 - 3, 3);
        if (q < 0 - 3) { bad = bad + 1; }
        if (q > 3) { bad = bad + 1; }
        i = i + 1;
    }
    fxt_eq("rand_n / rand_range in bounds", bad, 0);
    fxt_eq("rand_n(0) is 0", fx_rand_n(0), 0);
    fxt_eq("rand_range degenerate", fx_rand_range(5, 5), 5);
    return 0;
}

# ---- the whole suite ---------------------------------------------------------------------------
# Returns the FAILURE COUNT. Callers must branch on != 0, never propagate this as an exit status —
# the process exit code is truncated to 8 bits, so a suite with exactly 256 failures would exit 0.
fn fx_selftest(): i64 {
    fxt_fail = 0;
    fxt_ran  = 0;
    fx_sin_init();

    fxt_true("sine table span (global pool is N*8 bytes)", fx_ok());
    fxt_shifts();
    fxt_mul();
    fxt_div();
    fxt_lerp();
    fxt_misc();
    fxt_sin_cardinals();
    fxt_sin_identity();
    fxt_sin_odd();
    fxt_sin_bounds();
    fxt_rand();

    ps("  fixed-point core: "); pn(fxt_ran); ps(" assertions, ");
    if (fxt_fail == 0) { ps("all pass"); nl(); }
    if (fxt_fail != 0) { pn(fxt_fail); ps(" FAILED"); nl(); }
    return fxt_fail;
}
