# check.cyr — the host gate. Runs on Linux, where there is no #92 and no GPU, and answers the one
# question a burn cannot answer cheaply: WILL THE KERNEL ACCEPT WHAT THIS GAME EMITS?
#
# ⛔⛔ WHY THIS EXISTS AT ALL. `syscall(92, recs, n*64)` validates EVERY record before dispatching
# ANY of them — a rejected batch draws nothing whatsoever. So the difference between a correct
# game and one with a single fraction bit set in one vertex is not a slightly wrong picture, it is
# a black screen, and on this hardware a black screen costs a flash, a reboot, and an adjudication
# that cannot distinguish "record refused" from "no GPU" from "shader wrote nothing". Every rule
# the kernel enforces is re-derived here from the PACKED BYTES, over a scripted run of the actual
# game, before any of that is spent.
#
# ⭐ THE RE-PARSE IS THE POINT, and it is the lesson the kernel's own rungs paid for twice. Checking
# the emitter's INPUTS proves only that the inputs were sane; rung 17 shipped a kernarg swap where
# every witness was correct and both orderings were byte-identical, and rung 15 shipped a
# half-texel offset past four green gates because every implementation shared the convention. So
# this gate re-reads the 64-byte records exactly as the kernel will — sign-extending the same way,
# masking the same way, at the same four draw-rect corners — and never looks at the values that
# were passed in.
#
# ⚠ The mirror is agnos kernel/core/syscall.cyr gpo_validate_triperspec (:4857 at agnos 1.57.7).
# Codes below are that file's GPO_E_* values; if the kernel renumbers, this is where it drifts.

# load a 32-bit field SIGN-extended, as the kernel reads coordinates
fn mc_i32(p): i64 {
    var v = load32(p) & 0xFFFFFFFF;
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}

var mc_ck_fail = 0;         # rule violations found in the packed records
var mc_ck_why  = 0;         # first violation's code, for the report
var mc_ck_peak_d = 0;       # the largest |D| the RE-PARSE saw — must equal the emitter's mc_peak_d

# record one violation; the first one's code is kept for the report
fn mc_ck_note(code): i64 {
    if (mc_ck_fail == 0) { mc_ck_why = code; }
    mc_ck_fail = mc_ck_fail + 1;
    return 0;
}

# ---- re-validate ONE packed record, from its bytes, by the kernel's rules ---------------------
# codes mirror the kernel's GPO_E_* so a host failure names the same thing a burn would
fn mc_ck_rec(b): i64 {
    # ⛔ 24, NOT 21. A non-zero reserved dword is GPO_E_TRILIST in the kernel; 21 is GPO_E_WORK. The
    # gate used to report this one as 21, so the one violation it named could not be looked up.
    if ((load32(b + 60) & 0xFFFFFFFF) != 0) { return mc_ck_note(24); }   # GPO_E_TRILIST

    var f = 0;
    while (f < 3) {
        var cx = mc_i32(b + f * 20 + 0);
        var cy = mc_i32(b + f * 20 + 4);
        if (cx > MC_COORD_MAX) { return mc_ck_note(20); }                 # GPO_E_COORD
        if (cy > MC_COORD_MAX) { return mc_ck_note(20); }
        if (cx < 0 - MC_COORD_MAX) { return mc_ck_note(20); }
        if (cy < 0 - MC_COORD_MAX) { return mc_ck_note(20); }
        if ((cx & 0xFFFF) != 0) { return mc_ck_note(30); }               # GPO_E_SUBPIXEL
        if ((cy & 0xFFFF) != 0) { return mc_ck_note(30); }
        f = f + 1;
    }

    var w0 = load32(b +  8) & 0xFFFFFFFF;
    var w1 = load32(b + 28) & 0xFFFFFFFF;
    var w2 = load32(b + 48) & 0xFFFFFFFF;
    if (w0 < MC_W_MIN) { return mc_ck_note(33); }                        # GPO_E_WRANGE
    if (w1 < MC_W_MIN) { return mc_ck_note(33); }
    if (w2 < MC_W_MIN) { return mc_ck_note(33); }
    if (w0 > MC_W_MAX) { return mc_ck_note(33); }
    if (w1 > MC_W_MAX) { return mc_ck_note(33); }
    if (w2 > MC_W_MAX) { return mc_ck_note(33); }

    var dax = 2 * (mc_i32(b +  0) >>> 16);  var day = 2 * (mc_i32(b +  4) >>> 16);
    var dbx = 2 * (mc_i32(b + 20) >>> 16);  var dby = 2 * (mc_i32(b + 24) >>> 16);
    var dcx = 2 * (mc_i32(b + 40) >>> 16);  var dcy = 2 * (mc_i32(b + 44) >>> 16);

    var cross = ((dbx - dax) * (dcy - day) - (dby - day) * (dcx - dax)) / 4;
    if (cross < 0) { cross = 0 - cross; }
    var a2 = cross << 16;
    if (a2 < MC_AREA_MIN) { return mc_ck_note(22); }                     # GPO_E_AREA
    if (a2 > MC_AREA_MAX) { return mc_ck_note(22); }

    var W0 = 65536 / w0;
    var W1 = 65536 / w1;
    var W2 = 65536 / w2;
    var u0 = load32(b + 12) & 0xFFFFFFFF;  var v0 = load32(b + 16) & 0xFFFFFFFF;
    var u1 = load32(b + 32) & 0xFFFFFFFF;  var v1 = load32(b + 36) & 0xFFFFFFFF;
    var u2 = load32(b + 52) & 0xFFFFFFFF;  var v2 = load32(b + 56) & 0xFFFFFFFF;

    # ⛔⛔ THE CORNERS ARE THE DRAW RECT'S, IN FRAMEBUFFER-ABSOLUTE SAMPLE SPACE — `2*dx + 1`, exactly
    # as the kernel computes them. This used to be `qx0 = 1`, i.e. a rect pinned at (0,0), long after
    # the frame moved to its real on-screen offset. geom.cyr's emitter had been corrected and this,
    # the INDEPENDENT re-parse, had not: at the (80,96) and (960,520) offsets the gate exists to
    # probe, it evaluated D at four points the kernel never looks at. Measured: it reported a peak of
    # 290,364,480 where the kernel's own corners give 277,334,400 — a different number for the one
    # bound that turns a frame black, which means it could pass a record the kernel refuses as easily
    # as it could fail one the kernel accepts. The emitter and the re-parse now report the same peak,
    # and the gate asserts that they do (restoring the old corners turns the gate red).
    var qx0 = 2 * MC_DX + 1;  var qx1 = 2 * (MC_DX + MC_W - 1) + 1;
    var qy0 = 2 * MC_DY + 1;  var qy1 = 2 * (MC_DY + MC_H - 1) + 1;
    var k = 0;
    while (k < 4) {
        var qx = qx0; var qy = qy0;
        if (k == 1) { qx = qx1; qy = qy0; }
        if (k == 2) { qx = qx0; qy = qy1; }
        if (k == 3) { qx = qx1; qy = qy1; }
        var e0 = (dcx - dbx) * (qy - dby) - (dcy - dby) * (qx - dbx);
        var e1 = (dax - dcx) * (qy - dcy) - (day - dcy) * (qx - dcx);
        var e2 = (dbx - dax) * (qy - day) - (dby - day) * (qx - dax);
        var D = e0 * W0 + e1 * W1 + e2 * W2;
        if (D < 0) { D = 0 - D; }
        if (D > mc_ck_peak_d) { mc_ck_peak_d = D; }
        if (D > MC_D_MAX) { return mc_ck_note(34); }                     # GPO_E_DRANGE
        var Nu = e0 * (W0 * u0) + e1 * (W1 * u1) + e2 * (W2 * u2);
        var Nv = e0 * (W0 * v0) + e1 * (W1 * v1) + e2 * (W2 * v2);
        if (Nu < 0) { Nu = 0 - Nu; }
        if (Nv < 0) { Nv = 0 - Nv; }
        if (Nu > MC_N_MAX) { return mc_ck_note(34); }
        if (Nv > MC_N_MAX) { return mc_ck_note(34); }
        k = k + 1;
    }
    return 0;
}

# re-validate every record in a list, by the kernel's rules, from its bytes
fn mc_ck_list(list, n): i64 {
    var i = 0;
    while (i < n) { mc_ck_rec(list + i * 64); i = i + 1; }
    return 0;
}

# ---- ⭐ THE OP RECORD ITSELF, not just the triangles it points at ------------------------------
# ⛔ NOTHING CHECKED THIS BEFORE. The gate re-parsed every 64-byte TRIANGLE and never once looked at
# the 64-byte OP RECORD that carries the draw rect, the texture dims and the triangle count — the
# record gpo_validate_triperspec reads FIRST, and whose every rule is a whole-batch refusal. It was
# packed inline in an agnos-only function, so the host could not even see it. It is packed by
# mc_pack_op() now, in one place both paths share, and re-parsed here byte by byte.
#
# Slot ids are kernel-issued and cannot be validated off-target; everything else can.
# ⚠ GPO_E_WORK is the one that is closest to the edge: tiles * n_tris must stay <= 2^20, and at
# 640x400 (4000 tiles) the 256-triangle cap spends 1,024,000 of 1,048,576 — a 2.4% margin that a
# larger draw rect would silently exhaust. It is asserted at the CAP, not at the frame's count, so a
# resolution change fails here rather than on the first busy frame on iron.
fn mc_ck_op(d, fbw, fbh): i64 {
    var i = 8;
    while (i < 16) {
        if ((load32(d + i * 4) & 0xFFFFFFFF) != 0) { return mc_ck_note(12); }   # GPO_E_RESERVED
        i = i + 1;
    }
    if ((load32(d + 0) & 0xFFFFFFFF) != 15) { return mc_ck_note(2); }        # GPO_E_BADOP
    if ((load32(d + 4) & 0xFFFFFFFF) != 0)  { return mc_ck_note(12); }       # no flag bits defined

    var wh  = load32(d + 16) & 0xFFFFFFFF;
    var dxy = load32(d + 20) & 0xFFFFFFFF;
    var twh = load32(d + 28) & 0xFFFFFFFF;
    var w  = wh & 0xFFFF;   var h  = (wh >> 16) & 0xFFFF;       # masked non-negative: `>>` is fine
    var dx = dxy & 0xFFFF;  var dy = (dxy >> 16) & 0xFFFF;
    var tw = twh & 0xFFFF;  var th = (twh >> 16) & 0xFFFF;
    if (w < 1) { return mc_ck_note(6); }                                     # GPO_E_DIM
    if (h < 1) { return mc_ck_note(6); }
    if ((w  & (MC_TILE - 1)) != 0) { return mc_ck_note(32); }               # GPO_E_ALIGN
    if ((h  & (MC_TILE - 1)) != 0) { return mc_ck_note(32); }
    if ((dx & (MC_TILE - 1)) != 0) { return mc_ck_note(32); }
    if ((dy & (MC_TILE - 1)) != 0) { return mc_ck_note(32); }
    if (dx + w > fbw) { return mc_ck_note(5); }                              # GPO_E_BOUNDS
    if (dy + h > fbh) { return mc_ck_note(5); }
    if (tw < 1) { return mc_ck_note(26); }                                   # GPO_E_TEXDIM
    if (th < 1) { return mc_ck_note(26); }
    if (tw > MC_TEX_MAX_DIM) { return mc_ck_note(26); }
    if (th > MC_TEX_MAX_DIM) { return mc_ck_note(26); }
    if ((tw & (tw - 1)) != 0) { return mc_ck_note(26); }
    if ((th & (th - 1)) != 0) { return mc_ck_note(26); }
    var nt = load32(d + 24) & 0xFFFFFFFF;
    if (nt < 1) { return mc_ck_note(24); }                                   # GPO_E_TRILIST
    if (nt > MC_TRI_MAX) { return mc_ck_note(24); }
    if ((w / MC_TILE) * (h / MC_TILE) * MC_TRI_MAX > MC_WORK_MAX) { return mc_ck_note(21); }   # GPO_E_WORK
    return 0;
}

# ---- coarse coverage: does the tunnel actually FILL the screen? -------------------------------
# ⭐ THE ONE CHECK THAT IS NOT AN ABI RULE, and the reason it is here: a frame can satisfy every
# rule the kernel enforces and still project to nothing at all. "Legal" and "visible" are different
# claims, and a burn that comes back black would otherwise be indistinguishable from a refused
# batch. Sampled every 4th pixel in each axis, using the same doubled-integer edge functions and
# pixel-centre convention the shader uses, so a covered sample here is a covered pixel there.
var MC_CK_STEP = 4;
var MC_COV_EVERY = 24;      # ride frames between coverage sweeps (a sweep is ~16000 edge tests x n)

# 1 if the doubled sample point (qx, qy) is inside the packed triangle at b
fn mc_ck_hit(b, qx, qy): i64 {
    var dax = 2 * (mc_i32(b +  0) >>> 16);  var day = 2 * (mc_i32(b +  4) >>> 16);
    var dbx = 2 * (mc_i32(b + 20) >>> 16);  var dby = 2 * (mc_i32(b + 24) >>> 16);
    var dcx = 2 * (mc_i32(b + 40) >>> 16);  var dcy = 2 * (mc_i32(b + 44) >>> 16);
    var e0 = (dcx - dbx) * (qy - dby) - (dcy - dby) * (qx - dbx);
    var e1 = (dax - dcx) * (qy - dcy) - (day - dcy) * (qx - dcx);
    var e2 = (dbx - dax) * (qy - day) - (dby - day) * (qx - dax);
    var neg = 0;
    var pos = 0;
    if (e0 < 0) { neg = neg + 1; }
    if (e1 < 0) { neg = neg + 1; }
    if (e2 < 0) { neg = neg + 1; }
    if (e0 > 0) { pos = pos + 1; }
    if (e1 > 0) { pos = pos + 1; }
    if (e2 > 0) { pos = pos + 1; }
    if (neg == 0) { return 1; }
    if (pos == 0) { return 1; }
    return 0;
}

# ⛔ THE DEFECT THIS SIGNATURE EXISTS TO PREVENT, found by reading the gate's own output rather than
# by it failing — which is the whole reason a gate reports numbers and not just a verdict.
# ⭐ A BACKGROUND QUAD COVERS THE WHOLE SCREEN BY CONSTRUCTION. Counting one means "does the frame
# fill the screen" is answered YES by a frame in which every tunnel triangle collapsed to nothing —
# the exact empty-frame case this check was added to detect. `start` skips any leading background
# primitives (MC_BG_TRIS, zero today: op 0x0F clears its own rect).
# ⚠ The frame used to be TWO records, and this summed their coverage — which double-counted every
# pixel where the floor and a wall overlapped and reported 19440 of 16000 possible samples. The frame
# is ONE record now, so one list is the whole picture and there is nothing to union.
fn mc_ck_cover(list, start, n): i64 { return mc_ck_cover_rows(list, start, n, 0, MC_H); }

# ⭐ THE SAME SWEEP OVER ROWS [y0, y1) ONLY. The top half of the frame is roof, arch and far wall on
# every frame the game can produce — a gap is a hole in the FLOOR, and the floor never climbs above
# the horizon — so an uncovered sample up there is always a rendering hole, never level design. The
# whole-frame threshold cannot say that; it has to leave room for a gap under the cart.
fn mc_ck_cover_rows(list, start, n, y0, y1): i64 {
    var hit = 0;
    var py = y0;
    while (py < y1) {
        var px = 0;
        while (px < MC_W) {
            # ⚠ ABSOLUTE sample points: vertices are framebuffer-absolute, so the rect is
            # [MC_DX, MC_DX+MC_W) x [MC_DY, MC_DY+MC_H), not [0, MC_W) x [0, MC_H).
            var qx = 2 * (MC_DX + px) + 1;
            var qy = 2 * (MC_DY + py) + 1;
            var i = start;
            while (i < n) {
                if (mc_ck_hit(list + i * 64, qx, qy) == 1) { hit = hit + 1; i = n; }
                i = i + 1;
            }
            px = px + MC_CK_STEP;
        }
        py = py + MC_CK_STEP;
    }
    return hit;
}
