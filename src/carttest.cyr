# carttest.cyr — self-test for the input decode and the cart physics.
#
# ⭐ THE INPUT TESTS MATTER AS MUCH AS THE PHYSICS ONES. Every hazard in the AGNOS keyboard drain is
# silent: a dropped edge is a jump that "didn't register", a mishandled 0xE0 is an arrow key that
# does something else, a lost break code is a brake that never releases. None of them crash, none of
# them log, and all of them are indistinguishable from the player being wrong. They are tested here
# with synthetic byte streams so they can be proven without a keyboard, on the host, before iron.

var ctt_fail = 0;
var ctt_ran  = 0;

fn ctt_eq(name, got, want): i64 {
    ctt_ran = ctt_ran + 1;
    if (got == want) { return 0; }
    ctt_fail = ctt_fail + 1;
    ps("    FAIL "); ps(name); ps(": got "); pn(got); ps(", want "); pn(want); nl();
    return 1;
}

fn ctt_true(name, cond): i64 {
    ctt_ran = ctt_ran + 1;
    if (cond != 0) { return 0; }
    ctt_fail = ctt_fail + 1;
    ps("    FAIL "); ps(name); ps(": condition false"); nl();
    return 1;
}

# ---- input decode ---------------------------------------------------------------------------------
fn ctt_input(): i64 {
    in_reset();

    # a plain press and release
    in_feed(SC_A);
    ctt_eq("A press -> held", in_held_at(SC_A), 1);
    ctt_eq("A press -> edge", in_edge_at(SC_A), 1);
    in_flush_edges();
    ctt_eq("edge is consumed", in_edge_at(SC_A), 0);
    ctt_eq("held survives the flush", in_held_at(SC_A), 1);
    in_feed(SC_A | 128);
    ctt_eq("A release -> not held", in_held_at(SC_A), 0);

    # ⛔ HAZARD 1: a make AND break of the same key inside ONE drain. Held-state differencing sees
    # nothing happened; the edge must still fire exactly once or a fast tap is silently swallowed.
    in_reset();
    in_feed(SC_SPACE);
    in_feed(SC_SPACE | 128);
    ctt_eq("tap in one drain -> not held", in_held_at(SC_SPACE), 0);
    ctt_eq("tap in one drain -> ONE edge", in_edge_at(SC_SPACE), 1);

    # ⛔ HAZARD 2: 0xE0 arriving as the LAST byte of a drain, its scancode in the NEXT one.
    in_reset();
    in_feed(224);                                   # drain N ends here
    ctt_eq("dangling E0 is remembered", in_ext_carry, 1);
    in_feed(75);                                    # drain N+1 begins: 0x4B = LEFT
    ctt_eq("split E0 decodes as LEFT", in_held_at(SC_LEFT), 1);
    ctt_eq("carry is cleared after use", in_ext_carry, 0);
    # ...and the same key released the same way
    in_feed(224);
    in_feed(75 | 128);
    ctt_eq("split E0 release clears LEFT", in_held_at(SC_LEFT), 0);

    # ⚠ and the extended key must NOT collide with the plain key of the same scancode
    in_reset();
    in_feed(75);                                    # plain 0x4B, not an arrow
    ctt_eq("plain 0x4B is not LEFT", in_held_at(SC_LEFT), 0);
    ctt_true("plain 0x4B lands on its own index", in_held_at(75) == 1);

    # ⛔ HAZARD 3: 0xE1 Pause. Its embedded 0x1D/0x9D would otherwise decode as left-Ctrl.
    in_reset();
    in_feed(225);
    in_feed(29); in_feed(69); in_feed(225); in_feed(157); in_feed(197);
    ctt_eq("Pause sequence is fully swallowed", in_held_at(29), 0);
    ctt_eq("Pause leaves no residue", in_held_at(69), 0);
    # the very next real key still works
    in_feed(SC_D);
    ctt_eq("key after Pause still registers", in_held_at(SC_D), 1);

    # ---- the boundary word --------------------------------------------------------------------------
    in_reset();
    ctt_eq("no input -> empty word", in_word(), 0);
    in_feed(SC_A);
    ctt_true("A sets IN_LEFT", (in_word() & IN_LEFT) != 0);
    in_feed(SC_LSHIFT);
    ctt_true("Shift sets IN_BRAKE", (in_word() & IN_BRAKE) != 0);
    ctt_true("LEFT and BRAKE coexist", (in_word() & IN_LEFT) != 0);
    # ⭐ JUMP IS AN EDGE, NOT A HELD KEY — holding W must not re-fire every tick
    in_reset();
    in_feed(SC_W);
    ctt_true("W sets IN_JUMP on the edge", (in_word() & IN_JUMP) != 0);
    in_flush_edges();
    ctt_true("held W does NOT re-fire IN_JUMP", (in_word() & IN_JUMP) == 0);
    ctt_eq("...but W is still held", in_held_at(SC_W), 1);
    # arrows are accepted alongside A/D
    in_reset();
    in_feed(224); in_feed(77);
    ctt_true("RIGHT arrow sets IN_RIGHT", (in_word() & IN_RIGHT) != 0);
    return 0;
}

# ---- a controlled track ---------------------------------------------------------------------------
# ⚠ The generator emits phrases, so "ride until you hit a hard bend" is not a test — it is a wait.
# This stamps a KNOWN constant curve over the live window so the physics can be measured against a
# number rather than against whatever the seed happened to produce.
fn ctt_track(curve): i64 {
    cart_reset(CFG_SEED_DEFAULT, 0);
    var i = 0;
    while (i < CFG_GEN_AHEAD) {
        trk_put(i, curve, 0, KIND_PLAIN, FLAG_NONE, 0, 0);
        i = i + 1;
    }
    return 0;
}

# ⛔ THE CART OUTRUNS A ONE-SHOT STAMP, AND THAT COST A CONFUSING FAILURE. ctt_track paints 48
# segments; 400 ticks at the redline carries the cart to segment 69 — out onto GENERATED track with
# real curves, where a "speed" test can slip, derail, and then freeze because cart_tick returns early
# once the cart is dead. The symptom was "brake bottoms at the floor: got 12208, want 2844", which
# looks like a brake bug and is not one.
# ⇒ Re-stamp the window under and ahead of the cart every tick, so a test about speed measures speed.
fn ctt_hold(curve, word): i64 {
    var i = 0;
    while (i <= CFG_GEN_AHEAD) {
        trk_put(trk_abs_seg + i, curve, 0, KIND_PLAIN, FLAG_NONE, 0, 0);
        i = i + 1;
    }
    return cart_tick(word);
}

# ---- speed ------------------------------------------------------------------------------------------
fn ctt_speed(): i64 {
    ctt_track(0);
    ctt_eq("starts at the gate speed", cart_speed_sub(), CFG_SPEED_START);

    # released, the cart reaches the cap and holds there
    var t = 0;
    while (t < 400) { ctt_hold(0, 0); t = t + 1; }
    # ⭐ the THROTTLE alone reaches the redline and stops there — 103 km/h has to be earned
    ctt_eq("free-runs to the redline, not past it", cart_speed_sub(), CFG_SPEED_BASE);
    ctt_true("throttle-only tops out at 96 km/h", cart_kmh() >= 95);
    ctt_true("throttle-only does not reach 103", cart_kmh() < 100);
    # ...and a bonus lifts it to the plate's top speed, but no further
    cart_bonus = CFG_APEX_BONUS << 16;
    t = 0;
    while (t < 120) { ctt_hold(0, 0); cart_bonus = CFG_APEX_BONUS << 16; t = t + 1; }
    ctt_true("an apex bonus reaches the design top speed", cart_kmh() >= 102);
    ctt_true("...and never exceeds it", cart_speed_sub() <= CFG_SPEED_MAX);

    # ⚠ braking bottoms out at the FLOOR, not at zero — the cart always moves forward
    t = 0;
    while (t < 400) { ctt_hold(0, IN_BRAKE); t = t + 1; }
    ctt_eq("brake bottoms at the floor", cart_speed_sub(), CFG_SPEED_MIN);
    ctt_true("the cart never stops", cart_speed_sub() > 0);

    # the ramps are asymmetric: braking is faster than rebuilding
    ctt_track(0);
    t = 0;
    while (t < 240) { ctt_hold(0, 0); t = t + 1; }
    var reached = cart_speed_sub();
    ctt_true("~4 s of release reaches the redline", reached >= CFG_SPEED_BASE - 100);
    t = 0;
    while (t < 90) { ctt_hold(0, IN_BRAKE); t = t + 1; }
    ctt_true("~1.5 s of brake reaches the floor", cart_speed_sub() <= CFG_SPEED_MIN + 100);
    return 0;
}

# ---- lean and derail -----------------------------------------------------------------------------------
fn ctt_lean(): i64 {
    # a straight track must never move the cart sideways
    ctt_track(0);
    var t = 0;
    while (t < 300) { ctt_hold(0, 0); t = t + 1; }
    ctt_eq("straight track leaves lean at zero", cart_lean, 0);
    ctt_eq("straight track never derails", cart_dead, 0);

    # ⭐ DIRECTION: a right-hand bend (positive curve) throws the cart LEFT
    ctt_track(CFG_CURVE_MAX);
    t = 0;
    while (t < 40) { cart_tick(0); t = t + 1; }
    ctt_true("right bend pushes the cart LEFT", cart_lean < 0);
    ctt_track(0 - CFG_CURVE_MAX);
    t = 0;
    while (t < 40) { cart_tick(0); t = t + 1; }
    ctt_true("left bend pushes the cart RIGHT", cart_lean > 0);

    # ⭐ SPEED SQUARED: the same bend at half speed must push MUCH less than half as hard.
    # This is the property the whole risk/reward of the brake rests on.
    ctt_track(CFG_CURVE_MAX);
    t = 0;
    while (t < 240) { cart_tick(0); t = t + 1; }        # get to full speed first
    ctt_track(CFG_CURVE_MAX);
    cart_speed = CFG_SPEED_MAX << 16;
    t = 0;
    while (t < 30) { cart_tick(0); t = t + 1; }
    var lean_fast = fx_abs(cart_lean);
    ctt_track(CFG_CURVE_MAX);
    cart_speed = (CFG_SPEED_MAX / 2) << 16;
    t = 0;
    while (t < 30) { cart_tick(IN_BRAKE); t = t + 1; }  # hold it near half speed
    var lean_slow = fx_abs(cart_lean);
    ctt_true("half speed pushes far less than half as hard", lean_slow * 2 < lean_fast);

    # ⛔ AN UNATTENDED HARD BEND MUST KILL. If it does not, the derail rule is decoration.
    ctt_track(CFG_CURVE_MAX);
    t = 0;
    var died = 0;
    while (t < 600) {
        if (cart_tick(0) == 0) { died = 1; t = 600; }
        t = t + 1;
    }
    ctt_true("an unattended hard bend derails the cart", died);

    # ⭐⭐ ...and BRAKING must save it, where steering alone no longer can.
    # ⛔ This assertion used to counter-lean only. Under the grip model that is no longer sufficient
    # and should not be: lateral force scales with speed SQUARED, so the only lever that reaches a
    # hard bend at the redline is the brake. Steering places the cart; braking keeps it on the rail.
    ctt_track(CFG_CURVE_MAX);
    t = 0;
    var survived = 1;
    while (t < 600) {
        var w = IN_BRAKE;
        if (cart_lean < 0) { w = w | IN_RIGHT; }
        if (cart_lean > 0) { w = w | IN_LEFT; }
        if (ctt_hold(CFG_CURVE_MAX, w) == 0) { survived = 0; t = 600; }
        t = t + 1;
    }
    ctt_true("BRAKING through a hard bend holds the rail", survived);

    # ...and steering alone through the same bend does NOT
    ctt_track(CFG_CURVE_MAX);
    t = 0;
    var steered_only = 1;
    while (t < 600) {
        var w2 = 0;
        if (cart_lean < 0) { w2 = IN_RIGHT; }
        if (cart_lean > 0) { w2 = IN_LEFT; }
        if (ctt_hold(CFG_CURVE_MAX, w2) == 0) { steered_only = 0; t = 600; }
        t = t + 1;
    }
    ctt_true("steering ALONE does not hold it -- the brake is the lever", steered_only == 0);

    # ---- the derail clock resets on recovery ---------------------------------------------------
    # ⭐ TESTED ON A BEND THAT DRIFTS YOU WIDE WITHOUT BREAKING GRIP, AND THE DISTINCTION MATTERS.
    # Past the threshold WITH the rail let go, 24 ticks is not survivable — that is the whole point
    # of the grip model and an earlier version of this test was asserting the opposite. What is still
    # true, and worth pinning, is that the clock is CONSECUTIVE: come back inside and it zeroes, so a
    # long clean run is never more fragile than a short one.
    # ⚠ Curve 500 at the throttle cap gives ~1699 of lateral force against ~1754 of grip: enough to
    # push the cart wide, not enough to let go.
    ctt_track(500);
    t = 0;
    while (t < 400) {
        if (cart_derail > 0) { t = 400; }
        ctt_hold(500, 0);
        t = t + 1;
    }
    ctt_true("a wide bend starts the derail clock without slipping", cart_derail > 0);
    ctt_eq("...and the rail has NOT let go", cart_slip, 0);

    # now recover: brake and counter-lean, and the clock must zero
    t = 0;
    while (t < 120) {
        var w = IN_BRAKE;
        if (cart_lean < 0 - 65536) { w = w | IN_RIGHT; }
        if (cart_lean >     65536) { w = w | IN_LEFT; }
        ctt_hold(500, w);
        t = t + 1;
    }
    ctt_eq("recovering resets the derail clock", cart_derail, 0);
    ctt_eq("...and the cart survived", cart_dead, 0);

    # ⛔ THE BORE CLAMP IS A RENDERING RULE, NOT A GAMEPLAY ONE — lean outside the tunnel pushes
    # vertices past the coordinate window and the kernel refuses the WHOLE batch.
    ctt_track(0);
    t = 0;
    while (t < 600) { cart_tick(IN_RIGHT); t = t + 1; }
    ctt_true("lean is clamped inside the bore", fx_abs(cart_lean) <= CFG_LEAN_MAX);
    ctt_true("cam_x stays well inside the half-width", fx_abs(cart_cam_x()) < MC_TW);

    # the warning ladder tracks the margin
    ctt_track(0);
    ctt_eq("centred is warning 0", cart_warn(), 0);
    cart_lean = CFG_LEAN_THRESH;
    ctt_eq("at the threshold is warning 3", cart_warn(), 3);
    cart_lean = CFG_LEAN_THRESH / 2;
    ctt_true("halfway out is warning 1 or 2", cart_warn() >= 1);
    return 0;
}

# ---- ⭐⭐ GRIP: the mechanic the whole difficulty rests on -------------------------------------
# Its own function because it is its own idea, and because the assertions below are the ones that
# say "too fast on a bend throws the cart off the rails" is TRUE rather than intended.
fn ctt_grip(): i64 {
    # ⛔ A HARD BEND AT FULL SPEED MUST BREAK THE RAIL. If it does not, there is no reason to brake
    # and the game is a straight line with scenery.
    ctt_track(CFG_CURVE_MAX);
    cart_speed = CFG_SPEED_MAX << 16;
    cart_tick(0);
    ctt_true("full speed through a hard bend BREAKS grip", cart_slip == 1);
    ctt_eq("...and a slip is at least warning 2, immediately", cart_warn() >= 2, 1);

    # ...and braking must restore it. This is the entire risk/reward loop in two assertions.
    ctt_track(CFG_CURVE_MAX);
    cart_speed = (CFG_SPEED_MAX / 2) << 16;
    cart_tick(0);
    ctt_eq("half speed through the SAME bend holds", cart_slip, 0);

    # a gentle bend at full speed must NOT break grip, or every curve is lethal and the brake is
    # not a decision but a permanent state
    ctt_track(384);
    cart_speed = CFG_SPEED_MAX << 16;
    cart_tick(0);
    ctt_eq("a gentle bend at full speed holds", cart_slip, 0);

    # a straight never slips at any speed
    ctt_track(0);
    cart_speed = CFG_SPEED_MAX << 16;
    var st = 0;
    var slipped = 0;
    while (st < 120) { cart_tick(0); cart_speed = CFG_SPEED_MAX << 16; if (cart_slip == 1) { slipped = 1; } st = st + 1; }
    ctt_eq("a straight never slips, at any speed", slipped, 0);

    # ⭐ AND THE PAYOFF: entering a hard bend at the redline and doing nothing must KILL. This is the
    # assertion that says "too fast on a bend throws the cart off the rails" is actually true.
    ctt_track(CFG_CURVE_MAX);
    cart_speed = CFG_SPEED_MAX << 16;
    st = 0;
    var died = 0;
    while (st < 300) {
        if (cart_tick(0) == 0) { died = 1; st = 300; }
        st = st + 1;
    }
    ctt_true("redline into a hard bend, hands off, DERAILS", died);

    # ...while braking through the same bend survives it
    ctt_track(CFG_CURVE_MAX);
    cart_speed = CFG_SPEED_MAX << 16;
    st = 0;
    var lived = 1;
    while (st < 300) {
        var w2 = IN_BRAKE;
        if (cart_lean < 0 - 65536) { w2 = w2 | IN_RIGHT; }
        if (cart_lean >     65536) { w2 = w2 | IN_LEFT; }
        if (cart_tick(w2) == 0) { lived = 0; st = 300; }
        st = st + 1;
    }
    ctt_true("braking through the same bend SURVIVES it", lived);

    return 0;
}

# ---- ⭐⭐ DUCK AND JUMP: the verbs -----------------------------------------------------------------
# stamp a hazard at a known segment on otherwise clear track
fn ctt_hazard(at, kind, span): i64 {
    cart_reset(CFG_SEED_DEFAULT, 0);
    var i = 0;
    while (i < CFG_GEN_AHEAD) {
        var k = KIND_PLAIN;
        if (i >= at) { if (i < at + span) { k = kind; } }
        trk_put(i, 0, 0, k, FLAG_NONE, 0, 0);
        i = i + 1;
    }
    return 0;
}

# run until the cart passes `until` segments or dies. Returns 1 if it survived.
fn ctt_run_to(seg, word_jump_at, word): i64 {
    var t = 0;
    while (t < 900) {
        if (trk_abs_seg >= seg) { return 1; }
        var w = 0;
        if (word_jump_at >= 0) {
            if (cart_ticks_to(word_jump_at) <= 1) { w = word; }
        }
        if (cart_tick(w) == 0) { return 0; }
        t = t + 1;
    }
    return 1;
}

fn ctt_verbs(): i64 {
    # ---- ⛔ THE JUMP'S SPEED THRESHOLD. The brief calls this the central tension with the brake and
    # says explicitly not to soften it. These two assertions ARE that instruction.
    ctt_hazard(20, KIND_GAP, CFG_GAP_SEGS);
    cart_speed = CFG_SPEED_MAX << 16;
    var fast = ctt_run_to(30, 20, IN_JUMP);
    ctt_true("at full speed the jump CLEARS the gap", fast);

    ctt_hazard(20, KIND_GAP, CFG_GAP_SEGS);
    var t = 0;
    while (t < 900) {
        if (trk_abs_seg >= 30) { t = 900; }
        var w = IN_BRAKE;                        # hold it well under the threshold
        if (cart_ticks_to(20) <= 1) { w = w | IN_JUMP; }
        if (cart_tick(w) == 0) { t = 900; }
        t = t + 1;
    }
    ctt_true("below the threshold the cart COMES UP SHORT", cart_dead == 1);
    ctt_eq("...and the death is a fall, not a derail", cart_death, 2);

    # not jumping at all is also a fall
    ctt_hazard(20, KIND_GAP, CFG_GAP_SEGS);
    cart_speed = CFG_SPEED_MAX << 16;
    ctt_true("not jumping falls in", ctt_run_to(30, 0 - 1, 0) == 0);
    ctt_eq("...as a fall", cart_death, 2);

    # ---- the beam ---------------------------------------------------------------------------------
    ctt_hazard(20, KIND_BEAM, 1);
    cart_speed = CFG_SPEED_MAX << 16;
    var before = cart_integrity;
    ctt_run_to(26, 0 - 1, 0);
    ctt_eq("a beam taken standing costs integrity", cart_integrity, before - CFG_BEAM_DAMAGE);
    ctt_eq("...and is survivable", cart_dead, 0);
    ctt_eq("...and is counted", cart_hits, 1);

    ctt_hazard(20, KIND_BEAM, 1);
    cart_speed = CFG_SPEED_MAX << 16;
    t = 0;
    while (t < 900) {
        if (trk_abs_seg >= 26) { t = 900; }
        var w2 = 0;
        if (cart_ticks_to(20) <= 3) { w2 = IN_DUCK; }
        if (cart_tick(w2) == 0) { t = 900; }
        t = t + 1;
    }
    ctt_eq("ducking clears the beam untouched", cart_integrity, CFG_INTEGRITY_MAX);
    ctt_eq("...and no hit is recorded", cart_hits, 0);

    # ⛔ JUMPING A BEAM DOES NOT HELP. Being airborne is not being ducked, and this asymmetry is what
    # makes a stacked pair a real choice rather than one input that answers both.
    ctt_hazard(20, KIND_BEAM, 1);
    cart_speed = CFG_SPEED_MAX << 16;
    ctt_run_to(26, 20, IN_JUMP);
    ctt_true("jumping a beam still takes the hit", cart_hits >= 1);

    # ---- commitment -------------------------------------------------------------------------------
    ctt_track(0);
    cart_tick(IN_DUCK);
    ctt_true("a duck commits", cart_crouching() == 1);
    ctt_eq("...and blocks acting", cart_can_act(), 0);
    var c0 = cart_crouch;
    cart_tick(IN_JUMP);                          # try to cancel out of it
    ctt_true("the crouch CANNOT be cancelled by jumping", cart_crouching() == 1);
    ctt_eq("...and no jump happened", cart_airborne(), 0);
    ctt_eq("...it just runs down", cart_crouch, c0 - 1);
    # it does expire on its own
    t = 0;
    while (t < CFG_CROUCH_TICKS + 2) { cart_tick(0); t = t + 1; }
    ctt_eq("the crouch expires", cart_crouching(), 0);
    ctt_eq("...and the player can act again", cart_can_act(), 1);

    ctt_track(0);
    cart_tick(IN_JUMP);
    ctt_true("a jump commits", cart_airborne() == 1);
    cart_tick(IN_DUCK);
    ctt_eq("cannot duck in mid-air", cart_crouching(), 0);
    return 0;
}

# ---- pickups ------------------------------------------------------------------------------------------
fn ctt_pickup_at(lane): i64 {
    cart_reset(CFG_SEED_DEFAULT, 0);
    var i = 0;
    while (i < CFG_GEN_AHEAD) {
        var k = KIND_PLAIN;
        if (i == 20) { k = KIND_PICKUP; }
        trk_put(i, 0, 0, k, FLAG_NONE, 0, lane);
        i = i + 1;
    }
    return 0;
}

fn ctt_pickups(): i64 {
    # centre lane, cart on the centre line: collected
    ctt_pickup_at(1);
    ctt_run_to(24, 0 - 1, 0);
    ctt_eq("a pickup in reach is collected", cart_treasure, 1);
    ctt_true("...and scores", cart_score > 0);

    # ⭐ COLLECTION IS A LATERAL TEST, NOT A VOLUME. Same segment, cart parked in the wrong lane.
    ctt_pickup_at(0);                            # treasure on the LEFT
    cart_lean = CFG_PICKUP_LANE_RU << 16;        # cart pinned RIGHT
    var t = 0;
    while (t < 900) {
        if (trk_abs_seg >= 24) { t = 900; }
        cart_lean = CFG_PICKUP_LANE_RU << 16;    # hold it there against the spring
        if (cart_tick(0) == 0) { t = 900; }
        t = t + 1;
    }
    ctt_eq("a pickup out of reach is MISSED", cart_treasure, 0);

    # ⭐ SPEED IS THE MULTIPLIER: the same treasure is worth more taken fast.
    ctt_pickup_at(1);
    cart_speed = CFG_SPEED_MIN << 16;
    t = 0;
    while (t < 900) {
        if (trk_abs_seg >= 24) { t = 900; }
        cart_speed = CFG_SPEED_MIN << 16;
        if (cart_tick(IN_BRAKE) == 0) { t = 900; }
        t = t + 1;
    }
    var slow_score = cart_score;
    ctt_pickup_at(1);
    cart_speed = CFG_SPEED_MAX << 16;
    t = 0;
    while (t < 900) {
        if (trk_abs_seg >= 24) { t = 900; }
        cart_speed = CFG_SPEED_MAX << 16;
        if (cart_tick(0) == 0) { t = 900; }
        t = t + 1;
    }
    ctt_true("the same treasure scores MORE at speed", cart_score > slow_score);
    return 0;
}

# ---- integrity ------------------------------------------------------------------------------------------
fn ctt_integrity(): i64 {
    ctt_track(0);
    ctt_eq("starts whole", cart_integrity, CFG_INTEGRITY_MAX);
    cart_damage(CFG_BEAM_DAMAGE);
    ctt_eq("a beam costs its damage", cart_integrity, CFG_INTEGRITY_MAX - CFG_BEAM_DAMAGE);
    ctt_eq("...and is survivable", cart_dead, 0);
    cart_damage(CFG_INTEGRITY_MAX);
    ctt_eq("integrity floors at zero", cart_integrity, 0);
    ctt_eq("...and an empty cart is destroyed", cart_dead, 1);
    ctt_eq("...with the right cause", cart_death, 3);
    return 0;
}

# ---- generator placement ---------------------------------------------------------------------------------
fn ctt_placement(): i64 {
    # ⛔ NO GAP BEFORE THE CART CAN JUMP ONE. This is the assertion that stops the unwinnable opening
    # the first build shipped: a 3-segment gap at segment 10, against a cart that leaves the gate at
    # 46% of the cap and needs 62% to clear it. Both pilots died there every single run.
    trk_reset(CFG_SEED_DEFAULT, 0);
    var early_gap = 0;
    var early_haz = 0;
    var t = 0;
    while (t < 4000) { trk_advance(8533); t = t + 1; }
    var a = 0;
    while (a < CFG_GAP_NONE_SEGS) {
        if (trk_live(a) == 1) {
            if (trk_kind_at(a) == KIND_GAP) { early_gap = early_gap + 1; }
            if (a < CFG_HAZ_NONE_SEGS) {
                if (trk_kind_at(a) == KIND_BEAM) { early_haz = early_haz + 1; }
            }
        }
        a = a + 1;
    }
    # (the opening segments have long since scrolled out of the ring, so re-generate a fresh chapter)
    trk_reset(CFG_SEED_DEFAULT + 3, 1);
    early_gap = 0; early_haz = 0;
    a = 0;
    while (a < CFG_GAP_NONE_SEGS) {
        if (trk_live(a) == 1) {
            if (trk_kind_at(a) == KIND_GAP) { early_gap = early_gap + 1; }
            if (a < CFG_HAZ_NONE_SEGS) {
                if (trk_kind_at(a) != KIND_PLAIN) {
                    if (trk_kind_at(a) != KIND_GATE) {
                        if (trk_kind_at(a) != KIND_PICKUP) { early_haz = early_haz + 1; }
                    }
                }
            }
        }
        a = a + 1;
    }
    ctt_eq("no gap before the cart can clear one", early_gap, 0);
    ctt_eq("no hazard at all in the opening segments", early_haz, 0);

    # ⚠ a stacked pair must be spaced wider than the longest commitment, or the chain is impossible
    ctt_true("pair spacing exceeds the crouch",
             CFG_HAZ_PAIR_SEGS * CFG_SUB_PER_SEG / CFG_SPEED_MAX > CFG_CROUCH_TICKS);
    ctt_true("pair spacing exceeds the jump",
             CFG_HAZ_PAIR_SEGS * CFG_SUB_PER_SEG / CFG_SPEED_MAX > CFG_JUMP_TICKS);
    return 0;
}

# ---- the apex bonus ------------------------------------------------------------------------------------
# ⭐ THE ONE TEST THAT ENCODES THE INTENDED PLAY. Brake into a tightening bend, release as it opens:
# paid. Sit on the brake the whole way through: not paid. If these two ever agree, the optimal line
# has collapsed into holding the brake and the game is a patience test.
fn ctt_apex(): i64 {
    # a bend that tightens then opens — stamped by hand so the shape is known
    cart_reset(CFG_SEED_DEFAULT, 0);
    var i = 0;
    while (i < CFG_GEN_AHEAD) {
        var c = 0;
        if (i < 8)  { c = 0; }
        if (i >= 8) { if (i < 16) { c = 256 + (i - 8) * 96; } }     # tightening
        if (i >= 16) { if (i < 24) { c = 928 - (i - 16) * 96; } }   # opening
        trk_put(i, c, 0, KIND_PLAIN, FLAG_NONE, 0, 0);
        i = i + 1;
    }
    var start_hits = cart_apex_hits;
    var t = 0;
    while (t < 300) {
        # brake while the bend tightens, release once it starts opening
        var w = 0;
        var cv = 0;
        if (trk_live(trk_abs_seg) == 1) { cv = fx_abs(trk_curve_at(trk_abs_seg)); }
        if (cv > cart_prev_curve) { w = IN_BRAKE; }
        if (cart_lean < 0) { w = w | IN_RIGHT; }
        if (cart_tick(w) == 0) { t = 300; }
        t = t + 1;
    }
    ctt_true("braking in and releasing at the apex PAYS", cart_apex_hits > start_hits);

    # the same bend, brake held throughout — must NOT pay
    cart_reset(CFG_SEED_DEFAULT, 0);
    i = 0;
    while (i < CFG_GEN_AHEAD) {
        var c2 = 0;
        if (i >= 8)  { if (i < 16) { c2 = 256 + (i - 8) * 96; } }
        if (i >= 16) { if (i < 24) { c2 = 928 - (i - 16) * 96; } }
        trk_put(i, c2, 0, KIND_PLAIN, FLAG_NONE, 0, 0);
        i = i + 1;
    }
    start_hits = cart_apex_hits;
    t = 0;
    while (t < 300) {
        var w2 = IN_BRAKE;
        if (cart_lean < 0) { w2 = w2 | IN_RIGHT; }
        if (cart_tick(w2) == 0) { t = 300; }
        t = t + 1;
    }
    ctt_eq("holding the brake through the bend pays NOTHING", cart_apex_hits, start_hits);
    return 0;
}

# ---- determinism ------------------------------------------------------------------------------------------
# ⭐ THIS IS THE SHAPE OF THE STEP-11 REPLAY TEST, ARRIVING EARLY BECAUSE IT COSTS NOTHING TO DO SO.
# The sim is a pure function of (input word, world state) — no clock, no keyboard, no rng outside the
# generator — so a scripted word sequence must reproduce the identical end state every time.
fn ctt_run_sum(seed, ticks): i64 {
    cart_reset(seed, 0);
    var h = 0;
    var t = 0;
    while (t < ticks) {
        # a deterministic pseudo-player: leans against the drift and brakes periodically
        var w = 0;
        if (cart_lean < 0) { w = IN_RIGHT; }
        if (cart_lean > 0) { w = IN_LEFT; }
        if ((t % 37) < 11) { w = w | IN_BRAKE; }
        cart_tick(w);
        h = (h * 1000003 + cart_lean + cart_speed * 7 + trk_abs_seg * 13) & 0xFFFFFFFF;
        t = t + 1;
    }
    return h;
}

fn ctt_determinism(): i64 {
    var a = ctt_run_sum(CFG_SEED_DEFAULT, 900);
    var b = ctt_run_sum(CFG_SEED_DEFAULT, 900);
    ctt_eq("the same input log replays identically", a, b);
    # and it survives an unrelated run in between — the death-and-retry path
    ctt_run_sum(CFG_SEED_DEFAULT + 5, 400);
    var c = ctt_run_sum(CFG_SEED_DEFAULT, 900);
    ctt_eq("replay survives an intervening run", a, c);
    var d = ctt_run_sum(CFG_SEED_DEFAULT + 1, 900);
    ctt_true("a different seed diverges", a != d);
    return 0;
}

# ---- the suite -------------------------------------------------------------------------------------------
fn cart_selftest(): i64 {
    ctt_fail = 0;
    ctt_ran  = 0;

    ctt_true("input pool spans", in_ok());
    ctt_input();
    ctt_speed();
    ctt_lean();
    ctt_grip();
    ctt_verbs();
    ctt_pickups();
    ctt_integrity();
    ctt_placement();
    ctt_apex();
    ctt_determinism();

    ps("  cart + input:     "); pn(ctt_ran); ps(" assertions, ");
    if (ctt_fail == 0) { ps("all pass"); nl(); }
    if (ctt_fail != 0) { pn(ctt_fail); ps(" FAILED"); nl(); }
    return ctt_fail;
}
