# config.cyr — THE tunables. One block, every constant named, every unit stated.
#
# ⭐ WHY THESE ARE ALL IN ONE FILE. A magic number buried in a function is a number nobody can retune
# without reading the function, and this game's whole design premise is that the feel comes out of
# the numbers — brake ramp, lean threshold, curve force, derail patience. Tuning has to be a diff of
# this file and nothing else. If you find yourself typing a literal into track.cyr or cart.cyr,
# it belongs here instead.
#
# ⚠ The texture's own constants (MC_TEX, MC_TEX_HALF, MC_TEXFULL) stay in tex.cyr, next to the code
# that paints with them. Everything that shapes the world or the projection is here.
# ⛔ ONE DECLARATION EACH. A second `var MC_W = ...` anywhere would not be an error — Cyrius lets the
# last one win, silently, across the WHOLE program including code compiled before it.
#
# ⛔ UNITS ARE NOT DECORATION. Three different scales coexist and mixing them is the easiest way to
# produce a game that is subtly wrong everywhere:
#     SIM CENTIMETRES  — the world. 1 unit = 1 cm. Track length, speed, depth.
#     SUB-UNITS        — position inside a segment. 65536 per segment, so a u16 covers it exactly.
#     RENDER UNITS     — what the projector eats. 1 ru = 8 cm  (see MC_CM2RU_SH in geom.cyr).
#     BRADS            — angle. 65536 = one full turn. Never degrees, never radians.
#     Q16.16           — fixed-point reals. 65536 = 1.0.

# ---- the tick ---------------------------------------------------------------------------------
# The simulation is a fixed 60 Hz step and reads no clock. Rendering may drop frames; the sim never
# does. This is what makes "same seed + same input log = the same frame 10000" true.
var CFG_TICK_HZ = 60;                # simulation steps per second

# ---- segments --------------------------------------------------------------------------------
var CFG_SEG_CM      = 256;           # cm of track per segment (2.56 m)
var CFG_SUB_PER_SEG = 65536;         # position sub-units inside one segment (u16 covers it exactly)
var CFG_SUB_PER_CM  = 256;           # 65536 / 256 — sim cm = pos_sub >>> 8

# ⭐ THE RING IS 128 ENTRIES BUT ONLY 96 ARE LIVE, AND THE GAP IS THE WHOLE POINT.
# ⛔ The design called for a 96-entry ring. 96 is not a power of two, so the index has to be `% 96`
# — and `%` on a u16 segment counter BREAKS AT THE WRAP: 65535 % 96 = 63 but the next segment, 0,
# gives 0, teleporting the ring 64 entries sideways in a single tick after ~2 h 20 min of play.
# `& 95` is not a fix; it is a different wrong answer (65535 & 95 = 95).
# ⇒ The allocation is 128 so the index is a MASK (`& 127`) that cannot ever be wrong, and the live
#   window stays at the 96 the design asked for. 32 entries of slack is 6 KB and buys an entire
#   class of bug going away.
var CFG_RING_SLOTS = 128;            # ring allocation — MUST be a power of two (mask index)
var CFG_RING_MASK  = 127;            # CFG_RING_SLOTS - 1
var CFG_RING_LIVE  = 96;             # segments kept live = 24576 cm = 245.76 m of track
var CFG_GEN_AHEAD  = 48;             # segments generated beyond the cart = 12288 cm = 122.88 m
                                     # ⚠ 3x the 4096 cm far plane, so the horizon is never unwritten

# ---- curvature -------------------------------------------------------------------------------
# Brads of heading change per segment. Positive curves right.
#
# ⛔ CFG_CURVE_ABI_MAX IS A CLIFF, NOT A GUIDELINE. Past it the accumulated centre-line pushes a
# vertex outside the |coordinate| <= 4096 px window, which does not clip that triangle — it makes
# the kernel refuse THE WHOLE BATCH, and the frame comes back as whatever was in the slot before.
# On iron that is a black screen. Bisected at 12875 for the worst-case draw-rect offset (960,520);
# 12800 is the round number below it.
# ⭐ The DESIGN band is 128..1024, two orders of magnitude below the cliff:
#      128 brads/seg = 208 m radius = 0.19 g at 20 m/s   (a long sweep)
#     1024 brads/seg =  26 m radius = 1.56 g at 20 m/s   (a hard bend)
#    12800 brads/seg =   2 m radius                       (physically absurd; the clamp, not a target)
# That 12x margin between the hardest curve the generator will ever emit and the ABI limit is
# deliberate headroom, because the limit is a black screen rather than a graphical artefact.
var CFG_CURVE_ABI_MAX = 12800;       # brads/segment — HARD clamp, never exceed
var CFG_CURVE_MAX     = 1024;        # brads/segment — hardest curve the generator will emit
var CFG_CURVE_RAMP    = 128;         # brads/segment of change per segment — curvature continuity
                                     # ⚠ a STEP change in curve is a visible kink in the rail

# ---- grade -----------------------------------------------------------------------------------
# Brads of pitch per segment. POSITIVE IS DOWN (+y is down in the projector, and DEEPVEIN descends).
var CFG_GRADE_MAX     = 512;         # brads/segment — steepest pitch
var CFG_GRADE_RAMP    = 48;          # brads/segment of change per segment
var CFG_GRADE_BIAS    = 96;          # brads/segment the generator leans downhill on average
                                     # ⭐ the shaft goes DOWN; depth in metres is the score axis

# ---- generator phrasing ------------------------------------------------------------------------
# The track is generated as PHRASES — a run of segments holding one curve target, then a transition.
# ⚠ Pure per-segment randomness reads as noise, not as a mine. A driver can only learn a track that
# has shape, and a phrase length in this band is roughly 1-4 seconds at speed.
var CFG_PHRASE_MIN    = 9;           # segments in one curve phrase (23.0 m)
var CFG_PHRASE_MAX    = 26;          # segments (66.6 m)
var CFG_STRAIGHT_PCT  = 34;          # percent of phrases that are dead straight — the rest breathe

# ---- segment kinds ----------------------------------------------------------------------------
# ⚠ Values are frozen: they are written into the ring and read by the renderer and (later) the
# collision walk. Renumbering them silently changes what an already-generated chapter means.
var KIND_PLAIN   = 0;
var KIND_BEAM    = 1;                # duck   — low beam / chute / hanging chain
var KIND_GAP     = 2;                # jump   — gap / broken rail / wrecked cart
var KIND_FORK    = 3;                # branch point
var KIND_PICKUP  = 4;                # treasure / idol
var KIND_GATE    = 5;                # chapter gate — the respawn anchor

# ---- segment flags (bitfield) -------------------------------------------------------------------
var FLAG_NONE    = 0;
var FLAG_LIT     = 1;                # telegraphed branch (an unlit third branch is the shortcut)
var FLAG_SHORTCUT = 2;
var FLAG_HAZARD  = 4;
# ⭐ THREE TRACKS SIDE BY SIDE. Set on every segment of a multi-rail run, so the renderer and the hop
# logic both read it off the segment rather than tracking a mode.
var FLAG_MULTI   = 8;

# ---- multi-rail sections ------------------------------------------------------------------------------
# ⚠ 26 put 54% of all ticks on 3-track sections — measured, not guessed. A section that occupies
# half the game is not a section, it is the game. 10 makes it an event.
var CFG_MULTI_PCT      = 10;         # percent of phrases that become a 3-track run
var CFG_MULTI_MIN_SEGS = 30;         # 77 m — long enough to be a section, not a gimmick
var CFG_MULTI_MAX_SEGS = 70;         # 179 m
var CFG_MULTI_NONE_SEGS = 34;        # none before this, so the player meets one track first

# ---- the screen ---------------------------------------------------------------------------------
# ⛔ BOTH AXES MUST BE MULTIPLES OF GPU_TILE (8) or the record is refused GPO_E_ALIGN — which rejects
# the WHOLE BATCH, not one triangle, and leaves the frame as whatever the slot held before.
var MC_W  = 640;                     # px
var MC_H  = 400;                     # px
var MC_CX = 320;                     # px — horizon centre x
var MC_CY = 200;                     # px — horizon centre y

# ---- the frustum ----------------------------------------------------------------------------------
# ⭐⭐ 16:1 IS THE CEILING THE ABI IMPOSES, NOT A PREFERENCE, AND THE GEOMETRY USES ALL OF IT.
# w must lie in [256, 4096] and w is proportional to depth, so z_far/z_near can NEVER exceed 16 for
# any choice of MC_WSC — a bigger scale pulls the near plane closer AND the far plane in by the same
# factor. Everything nearer than the near plane is simply not drawn.
var MC_FOCAL = 320;                  # px — projection focal length
var MC_ZN    = 32;                   # RENDER units = 256 cm = 2.56 m.  w = 8*32  = 256, ABI floor
var MC_ZF    = 512;                  # RENDER units = 4096 cm = 40.96 m. w = 8*512 = 4096, ABI ceiling
var MC_WSC   = 8;                    # w = MC_WSC * rz

# ⭐ THE SIM-CM -> RENDER-UNIT DIVISOR, AND WHY IT IS 8.
# The sim thinks in centimetres; the projector's usable depth is fixed at [32, 512] render units by
# the 16:1 w band above. At 1 ru = 1 cm that is a 0.32 m to 5.12 m view — five metres of visible
# tunnel, which is not a game. At 1 ru = 8 cm it becomes 2.56 m to 40.96 m: a 38.4 m view, which is
# what "riding a mine cart" needs to look like. A power of two so the conversion is a shift.
var MC_CM2RU_SH = 3;                 # rz = sim_cm >>> 3   (1 render unit = 8 cm)
var MC_SEG      = 32;                # RENDER units per 256 cm segment (256 >>> 3)
                                     # ⚠ 32, not the old 60: 60 ru = 480 cm and 480 mod 256 = 224,
                                     #   so a slab boundary could never land on a segment boundary
var MC_SUB_PER_RU = 2048;            # 65536 / 32 — cam_ru = pos_sub >>> 11, giving 0..31

# ---- the tunnel bore, in render units (+y is DOWN) ------------------------------------------------
# ⚠ An arched section, not a box: flat floor, walls, chamfers, then a narrower ceiling. The chamfers
# are what read as an arch at speed and cost 2 quads a slab.
# ⭐⭐ WIDENED FOR THREE RAILS. A three-rail section puts the outer rail centres at +-22 render
# units. In the old 64 ru bore with a 34 ru derail threshold that placed a cart at 82% of the way to
# death BEFORE ANY PLAYER ERROR — simply being on an outer rail would have been permanently
# near-fatal, which is not difficulty, it is a bug wearing difficulty's clothes.
# ⚠ WIDENING THE BORE MOVES |D|, WHICH IS THE BOUND THAT TURNS A FRAME BLACK ON IRON. It is measured
# by --check, never estimated: the near-plane wall moves from 640 px to 840 px off centre, and the
# peak |D| that follows is reported by the gate. If that margin ever approaches 1x, this is the
# constant that did it.
var MC_TW       = 84;                # half-width          = 672 cm (13.4 m bore)
var MC_FLOOR_Y  = 72;                # floor below the eye = 576 cm
var MC_CEIL_Y   = 72;                # ceiling above the eye
var MC_ARCH_Y   = 36;                # springing line — where the wall stops and the chamfer starts
var MC_CEIL_HW  = 42;                # ceiling half-width; the chamfer closes MC_TW -> MC_CEIL_HW

# ---- the slab ladder ------------------------------------------------------------------------------
# ⭐ NEAR SLABS MUST BE SHORTER THAN FAR ONES. A uniform 32 ru walk makes the first slab 280 px tall
# on a 400 px screen and the last one 2 px — the near geometry is so coarse that a curve reads as a
# polygon. The 8/16/32/64 ladder drops the worst slab to 112 px for the same triangle budget.
# ⚠ 64 ru is the MAXIMUM far-slab length: at the design curve ceiling a single unsubdivided chord
# that long departs from the true arc by 5 px, and at 128 ru by 25 px.
var MC_LOD0 = 8;                     # render units per slab for rz in [32, 64)
var MC_LOD1 = 16;                    #                            rz in [64, 128)
var MC_LOD2 = 32;                    #                            rz in [128, 256)
var MC_LOD3 = 64;                    #                            rz in [256, 512)
var MC_SLAB_MAX = 24;                # endpoint array capacity; the ladder produces 17
# ⛔⛔ THE TRIANGLE BUDGET IS 256 PER RECORD AND A 3-TRACK FRAME BLEW THROUGH IT. Measured: 256 of
# 256 emitted with 16-30 triangles DROPPED, the cart among them — which is why the cart appeared on
# single-track frames and vanished on multi-track ones. Optional detail is therefore distance-gated:
# past these depths it is a few pixels tall and costs the same as it does up close.
var CFG_SIDE_RZ    = 112;            # side tracks are drawn nearer than this
var CFG_CHAMFER_RZ = 128;            # the arch chamfers are drawn nearer than this
var CFG_BEAM_RZ    = 128;            # beams
var CFG_PICKUP_RZ  = 112;            # treasure
# ⭐⭐ A RESERVE, NOT JUST A BUDGET. Distance gating alone is arithmetic that has to be redone every
# time anything is added — and it was already wrong once: the analytic worst case said 248 of 256
# while real play measured 256 of 256 with 1246 triangles dropped, because hazards and pickups were
# not in the sum. A reserve is a GUARANTEE instead of a calculation: optional detail refuses to emit
# unless this much room remains, so the cart cannot be the thing that gets dropped.
var CFG_TRI_RESERVE = 16;

# ---- the curve integral ----------------------------------------------------------------------------
# round(2*pi * 65536). Converts brads (65536 = one turn) into 16.16 radians.
var MC_TAU_Q16 = 411775;

# ---- the texture ---------------------------------------------------------------------------------------
# ⛔ POWER OF TWO ON BOTH AXES IS MANDATORY AND UNCONDITIONAL. tri_persp.s masks the interpolated
# coordinate with w-1 and h-1 on every fetch, so a non-power-of-two texture does not wrap — it reads
# the wrong texel and paints a plausible WRONG picture. The kernel rejects it (GPO_E_TEXDIM) rather
# than clamping, so 128 is the contract, not a preference.
# ⚠ These live here rather than in tex.cyr because geom.cyr bands its u coordinates against them and
# Cyrius is single-pass — geom is compiled before tex.
var MC_TEX      = 128;               # texels on each axis
var MC_TEXFULL  = 8388608;           # 128 << 16 — one full wrap, in 16.16 texels
# ⭐ ONE TEXTURE, TWO MATERIALS, BANDED ALONG u — AND THE OP FORCES THIS, IT IS NOT A CHOICE.
# op 0x0F REPLACES its entire rect, so two records over one rect do not layer: the second paints
# opaque black over everything the first drew. The whole frame must therefore be ONE record, and one
# record carries ONE texture. Left half is the floor (ballast, sleepers, rails), right half is rock.
var MC_TEX_HALF = 4194304;           # 64 << 16 — the u boundary between the two materials
# ⭐ THE FLOOR BAND IS SUBDIVIDED, and every quad must sample its OWN region. A quad that spanned the
# whole floor band picked up rail stripes: treasure rendered as fragments of rail, which is exactly
# what it looked like on screen.
# ⚠ 47, NOT 48. The floor quad's right edge samples u EXACTLY at this value, so ending it at 48
# landed on the ore swatch and painted an amber stripe down the right-hand side of the track.
var MC_TEX_FLOOR    = 3080192;       # 47 << 16 — end of the main floor band
var MC_TEX_ORE      = 3145728;       # 48 << 16 — the solid ore swatch, sampled as a CONSTANT
var MC_TEX_CAPDARK  = 3211264;       # 49 << 16 — the far cap's darkness, likewise constant
var MC_TEX_RAILPAIR = 3276800;       # 50 << 16 — start of the side-track rail-pair strip
var MC_TEX_CART     = 3080192;       # 47 << 16 — the cart's own plate, sampled as a CONSTANT

# ---- the draw rect's origin on screen ---------------------------------------------------------------------
# ⚠ BOTH MUST BE MULTIPLES OF 8 or the record is GPO_E_ALIGN. On an 800x600 console the exact centre
# is (80,100) and 100 is NOT a multiple of 8, which is why gpu.cyr masks these down rather than
# centring exactly. Set at runtime by mc_fbinfo().
var MC_DX = 0;
var MC_DY = 0;

# ⛔ NO BACKGROUND QUAD. op 0x0F fills its whole rect with bg before any triangle lands, so a
# full-screen quad to "clear" was always redundant. Named because the gate must skip it when
# measuring coverage — counting a full-screen quad would make an empty-tunnel frame look full.
var MC_BG_TRIS = 0;

# ---- ABI limits, reproduced so the game refuses what the kernel would ---------------------------------
# ⛔ A single bad record does not draw one bad triangle — it makes syscall(92) reject THE WHOLE BATCH.
var MC_TRI_MAX   = 256;              # per record; the kernel's GPU_TPER_LIST_MAX is 256
                                     # ⚠ RAISED FROM 128. The arched section emits 12 triangles a
                                     #   slab * 16 slabs = 192, which does not fit in 128.
                                     #   mc_vtx_a/b MUST be [2048] to match — see mc_bufs_ok().
var MC_W_MIN     = 256;
var MC_W_MAX     = 4096;
var MC_COORD_MAX = 268435456;        # 2^28 (i.e. +-4096 px in 16.16)
var MC_D_MAX     = 2147483647;       # 2^31-1
var MC_AREA_MIN  = 65536;
var MC_AREA_MAX  = 4398046511104;

# ---- speed ----------------------------------------------------------------------------------------
# ⭐ THE CART ALWAYS MOVES FORWARD. The player controls speed, lateral lean and their hands — never
# whether the descent continues. CFG_SPEED_MIN is what the brake bottoms out at, not a stop.
# Sub-units per tick at 60 Hz. 256 sub = 1 cm, so sub/tick * 60 / 256 = cm/s.
#   12208 sub/tick = 47.7 cm/tick = 28.6 m/s = 103 km/h   (the design plate's top speed)
#   11378 sub/tick =                26.7 m/s =  96 km/h   (the plate's REDLINE)
#    2844 sub/tick =                 6.7 m/s =  24 km/h   (brake floor)
# ⭐ 103 km/h IS EARNED, NOT GIVEN — and this is the cleanest reading of the design plate. The bar
# redlines at 96 and the run-summary reports a top speed of 103, so the last 7 km/h should be
# something the player DID rather than something the throttle hands them. The base cap is the
# redline; only a clean apex release pushes past it, and only while the bonus lasts.
var CFG_SPEED_MAX     = 12208;       # sub/tick — 103 km/h, the absolute ceiling (bonus included)
var CFG_SPEED_BASE    = 11378;       # sub/tick —  96 km/h, the cap WITHOUT an apex bonus
var CFG_SPEED_REDLINE = 11378;       # sub/tick —  96 km/h, where the HUD bar turns amber
var CFG_SPEED_MIN     = 2844;        # sub/tick —  24 km/h, the brake floor
var CFG_SPEED_START   = 5688;        # sub/tick —  48 km/h, speed at the chapter gate

# ⚠ Ramps are Q16.16 sub-units per tick, PER TICK. Released, the cart reaches top speed from the
# brake floor in about 4 s; braking bottoms out in about 1.5 s. The asymmetry is the point — braking
# is cheap and rebuilding speed is not, which is what makes an unnecessary brake cost real time.
var CFG_ACCEL = 2555904;             # Q16.16: 39.0 sub/tick per tick  (~4.0 s floor -> max)
var CFG_BRAKE = 6815744;             # Q16.16: 104.0 sub/tick per tick (~1.5 s max -> floor)

# ---- lean -------------------------------------------------------------------------------------------
# Lateral offset from the centre line, in Q16.16 RENDER UNITS (1 ru = 8 cm). The bore half-width is
# MC_TW = 64 ru, so the wall is 512 cm away.
# ⭐ THE MARGIN MUST BE FELT, NOT READ. There is no lean bar in the frame; what the player sees is the
# wall getting closer, because lean IS the camera's lateral offset. The warning levels below exist so
# sparks and wheel-lift can be hung off them later, not so a number can be displayed.
# ⚠ RAISED WITH THE TRACK SPREAD, NOT WITH THE BORE. The outer track centre sits at 44 ru, so a
# threshold of 48 would have put a cart at 92% of the way to death just for riding an outer rail.
# 72 ru puts it at 61%. ⭐ THE BORE DID NOT NEED TO MOVE: peak |D| comes from the near-plane WALLS,
# not from the tracks, so spreading the tracks inside the existing bore costs nothing on the one
# bound that turns a frame black.
var CFG_LEAN_THRESH  = 4718592;      # Q16.16 = 72 ru = 576 cm — past here, the derail clock runs
var CFG_LEAN_MAX     = 5242880;      # Q16.16 = 80 ru = 640 cm — hard clamp, just inside the bore
var CFG_DERAIL_TICKS = 24;           # consecutive ticks past the threshold before the cart is lost
                                     # ⚠ 24 ticks = 0.4 s. Long enough to be a warning, short enough
                                     #   that losing the rail at speed is not survivable by waiting.

# ⚠⚠ THESE SCALE WITH CFG_LEAN_THRESH AND MUST BE RE-DERIVED WHENEVER THE BORE CHANGES.
# Widening the bore for three rails moved the threshold 34 -> 48 ru: the distance to failure grew by
# 41% while every acceleration stayed put, and the game went from "hands off derails every 7 s" to
# "hands off never derails at all, worst lean 7 of 48". Difficulty is TIME to the threshold, not the
# threshold, so the accelerations were scaled by the same 48/34 to preserve it.
# ⚠ THE CENTRIFUGAL TERM IS THE WHOLE DIFFICULTY CURVE: force = curve * speed^2. Squaring speed is
# what makes the brake a real decision rather than a penalty — at half speed a curve pushes a QUARTER
# as hard, so braking into a bend buys far more control than the time it costs.
# Calibrated so that at the design curve ceiling (1024 brads/seg) and full speed, a player doing
# NOTHING drifts from centre to the derail threshold in about 2 seconds.
var CFG_LEAN_FORCE  = 8145;          # Q16.16 ru/tick^2 at curve 1024 and full speed
# ⛔⛔ PLAYER AUTHORITY MUST LOSE TO A SLIP, OR LOSING THE RAIL IS DECORATION.
# At 7200 the player simply out-pushed a full slip by holding a key, and a run could slip for 280
# ticks without ever being in danger. Sized against the actual forces instead:
#   gripping, gentle bend, full speed   1440 outward  -> steering holds comfortably
#   gripping, hard bend, 75% speed      2160 outward  -> steering holds
#   SLIPPING, mid bend, full speed      3760 outward  -> steering LOSES; shed speed or go wide
#   SLIPPING, hard bend, full speed     5680 outward  -> steering loses badly
# ⇒ Steering is how you place the cart on the rail. The brake is the only thing that reaches a slip.
var CFG_LEAN_INPUT  = 6780;          # Q16.16 ru/tick^2 of counter-lean authority
var CFG_LEAN_DAMP   = 60293;         # Q16.16 = 0.92 — velocity retained per tick
var CFG_LEAN_SPRING = 24;            # Q16.16 ru/tick^2 per ru — the rail's self-centring WHILE IT GRIPS

# ---- ⭐⭐ GRIP: THE RAIL HOLDS YOU UNTIL IT CANNOT, AND THAT IS THE WHOLE DIFFICULTY -------------
# A wheel flange has a finite lateral capacity. Below it the rail simply holds the cart on line and
# the player has nothing to do; above it the flange lets go and the cart runs wide. That threshold —
# not a bar, not a timer — is the game.
#
# ⛔ AND THE CAPACITY FALLS WITH SPEED, WHICH IS WHAT MAKES THE BRAKE NECESSARY RATHER THAN MERELY
# REWARDED. Lateral force rises as speed SQUARED while grip falls LINEARLY, so the gap opens fast:
#
#      lateral force (Q16.16 ru/tick^2)          grip
#                  c=384  c=768  c=1024
#   full speed      1440   2880    3840          2000   <- anything past ~530 curve LETS GO
#   75% speed        810   1620    2160          2600   <- the hardest bend in the game, held
#   half speed       360    720     960          3200   <- nothing can break it
#
# ⇒ Entering a hard bend at the redline throws the cart off the rail. Braking to three-quarters holds
#   it. That is the entire risk/reward loop, and it needs no bonus to motivate it.
var CFG_GRIP_MAX  = 8055;            # Q16.16 ru/tick^2 the flange holds at a standstill
var CFG_GRIP_FADE = 4665;            # ...of which this much is lost by the speed cap
var CFG_GRIP_MIN  = 2550;            # floor, so grip never reaches zero and the cart is never doomed
# ⚠ Once grip breaks, the EXCESS force accelerates the cart outward AND the self-centring stops.
# Both at once is what makes a slip feel like losing the rail rather than like drifting wide.
# ⛔ 1.0x WAS FAR TOO GENTLE AND THE TELEMETRY SAID SO: a run slipped for 165 CONSECUTIVE ticks and
# reached 10 ru of a 34 ru threshold. The rail had let go and nothing happened. Just past the grip
# limit the excess is by definition tiny, so scaling it 1:1 means a slip starts imperceptibly and
# stays that way. 3x makes losing the rail escalate instead of merely register.
var CFG_SLIP_GAIN = 196608;          # Q16.16 = 3.0x the excess, applied as outward acceleration

# ---- ⭐⭐ DUCK AND JUMP -------------------------------------------------------------------------
# ⛔ THE JUMP'S SPEED THRESHOLD IS THE CENTRAL TENSION WITH THE BRAKE AND MUST NOT BE SOFTENED.
# Hang time is FIXED, so distance covered is simply speed x time — faster carts jump further, with no
# special case anywhere. A 3-segment gap against a 26-tick hang gives:
#      100% speed  clears 4.84 segments   CLEARS
#       75% speed  clears 3.63 segments   CLEARS
#       67% speed  clears 3.24 segments   just clears
#       60% speed  clears 2.91 segments   COMES UP SHORT
#       50% speed  clears 2.42 segments   comes up short
# ⇒ The brake keeps you on the rail through bends and drops you into holes. That is the decision the
#   whole game is built around, and the threshold lands at ~62% of the cap exactly as designed.
var CFG_JUMP_TICKS = 26;             # airborne ticks (0.43 s) — FIXED, so distance = speed x time
var CFG_GAP_SEGS   = 3;              # gap width in segments (7.68 m)

# ⚠ THE CROUCH CANNOT BE CANCELLED, AND THAT IS THE COST OF USING IT. 27 ticks is 0.45 s of
# committed vulnerability — you cannot whip, and you cannot stand up early to jump. Ducking a beam
# just before a gap is therefore a real mistake rather than a free action.
var CFG_CROUCH_TICKS = 27;

# ---- integrity ------------------------------------------------------------------------------------
# ⭐ SIX BLOCKS, matching the design plate's CART INTEGRITY row. A beam to the head is survivable;
# falling into a gap or losing the rail is not. Graded damage makes a run recoverable and a mistake
# memorable; instant death on everything makes the game a memory test.
var CFG_INTEGRITY_MAX  = 6;
var CFG_BEAM_DAMAGE    = 2;          # a low beam at speed costs a third of the cart

# ---- hazard placement -------------------------------------------------------------------------------
# ⚠ Spacing is in SEGMENTS, and a segment is ~7.7 ticks at the cap. The brief asks for stacked pairs
# at ~18-tick spacing to force jump->duck chains: 2 segments is ~15 ticks, which is that.
var CFG_HAZ_GAP_MIN   = 14;          # segments between hazards, minimum
var CFG_HAZ_GAP_MAX   = 34;          # ...and maximum
var CFG_HAZ_PAIR_PCT  = 30;          # percent of hazards followed by a stacked partner
# ⛔⛔ THE PAIR MUST BE SPACED WIDER THAN THE LONGER COMMITMENT, OR THE CHAIN IS IMPOSSIBLE RATHER
# THAN HARD. A jump locks the player for 26 ticks and a crouch for 27 — about 5 segments at the cap.
# At the brief's suggested 2-segment spacing the second hazard arrives on tick 10 of a 27-tick
# crouch, when no input can reach it: duck the beam, fall in the gap, every time, with correct play.
# The autopilot proved it — 1 jump in 517 ticks and a death in a gap it was never able to answer.
# ⇒ 6 segments puts the second hazard at ~tick 32, after both commitments have expired. The chain is
#   now a real jump->land->duck sequence, which is what the brief actually wanted.
var CFG_HAZ_PAIR_SEGS = 6;           # segments between the two halves of a stacked pair
var CFG_HAZ_NONE_SEGS = 10;          # no hazard within this many segments of the chapter gate
# ⛔⛔ GAPS NEED A LONGER RUN-UP THAN BEAMS, AND THE FIRST BUILD GOT THIS WRONG IN A WAY THAT MADE THE
# GAME UNWINNABLE. The cart leaves the gate at 46% of the cap and a 3-segment gap needs 62% — so a
# gap at segment 10 cannot be cleared by ANY input. Both pilots died there, at 28 m, every single run.
# The jump threshold was working exactly as designed; the placement was asking the impossible.
# ⚠ 5 segments is where jump speed arrives; 26 leaves real margin and, better, means the mine
# introduces its verbs in order — beams first, gaps only once the cart is up to speed.
var CFG_GAP_NONE_SEGS = 26;          # no GAP within this many segments of the chapter gate

# ---- pickups ---------------------------------------------------------------------------------------
# ⭐ COLLECTION IS A LATERAL-POSITION TEST AT THE SEGMENT CROSSING, NOT A COLLISION VOLUME. There is
# no bounding box and no sweep — the cart either was in the right place when it crossed the segment or
# it was not. That is cheap, exact, and impossible to tunnel through at any speed.
var CFG_PICKUP_PCT   = 22;           # percent of non-hazard segments carrying treasure
var CFG_PICKUP_REACH = 20;           # render units either side that counts as a grab (160 cm)
var CFG_PICKUP_LANES = 3;            # left / centre / right
var CFG_PICKUP_LANE_RU = 44;         # lateral offset of the outer lanes, render units
                                     # ⚠ EQUAL TO CFG_RAIL_SEP on purpose: a pickup lane IS a rail on
                                     #   a multi-rail section, so the two must not drift apart.

# ---- rails ------------------------------------------------------------------------------------------
# ⭐ THREE RAILS SIDE BY SIDE, hopped between with jump + a direction. The outer centres sit at 45% of
# the derail threshold, so riding an outer rail is a real commitment without being a slow death.
# ⚠ SEPARATION AND GAUGE ARE CONSTRAINED FROM BOTH SIDES AND THE BAND IS NARROW.
# From below: separation must exceed twice the gauge or adjacent tracks overlap.
# From above: the outer track centre must stay well under CFG_LEAN_THRESH, because lean is measured
#   from the TUNNEL CENTRE — so simply riding an outer rail already spends part of the derail budget.
#     gauge 8  sep 22 -> tracks span +-30, outer at 45% of threshold   (thin; looked like one rail)
#     gauge 13 sep 28 -> tracks span +-41, outer at 58%                <- chosen
#     gauge 16 sep 36 -> tracks span +-52, outer at 75%                (too close to death)
# ⇒ Three tracks occupy the middle half of the bore with ballast either side. That is a marshalling
#   chamber rather than a corridor, and it is the widest layout the absolute-lean model allows.
# ⭐⭐ THE CART IS THE SOURCE OF TRUTH FOR SCALE, AND EVERYTHING BELOW IS DERIVED FROM IT.
# The gauge and the track separation used to be two numbers picked by eye, which is exactly why they
# did not relate to each other or to anything the player sees. A track exists to carry a cart, so:
#     gauge      = the cart's width          (the rails run under its wheels)
#     separation = the cart's width + clearance  (two carts must pass without touching)
# ⚠ This is a HAULER, not a hand-pushed ore car. A real narrow-gauge mine car is 1.2-1.6 m on a
# 600-900 mm gauge; this one carries a core crate at 100 km/h through a 13.4 m bore and has to READ
# at that speed, so it is scaled to a heavy-haul vehicle at 2.88 m.
var CFG_CART_HW    = 18;             # cart half-width, render units — 2.88 m wide cart
var CFG_CART_H     = 22;             # cart body height above the rail head
# ⛔ THE CART CANNOT BE DRAWN AT THE NEAR PLANE, AND THE ARITHMETIC SAYS SO PLAINLY. The floor sits
# 72 ru below the eye, so at rz = MC_ZN (32) it projects to y = 920 on a 400 px screen — the near
# plane is entirely BELOW the view. The floor only enters frame at rz ~115.
#     rz  32 -> base y 920  OFF BOTTOM
#     rz 110 -> base y 409  OFF BOTTOM (just)
#     rz 124 -> base y 385  visible, 92 px wide
# ⚠ So the cart rides 124 ru (9.9 m) ahead of the camera. That is a chase distance, not a defect —
# the camera is a drone behind the cart, which is what the design plate's "CART REAR" view is.
var CFG_CART_RZ    = 124;            # render units ahead of the camera the cart is drawn at
var CFG_RAIL_CLEAR = 8;              # clearance between adjacent carts, render units (64 cm)
var CFG_RAIL_SEP   = 44;             # = 2*CFG_CART_HW + CFG_RAIL_CLEAR. 3.52 m centre-to-centre.
                                     # ⚠ 3 tracks then span +-62 of the +-84 bore, leaving 22 ru of
                                     #   ballast each side — a chamber with room, not a corridor.
var CFG_RAILS_MAX  = 3;              # -1 = left, 0 = centre, +1 = right
# ⚠ Half the gauge, in render units. 8 ru = 128 cm between the rails — a real mine gauge, and narrow
# enough that three tracks at 22 ru spacing leave a visible 6 ru of ballast between them.
var CFG_TRACK_HW   = 18;             # = CFG_CART_HW. The rails run under the wheels.

# ---- branch reconvergence -----------------------------------------------------------------------------
# ⛔ SPECIFIED IN SEGMENTS, NOT TICKS, AND THE BRIEF'S TICK FIGURE CANNOT BE HONOURED AS WRITTEN.
# The brief asks for reconvergence within 900-1800 ticks. The same stretch of track is 899-1797 ticks
# at the redline and 3595-7190 at the brake floor — so a tick bound is not a property the generator
# can guarantee, because it depends on how the player drives. Segments are, and 156-312 segments is
# exactly the intended figure at speed.
var CFG_BRANCH_MIN_SEGS = 156;       # 399 m — 900 ticks at the redline
var CFG_BRANCH_MAX_SEGS = 312;       # 799 m — 1800 ticks at the redline
var CFG_BRANCH_NECK     = 20;        # sterile segments after the fork mouth (max renderer reach is 16)
var CFG_BRANCH_TAIL     = 24;        # segments over which the branch ramps back to the trunk's values
var CFG_TREASURE_SCORE = 100;        # score per treasure

# ---- the apex bonus -----------------------------------------------------------------------------------
# ⭐ THE OPTIMAL LINE MUST BE RHYTHMIC, NOT HELD-BRAKE. Braking into a bend and releasing at the apex
# pays a speed bonus; sitting on the brake through the whole curve does not. Without this the safest
# play is also the slowest, and the game becomes a test of patience.
var CFG_APEX_MIN_CURVE = 192;        # brads/seg below which a bend is too gentle to score
var CFG_APEX_BONUS     = 1200;       # sub/tick granted on a clean apex release
var CFG_APEX_DECAY     = 24;         # sub/tick the bonus sheds each tick

# ---- audio ------------------------------------------------------------------------------------------
# ⭐ THE RAIL-JOINT CLICK RATE IS THE MOST IMPORTANT AUDIO TUNABLE IN THE GAME. It is what makes
# speed AUDIBLE — the player hears the rail ticking past faster before they read any gauge. One click
# per 256 cm segment: 2.6 a second at the 24 km/h floor, 10.4 a second at the 96 km/h redline.
# ⛔ These are the numbers, derived rather than guessed: clicks/s = (m/s) / 2.56, and the phase
# accumulator wraps at 65536*8, so increment = clicks/s / 48000 * 524288.
# An earlier guess put this at 934 clicks/second, which is not a rail joint — it is a 934 Hz buzz.
var CFG_JOINT_BASE = 28;             # phase increment per sample at the brake floor  (2.6 clicks/s)
var CFG_JOINT_SPAN = 86;             # ...plus this much at the cap                  (10.4 clicks/s)
# ⚠ CLICK LENGTH IS AS IMPORTANT AS CLICK RATE. Decay is applied per SAMPLE at 48 kHz, so a factor
# that looks gentle is brutally fast: 0.55/sample decays to nothing in 0.16 ms, which is a tick you
# cannot hear rather than a rail joint you can. 0.985 gives ~6.4 ms — a short wooden clack.
var CFG_JOINT_DECAY_N = 985;         # numerator of the per-sample envelope decay
var CFG_JOINT_DECAY_D = 1000;

# ---- input bits -----------------------------------------------------------------------------------------
# ⭐ THE SIM SEES ONLY THIS WORD. Not the keyboard, not scancodes, not a device — one bitfield per
# tick. That is the determinism boundary: record the words and the whole run replays exactly, and it
# is why the replay test in step 11 is cheap rather than a rewrite.
var IN_LEFT  = 1;
var IN_RIGHT = 2;
var IN_BRAKE = 4;
var IN_JUMP  = 8;
var IN_DUCK  = 16;
var IN_WHIP  = 32;
var IN_QUIT  = 64;
# ⭐⭐ SWITCH IS A DOUBLE-TAP, AND THAT IS WHAT LETS LEAN KEEP THE SAME KEYS.
# Leaning is a HOLD — a sustained counterweight against the bend. Switching is an INTENT, expressed
# once. Those are different shapes of input, so they can share a key without ambiguity: hold to lean,
# tap-tap to switch. No modifier is stolen (SHIFT is the brake), nothing is overloaded by context,
# and the player never has to know which mode they are in.
# ⚠ The first tap of a double-tap DOES still lean, briefly. That is correct rather than a compromise:
# flicking the cart toward the branch you are taking is what you would do anyway.
var IN_SW_LEFT  = 128;
var IN_SW_RIGHT = 256;
# ⚠ HOP is jump + a direction: the cart leaves the rail and comes down on the neighbouring one. It is
# distinct from a fork (which changes which track EXISTS ahead) — a hop moves between rails that are
# both already there. Reserved here so the input word's shape is settled before the world model is.
var IN_HOP_LEFT  = 512;
var IN_HOP_RIGHT = 1024;

# ⚠ 20 ticks = 0.33 s. Long enough that a deliberate double-tap is comfortable, short enough that two
# separate lean corrections a third of a second apart are not mistaken for one.
var CFG_DTAP_TICKS = 20;

# ---- the chapter --------------------------------------------------------------------------------
# ⭐ ONE SEED PER CHAPTER, AND DEATH REPLAYS IT EXACTLY. The player is meant to learn a specific
# stretch of track, so a death must return them to the same track — not to a fresh sample from the
# same distribution. The seed is mixed with the chapter index rather than re-derived, so chapter 3
# of seed 7714 is always the same 245 m of mine.
var CFG_SEED_DEFAULT = 7714;         # "SEED 7714-KV" on the title card
