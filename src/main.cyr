# cyrius-mine-cart — a ride through a curving mine tunnel, rasterised by the GPU.
#
# ⭐ WHAT THIS PROGRAM IS FOR. The AGNOS kernel grew perspective-correct textured triangle
# rasterisation on real AMD silicon (#92 op 0x0F) across a long ladder of rungs, every one of
# which closed on a proof binary rather than on something a person could look at. This is the
# first application to actually draw with it: a real texture, a real camera, a real frame, on
# screen. Nothing here is a test harness. `--check` exists so the burn is not wasted, but the
# default mode is the game.
#
# Modes (`--help` prints them):
#   (default)   ride the tunnel and present it FULLSCREEN — 900 frames unless --frames says otherwise
#   --check     the host gate (src/gate.cyr): emit frames and re-validate every record the kernel would
#               see. Runs anywhere, needs no GPU, and is the thing that stops a black-screen burn.
#   --verify    one frame, GPU vs the CPU reference, byte-compared — the on-iron image check
#   --sim       the simulation headless, with telemetry — the tuning instrument
#   --wav       20 s of the mix to /tmp/deepvein.wav, so a person can listen to it
#   --record F  ride (or --sim) and write every input word to F
#   --replay F  re-run a recorded ride headless; exit 95 only if it reproduced exactly
#   --frames N  bound the ride or the --sim run (0 = ride until ESC)
#   --pilot N   0 = hands off, 1 = the reference autopilot (--sim, --wav)
#   --trace     report every dropped triangle, for diagnosis
#
# ⛔ WHY THERE IS NO WINDOWED MODE, precisely. aethersafha runs on agnos and composites its own
# surface on the GPU, and setu asks the kernel for a client's pixel buffer as a #86 carveout slot,
# so a client's PIXELS are GPU-visible memory.
#
# ⛔ CORRECTED 2026-08-03 — this comment used to add that aethersafha "grants windows" and that "the
# client→compositor transport is already GPU-visible memory ... the transport is not the problem."
# That was FALSE, but so is the blunter correction that first replaced it. The accurate statement:
# **the client↔compositor transport on agnos is being REPLACED.** setu's control channel rode TCP on
# loopback:7700, retired 2026-08-03 as the WRONG PRIMITIVE for a local display protocol — nothing to
# route, nothing to checksum, no business owning a port — with the agnos socket (`anu`) as the
# replacement (agnos `docs/development/planning/ipc.md` §9/§10). It is NOT retired for being broken:
# before agnos 1.56.34 / `net_src_for` it could not complete a handshake on an ordinary boot (every
# outbound segment claimed `net_ip` as its source), but after `net_src_for` it DID connect un-rigged
# — `aethersafha-clients-test.py` reached "connected: 2, presented: 2" on 2026-08-02 (QEMU `-smp 1`
# only; never iron, `-smp 4` fault-kills). The greens that came from the `AETHERSAFHA_SETU_SELFTEST`
# kernel hook assigning `net_ip = 0x7F000001` remain FALSE GREENS; hook and smokes are DELETED.
# ⭐ SETTLED 2026-08-07 (agnos ipc.md §9.6, bites 6-9). The replacement is the kernel CHANNEL band,
# `#97 chan_op` (`anu` was only a candidate name). setu 0.8.0 speaks it on agnos with its TCP arm
# deleted, aethersafha mints and endows one channel per client ("presented: 2" under `-smp 4`), and
# puka presents a composited window. So the transport is no longer a reason there is no windowed
# mode. The GPU-addressing reason below is the only one, and it is the durable one.
#
# The problem is that **no GPU op that writes colour lets the caller name where the colour goes.**
# gpu_tri_persp derives its destination from two kernel module globals (gpu_bb_a_mc / gpu_bb_b_mc,
# agnos kernel/core/gpu.cyr:1543-1545) and the record ABI has no field to override it —
# gpo_field_mask(0x0F) is 0x00FF, dwords 0-7 only, and the validator's reserved sweep rejects
# anything else. So a GPU draw lands in the SAME shared back buffer the compositor stages into
# between its deferred #39 and its #84 flip, and #92 carries no process identity to arbitrate.
# ⇒ A GPU-rendering client today can own the whole frame or corrupt someone else's. Fullscreen is
# the correct target, not a compromise.
#
# ⭐ The fix is already shipped for DEPTH: gpu_tri_depth writes Z to a ring-3-named handle
# (gpu_rt_handle_mc) while writing colour to the back buffer, in the same dispatch. Colour needs
# the same treatment; see agnos gpu.md's follow-on row.

include "lib/io.cyr"
include "src/say.cyr"
# ⚠ fx BEFORE geom: geom's curve integration is built on fx_mul/fx_sin, and Cyrius is single-pass —
# a function must be defined before the line that calls it. fxtest needs say.cyr's ps/pn/nl.
include "src/fx.cyr"
include "src/fxtest.cyr"
include "src/config.cyr"
include "src/track.cyr"
include "src/tracktest.cyr"
include "src/input.cyr"
include "src/cart.cyr"
include "src/carttest.cyr"
include "src/audio.cyr"
include "src/audiotest.cyr"
include "src/wav.cyr"
include "src/emit.cyr"
include "src/hud.cyr"
include "src/geom.cyr"
include "src/tex.cyr"
include "src/refcore.cyr"
include "src/replay.cyr"
include "src/check.cyr"
include "src/gpu.cyr"
include "src/gate.cyr"

# ---- frame pacing ------------------------------------------------------------------------------
# ⛔⛔ NEVER SPIN ON THE CLOCK ON AGNOS. A foreground exec runs ring-3 with interrupts DISABLED, so a
# busy-wait like `while (clock() < deadline) { }` does not merely burn CPU — on the #40 clock the
# value it is waiting on cannot move, and the machine hangs forever with no diagnostic. sleep_ms(#41)
# is what opens a kernel `sti` window, which is why pacing goes through it.
#
# ⛔⛔ AND THE CLOCK IS #95, NOT #40. THIS COST NOTHING ONLY BECAUSE THE KERNEL SAYS SO OUT LOUD.
# uptime_ms #40 reads `timer_ticks`, and a FOREGROUND `run` program executes with IF cleared, so the
# timer never fires and #40 is FROZEN FOR THE WHOLE RUN — agnos kernel/core/syscall.cyr:7440 states
# it plainly: "Any `run`-launched program timing itself with #40 measures zero." It advances only
# inside the brief sti window sleep_ms itself opens, which makes it a clock that moves only when you
# are already asleep: 10 ms granularity against a 16.67 ms frame, and self-referential to boot.
# ⇒ uptime_us #95 reads rdtsc, needs no interrupts, and is MICROSECONDS. The kernel calls it "the
#   only correct clock on that path".
# ⚠ #95 RETURNS -1 WHEN CALIBRATION WAS REFUSED, DELIBERATELY RATHER THAN A PLAUSIBLE ZERO — the
#   kernel notes that a tool which cannot tell "no clock" from "0 us elapsed" already burned two
#   flashes. So -1 is handled as "do not pace" rather than arithmetic'd into a huge sleep.
#
# ⚠ The SIM is unaffected by any of this: it is a fixed 60 Hz step that reads no clock at all, so a
# late frame renders late and simulates identically. Rendering may drop frames; the sim never does.
var mc_deadline_us = 0;
var mc_clock_ok    = 1;        # 0 once #95 has reported it has no calibrated clock

#ifdef CYRIUS_TARGET_AGNOS
fn mc_pace(): i64 {
    if (mc_clock_ok == 0) { return 0; }
    var now = syscall(95);                        # uptime_us — rdtsc, valid with IF=0
    if (now < 0) { mc_clock_ok = 0; return 0; }   # calibration refused; run unpaced rather than wrong
    if (mc_deadline_us == 0) { mc_deadline_us = now; }
    mc_deadline_us = mc_deadline_us + 1000000 / CFG_TICK_HZ;
    var rem = mc_deadline_us - now;
    # ⚠ if we fell behind, do NOT sleep and do NOT catch up by running extra sim steps — resync the
    # deadline instead. A catch-up loop turns one slow frame into a spiral.
    if (rem <= 0) { mc_deadline_us = now; return 0; }
    if (rem > 100000) { rem = 100000; }
    # ⚠ sleep_ms rounds UP to whole 10 ms ticks, so a sub-10 ms remainder would sleep a whole tick and
    # overshoot the frame. Below that, spend the remainder rather than oversleep it — the deadline is
    # absolute, so the next frame simply has less to wait for.
    var rem_ms = rem / 1000;
    if (rem_ms > 0) { syscall(41, rem_ms); }
    return rem;
}
#else
fn mc_pace(): i64 { return 0; }
#endif

# ---- ⭐ --sim: THE TUNING INSTRUMENT ------------------------------------------------------------
# Runs the simulation headless, with no GPU and no keyboard, and prints what the cart actually did.
# This exists because step 4's whole question — "is it fun with nothing else in it?" — cannot be
# answered from a passing test suite, and on a host with no AGNOS there is otherwise no way to see
# the numbers move at all.
#
# Two scripted drivers, because the interesting question is the GAP between them:
#   pilot 0  hands off the controls entirely — how long does an unattended cart survive?
#   pilot 1  a crude autopilot that counter-leans and brakes into bends — what does competence buy?
# If those two produce similar depths, the track is not demanding enough. If pilot 0 dies instantly,
# it is too demanding. The distance between them IS the difficulty.
# ⚠ ACCUMULATE ACROSS DEATHS. cart_reset zeroes the per-run counters, so reading them at the end
# reports only the LAST life — which for a pilot that dies often is a short, unrepresentative one.
# The drop counters made this mistake first; --sim then made it again for everything except slip,
# and the summary line reported one life's score as if it were the run's. Each life is banked here
# the moment it ends, and once more for the life still in progress when the run stops.
var mcs_lives   = 0;
var mcs_score   = 0;
var mcs_treas   = 0;
var mcs_jumps   = 0;
var mcs_ducks   = 0;
var mcs_hits    = 0;
var mcs_derail  = 0;
var mcs_falls   = 0;
var mcs_wrecked = 0;

# bank the life that just ended (or is still running) into the --sim totals
fn mc_sim_bank(): i64 {
    mcs_lives = mcs_lives + 1;
    mcs_score = mcs_score + cart_score;
    mcs_treas = mcs_treas + cart_treasure;
    mcs_jumps = mcs_jumps + cart_jumps;
    mcs_ducks = mcs_ducks + cart_ducks;
    mcs_hits  = mcs_hits  + cart_hits;
    if (cart_dead == 1) {
        if (cart_death == 1) { mcs_derail  = mcs_derail  + 1; }
        if (cart_death == 2) { mcs_falls   = mcs_falls   + 1; }
        if (cart_death == 3) { mcs_wrecked = mcs_wrecked + 1; }
    }
    return 0;
}

# --sim: ride headless for `ticks` and print what the cart did; optionally record it
fn mc_sim(ticks, pilot, record): i64 {
    fx_sin_init();
    mc_tex_init();
    cart_reset(CFG_SEED_DEFAULT, 0);
    if (record != 0) {
        if (rp_begin(CFG_SEED_DEFAULT, 0) != 1) { ps("mine-cart: cannot allocate the input log"); nl(); return 1; }
    }
    # ⛔ ZERO TICKS IS A RUN WITH NOTHING TO REPORT, AND THE SUMMARY DIVIDES BY IT. `--sim --frames 0`
    # used to reach `(slip_total * 100) / ticks` and die of SIGFPE with no message at all.
    if (ticks <= 0) { ps("mine-cart: SIM needs --frames > 0"); nl(); return 2; }

    ps("mine-cart: SIM pilot "); pn(pilot); ps(", "); pn(ticks); ps(" ticks at ");
    pn(CFG_TICK_HZ); ps(" Hz ("); pn(ticks / CFG_TICK_HZ); ps(" s)"); nl();
    ps("    tick   depth  km/h    lean  warn  int  score  jump  duck  slip"); nl();

    var deepest = 0;
    var top     = 0;
    var apex0   = cart_apex_hits;              # a SESSION total (see cart.cyr): report the difference
    # ⛔ SLIP IS COUNTED ONCE, HERE, PER TICK. It used to be counted here AND again at every death by
    # adding that life's cart_slip_ticks — so every slipping tick of a life that ended was reported
    # twice, and the difficulty number this instrument exists to produce was inflated by exactly
    # the lives that mattered most.
    var slip_total = 0;
    var max_lean   = 0;
    var max_curve  = 0;
    var max_slip_run = 0;
    var cur_slip_run = 0;
    # ⭐ THE FORKS: which way each was taken, and how long the run spent on the wet shaft
    var fk_wet  = 0;
    var fk_spur = 0;
    var wet_ticks = 0;
    var wet_slip  = 0;
    var t = 0;
    while (t < ticks) {
        var word = 0;
        if (pilot == 1) { word = cart_autopilot(); }

        if (cart_slip == 1) { slip_total = slip_total + 1; cur_slip_run = cur_slip_run + 1; }
        if (cart_slip == 0) { if (cur_slip_run > max_slip_run) { max_slip_run = cur_slip_run; } cur_slip_run = 0; }
        if (fx_abs(cart_lean) > max_lean) { max_lean = fx_abs(cart_lean); }
        var cvn = 0;
        if (trk_live(trk_abs_seg) == 1) { cvn = fx_abs(trk_curve_at(trk_abs_seg)); }
        if (cvn > max_curve) { max_curve = cvn; }
        if (trk_live(trk_abs_seg) == 1) {
            if (trk_wet_at(trk_abs_seg) == 1) {
                wet_ticks = wet_ticks + 1;
                if (cart_slip == 1) { wet_slip = wet_slip + 1; }
            }
        }
        var was_pending = trk_fork_pending();
        if (cart_tick(word) == 0) {
            ps("    DIED at "); pn(trk_depth_m()); ps(" m after "); pn(cart_ticks);
            ps(" ticks ("); pn(cart_ticks / CFG_TICK_HZ); ps(" s) -- "); ps(mc_death_name());
            if (cart_death == 1) { if (cart_slip == 1) { ps(" (lost the rail)"); } }
            nl();
            if (trk_depth_m() > deepest) { deepest = trk_depth_m(); }
            mc_sim_bank();
            cart_reset(cart_seed, cart_chapter);
        }
        # a fork that was open before this tick and is final after it was just taken
        if (was_pending == 1) {
            if (trk_fork_lock == 1) {
                if (trk_fork_side < 0) { fk_wet = fk_wet + 1; }
                if (trk_fork_side > 0) { fk_spur = fk_spur + 1; }
                ps("    FORK at "); pn(trk_depth_m()); ps(" m -- took the ");
                if (trk_fork_side < 0) { ps("WET SHAFT (x2, slick)"); }
                if (trk_fork_side > 0) { ps("SERVICE SPUR"); }
                nl();
            }
        }
        rp_note(word);

        if (trk_depth_m() > deepest) { deepest = trk_depth_m(); }
        if (cart_kmh() > top) { top = cart_kmh(); }

        if ((t % 60) == 0) {
            ps("  "); pn(t);
            ps("\t"); pn(trk_depth_m());
            ps("\t"); pn(cart_kmh());
            ps("\t"); pn(cart_lean >>> 16);
            ps("\t"); pn(cart_warn());
            ps("\t"); pn(cart_derail);
            ps("\t"); pn(cart_apex_hits);
            ps("\t"); pn(cart_integrity);
            ps("\t"); pn(cart_score);
            ps("\t"); pn(cart_jumps);
            ps("\t"); pn(cart_ducks);
            ps("\t"); pn(cart_slip);
            nl();
        }
        t = t + 1;
    }

    mc_sim_bank();                                 # the life still riding when the run stopped

    nl();
    ps("  "); pn(mcs_lives); ps(" li"); if (mcs_lives == 1) { ps("fe"); } if (mcs_lives != 1) { ps("ves"); }
    ps(": "); pn(mcs_derail); ps(" derailed, "); pn(mcs_falls); ps(" fell in a gap, ");
    pn(mcs_wrecked); ps(" wrecked"); nl();
    ps("  deepest "); pn(deepest); ps(" m, top speed "); pn(top); ps(" km/h, ");
    pn(cart_apex_hits - apex0); ps(" clean apexes"); nl();
    ps("  across all lives: score "); pn(mcs_score); ps(", "); pn(mcs_treas); ps(" treasure, ");
    pn(mcs_jumps); ps(" jumps, "); pn(mcs_ducks); ps(" ducks, ");
    pn(mcs_hits); ps(" beams taken"); nl();
    # ⭐ SLIP IS THE NUMBER THAT SAYS WHETHER THE DIFFICULTY MECHANIC IS ACTUALLY ENGAGING. A run
    # with zero slip ticks never once lost the rail, whatever else it reports.
    ps("  slipping for "); pn(slip_total); ps(" of "); pn(ticks);
    ps(" ticks ("); pn((slip_total * 100) / ticks); ps("%), longest unbroken slip ");
    pn(max_slip_run); ps(" ticks"); nl();
    ps("  worst lean "); pn(max_lean >>> 16); ps(" ru of "); pn(CFG_LEAN_THRESH >>> 16);
    ps(" threshold, hardest curve met "); pn(max_curve); ps(" of "); pn(CFG_CURVE_MAX); nl();
    ps("  forks taken: "); pn(fk_wet); ps(" wet shaft, "); pn(fk_spur); ps(" service spur; on the wet shaft for ");
    pn(wet_ticks); ps(" ticks, slipping for "); pn(wet_slip); ps(" of them"); nl();
    ps("  the generator produced "); pn(trk_gen_count); ps(" segments, ABI curve clamp fired ");
    pn(trk_clamp_hits); ps(" times"); nl();
    if (rp_on == 1) {
        mc_build(cart_cam_x());                    # the final frame, which the log fingerprints
        var len = rp_end();
        if (file_write_all(record, rp_buf, len) != len) {
            ps("mine-cart: could NOT write the input log to "); ps(record); nl();
            return 1;
        }
        ps("  input log: "); pn(rp_ticks); ps(" ticks to "); ps(record); ps(", state hash ");
        pn(rp_hash); ps(", frame hash "); pn(rp_frame_hash()); nl();
    }
    return 0;
}

# ---- the ride --------------------------------------------------------------------------------
fn mc_ride(limit, record): i64 {
    mc_sin_init();
    mc_tex_init();

    if (mc_fbinfo() != 1) {
        ps("mine-cart: no framebuffer -- this mode needs agnos"); nl();
        return 3;
    }
    if (mc_gpu_init() != 1) {
        # ⭐ NAME THE FAILURE. A bare code here read "-1" on the first real-kernel run and could not
        # be told apart from a dozen other things. The #86 slots come from the GPU CARVEOUT, so an
        # alloc failure is the ordinary answer on a box with no GPU (QEMU) — not a bug in the game.
        ps("mine-cart: GPU setup failed -- ");
        if (mc_gpu_err > 0 - 6) {
            ps("no carveout shm slot (#86). Expected where there is no GPU;");
            nl();
            ps("           on iron this means the carveout is absent or exhausted.");
        }
        if (mc_gpu_err < 0 - 5) { ps("texture upload refused (#72)"); }
        nl();
        return 4;
    }
    ps("mine-cart: "); pn(MC_W); ps("x"); pn(MC_H);
    ps(" perspective-correct textured triangles on the GPU, into a "); pn(mc_fbw);
    ps("x"); pn(mc_fbh); ps(" framebuffer"); nl();

    cart_reset(CFG_SEED_DEFAULT, 0);
    # ⭐ --record: every word handed to cart_tick goes into the log, so this ride can be replayed on a
    # host, byte for byte. Refused memory is reported and the ride goes on unrecorded.
    if (record != 0) {
        if (rp_begin(CFG_SEED_DEFAULT, 0) != 1) {
            ps("mine-cart: cannot allocate the input log -- not recording"); nl();
        }
    }
    # ⚠ Sound is OPTIONAL. A refused device must not stop the ride — aud_tick() is a no-op when the
    # device never opened, and a game that will not start because the DAC is busy is worse than a
    # silent one.
    if (aud_init() != 1) { ps("mine-cart: no sound device -- riding silent"); nl(); }

    var drawn = 0;
    var presented = 0;
    var rc = 95;
    var f = 0;
    while (1 == 1) {
        if (limit > 0) { if (f >= limit) { f = limit; break; } }

        # ---- ⭐ THE SIM STEP, AND THE ONE-WORD BOUNDARY IT SEES ---------------------------------
        # in_poll() drains the keyboard; in_word() collapses it to a bitfield; cart_tick() is a pure
        # function of that word and the world. Nothing below reads a clock, so the simulation is
        # identical whether the renderer keeps up or not — which is the property the replay test will
        # depend on, and the reason rendering is allowed to drop frames and the sim never is.
        in_poll();
        var word = in_word();
        in_flush_edges();
        if ((word & IN_QUIT) != 0) { break; }

        if (cart_tick(word) == 0) {
            # ⭐ DEATH RESTARTS AT THE CHAPTER GATE WITH THE SAME SEED — the player is meant to learn
            # this specific stretch of mine, so they get the SAME track back, not a new sample.
            ps("mine-cart: "); ps(mc_death_name()); ps(" at "); pn(trk_depth_m());
            ps(" m -- restarting the chapter"); nl();
            cart_reset(cart_seed, cart_chapter);
        }
        # ⚠ AFTER the tick and any restart — exactly where rp_run folds the state in on replay
        rp_note(word);

        # ⭐ AUDIO IS HANDED THE SIM'S STATE, IT NEVER READS IT. One call in, one pump out — so the
        # mixer can fall behind, run at a different rate, or fail to open entirely, and the
        # simulation is bit-identical either way.
        var aud_braking = 0;
        if ((word & IN_BRAKE) != 0) { aud_braking = 1; }
        aud_set_state(cart_speed_frac(), aud_braking, cart_slip);
        aud_tick();

        mc_build(cart_cam_x());
        if (mc_gpu_frame() != 1) {
            ps("mine-cart: frame refused at "); pn(f); ps(" -- #92 returned "); pn(mc_gpu_err);
            nl();
            ps("           reason "); pn((0 - mc_gpu_err) & 0xFF);
            ps(" in record "); pn(((0 - mc_gpu_err) >>> 8) & 0xFF); nl();
            # ⭐ FALL THROUGH TO THE LOG. A refused frame is the ride you most want to replay: the
            # log reproduces this exact frame on a host, where --check can take it apart.
            rc = 5;
            break;
        }
        # ⛔ CHECK THE PRESENT. #84 returns 0 when the double-buffer is not armed, and an ignored 0
        # means 900 frames of "success" over a screen that never changed — the silent-nothing class
        # this whole cut keeps running into. Reported ONCE, not per frame.
        if (mc_gpu_present() != 1) {
            if (presented == 0) {
                ps("mine-cart: #84 present returned 0 -- the double buffer is NOT armed, so nothing");
                nl();
                ps("           reaches the panel. The draw may still be fine; the FLIP is not."); nl();
            }
            presented = 0 - 1;
        }
        if (presented >= 0) { presented = presented + 1; }
        drawn = drawn + 1;
        f = f + 1;
        mc_pace();
    }

    aud_close();
    mc_gpu_free();
    ps("mine-cart: "); pn(presented); ps(" frames PRESENTED, "); pn(drawn); ps(" drawn, ");
    pn(trk_depth_m());
    ps(" m of shaft, "); pn(cart_apex_hits); ps(" clean apexes, "); pn(cart_derails);
    ps(" derails, dropped ");
    pn(mc_drop_huge + mc_drop_coord + mc_drop_band + mc_drop_full);
    ps(" triangles, peak |D| "); pn(mc_peak_d); nl();

    if (rp_on == 1) {
        # the vertex list still holds the last frame built — the one the log's frame hash describes
        var len = rp_end();
        ps("mine-cart: input log "); pn(rp_ticks); ps(" ticks, state hash "); pn(rp_hash);
        ps(", frame hash "); pn(rp_frame_hash()); nl();
        if (file_write_all(record, rp_buf, len) == len) {
            ps("           written to "); ps(record); ps(" -- replay it anywhere with --replay"); nl();
        } else {
            ps("           could NOT be written to "); ps(record);
            ps(" -- the two hashes above are the ride's fingerprint"); nl();
        }
    }
    if (rc != 95) { return rc; }
    if (drawn == 0) { return 6; }
    return 95;
}

# ---- ⭐⭐ --replay: A RECORDED RIDE, REPRODUCED --------------------------------------------------
# Needs no GPU and no keyboard: the words are the whole input. 95 = both recorded hashes reproduced,
# 90 = the ride diverged (a determinism bug, or a build that simulates differently from the one that
# recorded it), 2 = the file is not a readable log.
fn mc_replay(path): i64 {
    fx_sin_init();
    mc_tex_init();
    var lenb[8];
    var buf = file_read_whole(path, &lenb);
    var len = load64(&lenb);
    if (buf == 0) { ps("mine-cart: cannot read "); ps(path); nl(); return 2; }
    var r = rp_run(buf, len);
    # ⭐ A LOG FROM ANOTHER SIMULATION IS NAMED, NOT REPLAYED INTO A FALSE "DIVERGED" (see RP_SIM_REV)
    if (r < 0) {
        if (rp_err == 5) {
            ps("mine-cart: "); ps(path); ps(" was recorded by simulation revision "); pn(rp_get16(buf + 6));
            ps(", and this build is revision "); pn(RP_SIM_REV); nl();
            ps("           -- replay it with the build that recorded it (0.2.2 is revision 0)"); nl();
            return 2;
        }
        ps("mine-cart: "); ps(path); ps(" is not a DEEPVEIN input log (reason "); pn(rp_err); ps(")"); nl();
        return 2;
    }
    ps("  replayed "); pn(rp_get32(buf + 16)); ps(" ticks from seed "); pn(rp_get32(buf + 8));
    ps(", chapter "); pn(rp_get32(buf + 12)); ps(": "); pn(trk_depth_m()); ps(" m, ");
    pn(cart_kmh()); ps(" km/h, score "); pn(cart_score); nl();
    ps("  state hash "); pn(rp_hash); ps(" (recorded "); pn(rp_want_state); ps(")"); nl();
    ps("  frame hash "); pn(rp_got_frame); ps(" (recorded "); pn(rp_want_frame); ps(")"); nl();
    if (r == 1) {
        ps("mine-cart: PASS -- the ride reproduced exactly, to the last tick and the last byte."); nl();
        return 95;
    }
    ps("mine-cart: FAIL -- the replay DIVERGED from the recorded ride."); nl();
    return 90;
}

# ---- ⭐⭐ --verify: THE ON-IRON BYTE COMPARE, and the thing that was missing ------------------
# Renders ONE frame twice — once through #92 op 0x0F on the GPU, once through refcore on the CPU —
# and compares every pixel. This is what gputri does for the kernel's own rungs, and what mine-cart
# shipped without: its first iron frame drew the WALLS where the floor and ceiling belonged (a
# kernel prep-arena race between the frame's two op 0x0F records) and every host assertion passed,
# because every record was ABI-perfect. Only an image comparison can see a defect like that.
# ⭐ pilot 0 is frame N of the input-less ride — frame 120 is the one rung 19 closed on. pilot 1 is
# frame N of the autopilot's ride (mc_cart_to_pilot), which is how a fork's chamber, nose and clipped
# face-on geometry get onto the GPU at all: the input-less ride never reaches one.
fn mc_verify(frame, pilot): i64 {
    mc_sin_init();
    mc_tex_init();

    if (mc_fbinfo() != 1) { ps("mine-cart: no framebuffer -- needs agnos"); nl(); return 3; }
    if (mc_gpu_init() != 1) { ps("mine-cart: GPU setup failed"); nl(); return 4; }

    mc_cart_to_pilot(frame, pilot);
    mc_build(cart_cam_x());
    ps("mine-cart: VERIFY frame "); pn(frame);
    if (pilot == 0) { ps(" of the hands-off ride"); }
    if (pilot == 1) { ps(" of the autopilot's ride"); }
    if (mc_fork_on == 1) { ps(" (a fork's chamber is in view)"); }
    ps(" -- GPU vs CPU reference, "); pn(mc_n_a);
    ps(" triangles in ONE op 0x0F record at ("); pn(MC_DX); ps(","); pn(MC_DY); ps(")"); nl();

    if (mc_fb_ok() == 0) { ps("mine-cart: cannot allocate the readback buffer"); nl(); return 7; }
    if (rr_fb_ok() == 0) { ps("mine-cart: cannot allocate the reference buffer"); nl(); return 7; }

    # ⛔ POISON FIRST. A #86 slot is a fixed window per index and hands back the previous run's
    # pixels, so an untouched buffer can read as a pass.
    var i = 0;
    while (i < MC_W * MC_H) { store32(mc_fb + i * 4, 0xA5A5A5A5); i = i + 1; }

    if (mc_gpu_frame() != 1) {
        ps("mine-cart: frame refused -- #92 returned "); pn(mc_gpu_err);
        ps(", reason "); pn((0 - mc_gpu_err) & 0xFF);
        ps(" in record "); pn(((0 - mc_gpu_err) >>> 8) & 0xFF); nl();
        mc_gpu_free();
        return 5;
    }
    if (mc_gpu_readback() != 1) {
        ps("mine-cart: readback failed ("); pn(mc_gpu_err); ps(")"); nl();
        mc_gpu_free();
        return 6;
    }
    mc_gpu_free();

    var untouched = 0;
    i = 0;
    while (i < MC_W * MC_H) {
        if ((load32(mc_fb + i * 4) & 0xFFFFFFFF) == 0xA5A5A5A5) { untouched = untouched + 1; }
        i = i + 1;
    }
    if (untouched == MC_W * MC_H) {
        ps("mine-cart: the GPU wrote NOTHING"); nl();
        return 88;
    }

    # the reference, same frame, same record order, same textures
    # ⛔ rr_record, not rr_list: it fills the rect with bg first, exactly as the op does. A
    # reference that writes only covered pixels is MORE FORGIVING THAN THE HARDWARE and would
    # report a huge diff against a correct GPU.
    rr_record(&mc_vtx_a, mc_n_a, &mc_tex_a);
    var pxa = rr_drawn;

    var diff = 0;
    var first = 0 - 1;
    i = 0;
    while (i < MC_W * MC_H) {
        if ((load32(mc_fb + i * 4) & 0xFFFFFFFF) != (load32(rr_fb + i * 4) & 0xFFFFFFFF)) {
            if (first < 0) { first = i; }
            diff = diff + 1;
        }
        i = i + 1;
    }

    ps("  reference drew "); pn(pxa); ps(" px from "); pn(mc_n_a); ps(" triangles"); nl();
    ps("  GPU buffer untouched at "); pn(untouched); ps(" of "); pn(MC_W * MC_H); ps(" px"); nl();
    ps("  DIFFER: "); pn(diff); ps(" of "); pn(MC_W * MC_H); ps(" px");
    if (first >= 0) {
        ps("  first at ("); pn(first % MC_W); ps(","); pn(first / MC_W); ps(")");
    }
    nl();
    if (diff == 0) {
        ps("mine-cart: PASS -- byte-identical to the CPU reference at every pixel."); nl();
        return 95;
    }
    ps("mine-cart: FAIL -- the GPU drew a different picture than op 0x0F specifies."); nl();
    return 86;
}

# 1 if two NUL-terminated strings are equal
fn mc_streq(a, b): i64 {
    if (mc_slen(a) != mc_slen(b)) { return 0; }
    var i = 0;
    while (i < mc_slen(a)) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# parse the flags, name the mode, and run it
fn main(): i64 {
    # ⚠ argc()/argv() read ZERO until this runs — it is not implicit. It has an agnos path as well
    # as a Linux one (lib/args_agnos.cyr), so the same call serves both targets.
    args_init();

    var check  = 0;
    var verify = 0;
    var sim    = 0;
    var wav    = 0;
    var record = 0;                 # a path, when --record was given
    var replay = 0;                 # likewise --replay
    var pilot  = 1;
    # ⚠ --verify has its own defaults (frame 120, hands off — the frame rung 19 closed on), so it needs
    #   to know whether --pilot and --frames were said or merely defaulted
    var pilot_said  = 0;
    var frames_said = 0;
    # ⚠ 900 = 15 s. The DEFAULT RIDE IS BOUNDED on purpose: the iron burn runs `run /bin/mine-cart`
    # with no arguments and needs it to come back. Pass --frames 0 to ride until ESC.
    var frames = 900;
    var i = 1;
    while (i < argc()) {
        var a = argv(i);
        var known = 0;
        if (mc_streq(a, "--check") == 1)  { check = 1; known = 1; }
        if (mc_streq(a, "--trace") == 1)  { mc_trace = 1; known = 1; }
        if (mc_streq(a, "--verify") == 1) { verify = 1; known = 1; }
        if (mc_streq(a, "--sim") == 1)    { sim = 1; known = 1; }
        if (mc_streq(a, "--wav") == 1)    { wav = 1; known = 1; }
        if (mc_streq(a, "--frames") == 1) {
            known = 1;
            frames_said = 1;
            i = i + 1;
            frames = 0 - 1;
            if (i < argc()) { frames = mc_atoi(argv(i)); }
            if (frames < 0) { ps("mine-cart: --frames needs a whole number (0 = unbounded)"); nl(); return 2; }
        }
        if (mc_streq(a, "--record") == 1) {
            known = 1;
            i = i + 1;
            if (i >= argc()) { ps("mine-cart: --record needs a file path"); nl(); return 2; }
            record = argv(i);
        }
        if (mc_streq(a, "--replay") == 1) {
            known = 1;
            i = i + 1;
            if (i >= argc()) { ps("mine-cart: --replay needs a file path"); nl(); return 2; }
            replay = argv(i);
        }
        if (mc_streq(a, "--pilot") == 1) {
            known = 1;
            pilot_said = 1;
            i = i + 1;
            pilot = 0 - 1;
            if (i < argc()) { pilot = mc_atoi(argv(i)); }
            if (pilot < 0) { ps("mine-cart: --pilot needs 0 or 1"); nl(); return 2; }
            if (pilot > 1) { ps("mine-cart: --pilot needs 0 or 1"); nl(); return 2; }
        }
        if (mc_streq(a, "--help") == 1) {
            ps("DEEPVEIN / mine-cart"); nl();
            ps("  (no flag)    ride. Needs agnos + a GPU. Bounded to 900 frames (15 s) unless --frames"); nl();
            ps("  --check      host gate: re-validate every emitted record, needs no GPU (exit 95 = pass)"); nl();
            ps("  --verify     GPU vs CPU reference, byte-compared. Needs agnos + a GPU. Frame 120 of the"); nl();
            ps("               hands-off ride, or with --pilot 1 --frames N frame N of the autopilot's"); nl();
            ps("               (715 is inside the first fork, where shot and film show it)"); nl();
            ps("  --sim        run the simulation headless and print telemetry (tuning)"); nl();
            ps("  --wav        render 20 s of the mix to /tmp/deepvein.wav and LISTEN to it"); nl();
            ps("  --pilot N    0 = hands off the controls, 1 = crude autopilot (--sim, --wav)"); nl();
            ps("  --frames N   bound the ride, or the --sim run (0 = ride until ESC)"); nl();
            ps("  --record F   write every input word of the ride (or --sim run) to F, to replay"); nl();
            ps("  --replay F   re-run a recorded ride headless; exit 95 if it reproduces exactly"); nl();
            ps("  --trace      report every dropped triangle, for diagnosis"); nl();
            nl();
            ps("  Controls: A/D or arrows lean, W or UP jumps, S or DOWN ducks, SHIFT brakes, ESC quits."); nl();
            ps("            At a fork, double-tap A (the wet shaft, x2) or D (the service spur) to throw"); nl();
            ps("            the switch; the cart takes the spur if you never do."); nl();
            return 0;
        }
        # ⛔ AN UNKNOWN FLAG IS AN ERROR, NOT A RIDE. `--chek` used to be silently ignored, which turned
        # a gate run into a ride — on a burn log, indistinguishable from the gate having been skipped.
        if (known == 0) {
            ps("mine-cart: unknown argument '"); ps(a); ps("' -- try --help"); nl();
            return 2;
        }
        i = i + 1;
    }
    # ⭐ SAY WHICH MODE, AND HOW MANY ARGS WERE SEEN. args_init() reads /proc/self/cmdline on Linux
    # and takes a different path on agnos, and if it ever returns nothing then argc() is 0 and every
    # flag silently vanishes — `--check` would quietly become a ride, which on a burn log is
    # indistinguishable from the gate having been skipped. One line removes that ambiguity.
    ps("mine-cart: argc "); pn(argc()); ps(" -- mode ");
    if (check == 1) { ps("CHECK (host gate, no GPU needed)"); nl(); return mc_check(); }
    if (verify == 1) {
        ps("VERIFY (GPU vs CPU reference)"); nl();
        var vpilot = 0;
        if (pilot_said == 1) { vpilot = pilot; }
        var vframe = 120;
        if (frames_said == 1) { vframe = frames; }
        return mc_verify(vframe, vpilot);
    }
    if (sim == 1) { ps("SIM (headless, no GPU -- tuning telemetry)"); nl(); return mc_sim(frames, pilot, record); }
    if (replay != 0) { ps("REPLAY (headless, no GPU)"); nl(); return mc_replay(replay); }
    if (wav == 1) {
        ps("WAV (render the mix to /tmp/deepvein.wav so a person can hear it)"); nl();
        fx_sin_init();
        wav_write("/tmp/deepvein.wav", 20, pilot);
        return 0;
    }
    ps("RIDE ("); pn(frames); ps(" frames");
    if (record != 0) { ps(", recording to "); ps(record); }
    ps(")"); nl();
    return mc_ride(frames, record);
}

# the process entry: run main() and hand its code to the kernel as the exit status
fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
