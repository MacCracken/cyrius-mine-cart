# fx.cyr — Q16.16 fixed point, a 256-entry Q1.15 sine table, and xorshift32.
#
# ⭐ WHAT THIS FILE IS FOR. Every number in DEEPVEIN's simulation passes through here. There is no
# FPU on the target and no libm to call, so "the maths" is not a detail underneath the game — it IS
# the game's substrate, and a rounding rule that differs by one ulp between two call sites is a
# desync that only shows up ten thousand frames later. This file exists so there is exactly ONE
# definition of each operation and exactly one place to be wrong.
#
# ⛔⛔ THE TRAP THAT DOMINATES THIS ENTIRE FILE, AND WHICH COST NOTHING ONLY BECAUSE IT WAS MEASURED
# BEFORE A LINE WAS WRITTEN:
#
#     IN CYRIUS, `>>` IS THE **LOGICAL** SHIFT AND `>>>` IS THE **ARITHMETIC** SHIFT.
#
# That is INVERTED from C, Java, JavaScript, Rust and every other language anyone reaching for this
# file has in their fingers. Verified two ways — by objdump (`>>` emits `shr`, `>>>` emits `sar`)
# and at runtime:
#
#     (0 - 16) >>  2  =  4611686018427387900      <- (2^64-16)/4, the unsigned answer
#     (0 - 16) >>> 2  =  -4                       <- the one you meant
#
# The consequence for fx_mul, measured on -2.5 * 3.0 (expected -491520):
#
#     (a * b) >>> 16  =  -491520                  <- correct
#     (a * b) >>  16  =  281474976219136          <- garbage
#
# ⚠ AND THIS IS WHY IT IS DANGEROUS RATHER THAN MERELY SURPRISING: for NON-NEGATIVE values the two
# shifts are IDENTICAL. A `>>` typo in this file compiles, passes every straight-line test, ships,
# and produces a correct-looking game right up until the track first curves LEFT or the cart leans
# to a negative offset. It is invisible in exactly the states you test first.
# ⇒ Every right shift of a possibly-signed quantity in this codebase is `>>>`. `>>` appears ONLY on
#   values that have been explicitly masked non-negative, and each such site says so.

# ---- the format ------------------------------------------------------------------------------
# Q16.16 signed: 16 integer bits, 16 fraction bits, carried in an i64 register. The VALUE range that
# survives fx_mul is what matters, not the register width — see the fx_mul note.
var FX_SHIFT = 16;
var FX_ONE   = 65536;         # 1.0
var FX_HALF  = 32768;         # 0.5

# The largest magnitude fx_div may be handed. `(a << 16)` overflows i64 above 2^47, silently, and
# turns a positive input into a large negative output with no trap (measured: fx_div(1<<47, ONE)
# returned -140737488355328). Clamping is the only defence the language offers.
var FX_DIV_MAX = 140737488355327;    # 2^47 - 1

# ---- multiply --------------------------------------------------------------------------------
# ⭐ THE i64 INTERMEDIATE IS THE WHOLE POINT. a and b are each Q16.16, so the product is Q32.32 and
# needs 64 bits BEFORE the shift brings it back to Q16.16. Doing this in 32 bits — which is what a
# naive port does — discards the high half and is the classic fixed-point bug. Cyrius has no 32-bit
# arithmetic type, so we get the wide intermediate for free; the discipline that remains is to shift
# AFTER multiplying, never before.
#
# ⚠ SAFE INPUT RANGE: |a| * |b| must stay under 2^63. With both operands Q16.16 that is
# |a_real| * |b_real| < 2^31 — e.g. two values under 46340.0 each. Speeds, leans, curvatures and
# screen offsets are all far inside that. Overflow WRAPS SILENTLY (measured: (1<<40)*(1<<40) == 0),
# so there is no runtime signal; it is bounded by design, not by check.
fn fx_mul(a, b): i64 { return (a * b) >>> 16; }

# ---- divide ----------------------------------------------------------------------------------
# ⛔ DIVIDE BY ZERO IS FATAL AND SILENT: SIGFPE, exit 136, no diagnostic printed. In a 60 Hz sim loop
# that is the process vanishing mid-frame with nothing on stdout to say why. Every denominator is
# guarded here rather than at each of the dozens of call sites.
# ⚠ Returns a saturated value on divide-by-zero rather than 0, because 0 is a plausible-looking
# answer that propagates quietly, while a saturated one shows up immediately as a pinned control.
fn fx_div(a, b): i64 {
    if (a > FX_DIV_MAX) { a = FX_DIV_MAX; }
    if (a < 0 - FX_DIV_MAX) { a = 0 - FX_DIV_MAX; }
    if (b == 0) {
        if (a >= 0) { return 2147483647; }
        return 0 - 2147483647;
    }
    return (a << 16) / b;
}

# ---- lerp ------------------------------------------------------------------------------------
# t is Q16.16 in [0, FX_ONE]. Written as a + (b-a)*t rather than a*(1-t) + b*t because the latter
# needs two multiplies and, more importantly, does not return EXACTLY b at t == FX_ONE — an endpoint
# that misses by one ulp makes a "finished" animation never quite finish.
fn fx_lerp(a, b, t): i64 { return a + (((b - a) * t) >>> 16); }

# clamp helper — used everywhere lean, speed and curvature are bounded
fn fx_clamp(v, lo, hi): i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

# absolute value
fn fx_abs(v): i64 { if (v < 0) { return 0 - v; } return v; }

# ---- the sine table --------------------------------------------------------------------------
# 256 entries, Q1.15 (32767 = 1.0), spanning ONE FULL TURN. Angles are u16 "brads" with
# 65536 = a full turn, so the table index is angle >>> 8 and there is no range reduction, no
# quadrant mirroring and no branch — the u16 wrap IS the modulo.
#
# ⭐ COSINE IS THE SAME TABLE AT +64. A quarter turn is 65536/4 = 16384 brads = 64 table entries, and
# 64 divides 256 exactly, so cos(x) == sin(x + 16384) is EXACT at every entry — verified to zero
# error across all 256 indices, not approximately.
#
# ⚠ 32767 rather than 32768 as the scale: 32768 does not fit in the signed 16-bit range these values
# are conceptually in, and a table that peaks one above its own format is the sort of thing that
# survives host testing and overflows on a narrower target.
var fx_sintab[256];
var fx_sintab_guard = 0;      # ⛔ overrun sentinel — see fx_ok()

# ⛔ MEASURE THE POOL, DO NOT TRUST THE DECLARATION. A global `var X[N]` is N*8 BYTES here, but a
# LOCAL `var X[N]` is N bytes — an 8x asymmetry with no diagnostic either way. This repo's history
# includes an under-sized buffer whose overflow landed on a triangle COUNT and read as "the GPU did
# nothing". The span is asserted, never assumed.
# ⚠ Asserted as a >= BYTE comparison and never divided to derive a capacity: a global with N >= 2
# gets up to 8 bytes of alignment padding inserted BEFORE it, so the span to the next symbol
# OVERSTATES by up to 8 and never understates.
fn fx_ok(): i64 {
    if ((&fx_sintab_guard - &fx_sintab) < 256 * 8) { return 0; }
    return 1;
}

# one sine-table entry, Q1.15
fn fx_st(i, v): i64 { store64(&fx_sintab + i * 8, v); return 0; }

