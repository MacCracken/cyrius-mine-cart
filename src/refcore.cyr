# refcore.cyr — a CPU rasteriser that reproduces exactly what #92 op 0x0F should have drawn.
#
# ⛔⛔ THE INSTRUMENT THAT WAS MISSING FOR THE FIRST BURN, AND WHAT IT COST. mine-cart shipped with a
# gate proving every record was ABI-LEGAL and that the frame was not EMPTY — and drew the wrong
# picture anyway, because the defect was a KERNEL ARENA RACE between two op 0x0F records sharing one
# fixed prep slot. Every record was perfect. Every host assertion passed. No record-level check could
# ever have seen it. The only thing that can is a reference IMAGE.
#
# Every rung of the kernel's own ladder shipped with one of these (perspcore, depthcore, texcore) and
# byte-compared against it. The consumer shipped without one and paid a burn for the omission.
#
# ⭐ The arithmetic is the KERNEL'S, deliberately: doubled-integer pixel centres 2*p+1, edge functions
# in that domain, W = 2^16/w, D = sum(e_i*W_i), N = sum(e_i*W_i*attr_i), u = N/D. Same expressions
# gpo_validate_triperspec bounds and tri_persp.s evaluates. Disagreement IS the evidence.
# ⭐ HEAP, NOT A 1 MB STATIC ARRAY — a megabyte of zeros in every binary that includes the reference,
# which is the game itself (for --verify). Allocated on first use by rr_fb_ok().
var rr_fb = 0;              # 640*400*4 = 1,024,000 B
var rr_drawn = 0;           # pixels written this frame
var rr_tris  = 0;           # triangles that covered at least one pixel

# load a 32-bit field sign-extended, exactly as the shader reads a coordinate
fn rr_i32(p): i64 {
    var v = load32(p) & 0xFFFFFFFF;
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}

# ⛔⛔ THE REFERENCE MUST MODEL THE BACKGROUND WRITE, AND THE FIRST VERSION DID NOT. op 0x0F
# REPLACES ITS ENTIRE RECT: tri_persp.s:348-360 selects bg where no triangle covered the lane
# (`v_cndmask_b32 v21, v20, v21, s[28:29]`) and then stores UNCONDITIONALLY. A reference that writes
# only covered pixels is MORE FORGIVING THAN THE HARDWARE — it would have reported a huge diff
# against a correct GPU and sent the next burn hunting the shader. That is the shared-premise trap
# inverted, and it is exactly as dangerous.
# ⇒ rr_rect_bg fills the draw rect with GPU_TRID_BG before a record's triangles, once per RECORD,
# which is what makes layering two records over one rect visibly destructive here too.
var MC_BG = 0xFF000000;

# the reference frame buffer, allocated on first use: 1 if it exists
fn rr_fb_ok(): i64 {
    if (rr_fb == 0) { rr_fb = alloc(MC_W * MC_H * 4); }
    if (rr_fb == 0) { return 0; }
    return 1;
}

# fill the whole rect with op 0x0F's background, as the op does before any triangle
fn rr_clear(): i64 {
    if (rr_fb_ok() == 0) { return 0; }
    var i = 0;
    while (i < MC_W * MC_H) { store32(rr_fb + i * 4, MC_BG); i = i + 1; }
    return 0;
}

# rasterise ONE triangle, perspective-correct, nearest-neighbour, REPLACE (op 0x0F's semantics)
fn rr_tri(b, tex): i64 {
    var x0 = rr_i32(b +  0) >>> 16;  var y0 = rr_i32(b +  4) >>> 16;
    var x1 = rr_i32(b + 20) >>> 16;  var y1 = rr_i32(b + 24) >>> 16;
    var x2 = rr_i32(b + 40) >>> 16;  var y2 = rr_i32(b + 44) >>> 16;
    var w0 = load32(b +  8) & 0xFFFFFFFF;
    var w1 = load32(b + 28) & 0xFFFFFFFF;
    var w2 = load32(b + 48) & 0xFFFFFFFF;
    var u0 = load32(b + 12) & 0xFFFFFFFF;  var v0 = load32(b + 16) & 0xFFFFFFFF;
    var u1 = load32(b + 32) & 0xFFFFFFFF;  var v1 = load32(b + 36) & 0xFFFFFFFF;
    var u2 = load32(b + 52) & 0xFFFFFFFF;  var v2 = load32(b + 56) & 0xFFFFFFFF;

    var W0 = 65536 / w0;
    var W1 = 65536 / w1;
    var W2 = 65536 / w2;

    var ax = 2 * x0; var ay = 2 * y0;
    var bx = 2 * x1; var by = 2 * y1;
    var cx = 2 * x2; var cy = 2 * y2;

    # winding: flip so the inside test is uniformly "all >= 0"
    var area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
    if (area == 0) { return 0; }
    var flip = 0;
    if (area < 0) { flip = 1; }

    # screen-space bounding box, clamped to the draw rect
    var lox = x0; if (x1 < lox) { lox = x1; }  if (x2 < lox) { lox = x2; }
    var hix = x0; if (x1 > hix) { hix = x1; }  if (x2 > hix) { hix = x2; }
    var loy = y0; if (y1 < loy) { loy = y1; }  if (y2 < loy) { loy = y2; }
    var hiy = y0; if (y1 > hiy) { hiy = y1; }  if (y2 > hiy) { hiy = y2; }
    # ⚠ ABSOLUTE COORDS: the visible rect is [MC_DX, MC_DX+MC_W) x [MC_DY, MC_DY+MC_H), and the
    # store index rebases back to rect-local. Clamping to [0,MC_W) here would silently crop the
    # frame whenever the game draws at an offset.
    if (lox < MC_DX) { lox = MC_DX; }
    if (loy < MC_DY) { loy = MC_DY; }
    if (hix > MC_DX + MC_W - 1) { hix = MC_DX + MC_W - 1; }
    if (hiy > MC_DY + MC_H - 1) { hiy = MC_DY + MC_H - 1; }

    var hit = 0;
    var py = loy;
    while (py <= hiy) {
        var px = lox;
        while (px <= hix) {
            var qx = 2 * px + 1;
            var qy = 2 * py + 1;
            var e0 = (cx - bx) * (qy - by) - (cy - by) * (qx - bx);
            var e1 = (ax - cx) * (qy - cy) - (ay - cy) * (qx - cx);
            var e2 = (bx - ax) * (qy - ay) - (by - ay) * (qx - ax);
            if (flip == 1) { e0 = 0 - e0; e1 = 0 - e1; e2 = 0 - e2; }
            var out = 0;
            if (e0 < 0) { out = 1; }
            if (e1 < 0) { out = 1; }
            if (e2 < 0) { out = 1; }
            if (out == 0) {
                # ⭐ negating all three e's negates D and N together, so u = N/D is unchanged —
                # which is why the winding flip above is safe to apply before this.
                var D = e0 * W0 + e1 * W1 + e2 * W2;
                if (D != 0) {
                    var Nu = e0 * (W0 * u0) + e1 * (W1 * u1) + e2 * (W2 * u2);
                    var Nv = e0 * (W0 * v0) + e1 * (W1 * v1) + e2 * (W2 * v2);
                    var uu = Nu / D;
                    var vv = Nv / D;
                    var tx = (uu >>> 16) & (MC_TEX - 1);
                    var ty = (vv >>> 16) & (MC_TEX - 1);
                    var c = load32(tex + (ty * MC_TEX + tx) * 4) & 0xFFFFFFFF;
                    store32(rr_fb + ((py - MC_DY) * MC_W + (px - MC_DX)) * 4, c);
                    rr_drawn = rr_drawn + 1;
                    hit = 1;
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
    if (hit == 1) { rr_tris = rr_tris + 1; }
    return 0;
}

# rasterise a list of packed triangles in order, into rr_fb
fn rr_list(list, n, tex): i64 {
    if (rr_fb_ok() == 0) { return 0; }
    var i = 0;
    while (i < n) { rr_tri(list + i * 64, tex); i = i + 1; }
    return 0;
}

# one op 0x0F record: bg over the WHOLE rect, then its triangles. Defined after rr_list because
# Cyrius is single-pass.
fn rr_record(list, n, tex): i64 {
    rr_clear();
    return rr_list(list, n, tex);
}
